// The exact weights of the rules of Newton and Cotes of the orders
// fifteen to twenty.
//
// The weights of a rule come from the exact fractions of the rule. The
// system of the samples loses the digits of those fractions, because
// the matrix of the samples stands ill when the order grows. SciPy 1.18
// keeps the exact fractions up to the order fourteen and solves the
// system above that order. This file keeps the exact fractions up to
// the order twenty. The factor of the error of a rule of an order above
// twenty still comes from the system.
namespace scientific;

// The weights of the rules of the orders fifteen to twenty. The weights
// of the rule of an order stand at the places of its row in NC_AT.
const NC_W: f64[111] = [
    0.2563094965743892, 1.9276106801610777, -1.6908435758925784, 7.605640623153353, -11.344396722662104, 17.870405242601986,
    -14.520078172443721, 7.395352428507597, 7.395352428507597, -14.520078172443721, 17.870405242601986, -11.344396722662104,
    7.605640623153353, -1.6908435758925784, 1.9276106801610777, 0.2563094965743892, 0.2463831538663921, 2.0902590630422426,
    -2.9436231463894083, 13.62990382247207, -31.601184574227144, 68.42023994752236, -111.47691389758305, 153.44273768862988,
    -167.61560411466667, 153.44273768862988, -111.47691389758305, 68.42023994752236, -31.601184574227144, 13.62990382247207,
    -2.9436231463894083, 2.0902590630422426, 0.2463831538663921, 0.24959765029771566, 2.0321152738643917, -2.4466671346505926,
    10.96274582219287, -21.526655871440735, 39.972915188944874, -49.226312182644875, 45.45375021118806, -16.971488957751706,
    -16.971488957751706, 45.45375021118806, -49.226312182644875, 39.972915188944874, -21.526655871440735, 10.96274582219287,
    -2.4466671346505926, 2.0321152738643917, 0.24959765029771566, 0.24111742198338404, 2.187973879953685, -3.8022858559211845,
    18.379568138426304, -50.143312513574756, 122.70604008892478, -235.10059536847496, 377.5791378014164, -496.0383070137175,
    545.9813268419676, -496.0383070137175, 377.5791378014164, -235.10059536847496, 122.70604008892478, -50.143312513574756,
    18.379568138426304, -3.8022858559211845, 2.187973879953685, 0.24111742198338404, 0.24387281228282073, 2.132652016548929,
    -3.274449559407935, 15.19712564862917, -36.54339436540533, 78.91269367749334, -124.82458903532563, 155.16837924505543,
    -131.03009159001138, 53.517801150140585, 53.517801150140585, -131.03009159001138, 155.16837924505543, -124.82458903532563,
    78.91269367749334, -36.54339436540533, 15.19712564862917, -3.274449559407935, 2.132652016548929, 0.24387281228282073,
    0.23650546498063207, 2.2827543528921397, -4.729567410228539, 24.123737869637512, -75.42063453430661, 206.73596439879603,
    -454.1763168795903, 836.561148443871, -1281.50558980308, 1655.945669449457, -1800.107342704858, 1655.945669449457,
    -1281.50558980308, 836.561148443871, -454.1763168795903, 206.73596439879603, -75.42063453430661, 24.123737869637512,
    -4.729567410228539, 2.2827543528921397, 0.23650546498063207
];

// The places of the weights of each order in the buffer. The rule of an
// order N holds N + 1 weights.
const NC_AT: i64[7] = [0, 16, 33, 51, 70, 90, 111];

// The factor of the error of the rules of the orders fifteen to twenty.
const NC_B: f64[6] = [
    -0.006428992862647135, -0.002541332883415222, -0.005510780598873432, -0.002233302212174202, -0.00480032475718144, -0.001985028856832021,
];

// nc_exact gives the weights of the rule of an order from fifteen to
// twenty and the factor of the error of the rule. The call gives false
// when the order stands outside that range.
fn nc_exact(n: i64) -> f64[>..], f64, bool {
    var w: f64[>..] = [];
    if n < 15 || n > 20 { return w, 0.0, false; }
    let row = n - 15;
    let first = NC_AT[row];
    let count = NC_AT[row + 1] - first;
    var i: i64 = 0;
    while i < count {
        w.push(NC_W[first + i]);
        i += 1;
    }
    return w, NC_B[row], true;
}
