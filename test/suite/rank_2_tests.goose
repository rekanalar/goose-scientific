// The tests of the group rank. Run them with SCIENTIFIC_SUITES=rank.
namespace rank_2_tests;

import scientific from "../..";
import os;
import common_3;

fn test_rank_pins11() {
    let r385, g385 = scientific::minimum_filter(common_3::ni_arr(2), [2, 3], "reflect", 0.7, [-1, -1]);
    assert(g385.kind == scientific::F_NONE && common_3::nd_same(r385, [-1.744, -1.744, -0.843, 0.089, 0.089, 0.089, -1.931, -1.931, -1.931, 0.314, 0.314, 0.314, -1.931, -1.931, -1.931, -0.781, -0.781, -0.781, -0.877, -0.041, -0.781, -1.532, -1.532, -1.532, -0.877, -0.041, -0.041, -1.532, -1.532, -1.532]));
