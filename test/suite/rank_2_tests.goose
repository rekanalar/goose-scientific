fn test_rank_pins12() {
    let r420, g420 = scientific::rank_filter(common_3::ni_arr(2), 3, [2, 3], "constant", 0.7, [0, 1]);
    assert(g420.kind == scientific::F_NONE && common_3::nd_same(r420, [0.7, 0.7, 0.7, 0.7, 0.7, 0.7, 0.7, 0.264, -0.29, 0.083, 0.314, 0.43, 0.7, 0.264, -0.047, 0.083, 0.43, 0.43, 0.7, 0.327, 0.27, 0.71, 0.802, 0.802, 0.7, 0.327, 0.27, 0.71, 0.71, 0.263]));
    let r421, g421 = scientific::rank_filter(common_3::ni_arr(2), 5, [2, 3], "constant", 0.7, [0, 1]);
    assert(g421.kind == scientific::F_NONE && common_3::nd_same(r421, [0.7, 0.7, 0.7, 0.722, 0.722, 0.722, 0.7, 0.7, 0.264, 0.722, 0.722, 0.722, 0.7, 0.7, 0.264, 0.802, 1.014, 1.014, 0.7, 0.7, 0.71, 1.732, 1.732, 1.732, 0.7, 0.7, 0.71, 1.765, 1.765, 1.765]));
    let r422, g422 = scientific::median_filter(common_3::ni_arr(2), [2, 3], "constant", 0.7, [0, 1]);
    assert(g422.kind == scientific::F_NONE && common_3::nd_same(r422, [0.7, 0.7, 0.7, 0.7, 0.7, 0.7, 0.7, 0.264, -0.29, 0.083, 0.314, 0.43, 0.7, 0.264, -0.047, 0.083, 0.43, 0.43, 0.7, 0.327, 0.27, 0.71, 0.802, 0.802, 0.7, 0.327, 0.27, 0.71, 0.71, 0.263]));
    let r423, g423 = scientific::minimum_filter(common_3::ni_arr(2), [2, 3], "constant", 0.7, [0, 1]);
