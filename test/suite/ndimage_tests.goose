// The tests of the group ndimage. Run them with SCIENTIFIC_SUITES=ndimage.
namespace ndimage_tests;

import scientific from "../..";
import os;
import common_3;

fn test_ndimage_pins0() {
    let r0, g0 = scientific::correlate1d(common_3::ni_arr(1), [-0.265], -1, "reflect", 1.5, 0);
    assert(g0.kind == scientific::F_NONE && common_3::nd_same(r0, [0.07526, 0.249365, 0.013515, 0.006625000000000001, 0.02014, 0.18868000000000001, 0.261025, 0.205905, -0.06254]));
    let r1, g1 = scientific::convolve1d(common_3::ni_arr(1), [-0.265], -1, "reflect", 1.5, 0);
    assert(g1.kind == scientific::F_NONE && common_3::nd_same(r1, [0.07526, 0.249365, 0.013515, 0.006625000000000001, 0.02014, 0.18868000000000001, 0.261025, 0.205905, -0.06254]));
