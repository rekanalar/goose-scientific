    assert(g281.kind == scientific::F_NONE && common_3::nd_same(r281, [-0.1807459999999999, -0.04312300000000002, -0.5320759999999999, 0.8089879999999998, -0.5329849999999999, -0.07171299999999992, 0.839744, -1.182564, 0.313766, 0.6200079999999999, -0.48026800000000014, -0.521629, -0.4026939999999999, 0.41206400000000004, -1.183306, 0.645889, 0.3283879999999999, -1.0155809999999998, 1.301506, 0.617385, -0.012323000000000028, 1.925182, -0.4550930000000001, 0.6544220000000001, -0.02938299999999993, 1.169611, -1.020678, 0.34933499999999984, 0.18113199999999996, -1.043371]));
    let r282, g282 = scientific::correlate1d(common_3::ni_arr(3), [0.457, 0.486, -0.214, 0.87], -1, "wrap", 1.5, 1);
