fn test_transform_pins20() {
    let r600, g600 = scientific::affine_transform(common_3::tr_arr(3), common_3::ni_nd([3, 3], [0.0, -0.77, -0.08, -0.48, -1.09, -0.44, 0.33, -0.4, -0.12]), [0.47, 1.37, 1.55], [2, 2, 5], 3, "wrap", 0.4);
    assert(g600.kind == scientific::F_NONE && r600.shape == [2, 2, 5] && common_3::tr_same(r600, [-0.8399844173918148, 0.060387838418639345, -0.5469884170747866, -1.2364202825117718, -0.2836343966632406, 1.1100533864605655, -1.2634673696625693, 0.27745511000021095, -0.4261162270981591, 0.03510105920193667, -0.22831638810870697, -0.47285226537630803, -0.7031685718859311, -0.32489912534823057, -0.8232000450016088, -1.210035765247873, 0.40381835426069884, -1.360761682309173, -0.15828661323827514, 0.3403773654145272]));
    let r601, g601 = scientific::affine_transform(common_3::tr_arr(3), common_3::ni_nd([4, 4], [0.0, -0.77, -0.08, 0.47, -0.48, -1.09, -0.44, 1.37, 0.33, -0.4, -0.12, 1.55, 0.0, 0.0, 0.0, 1.0]), [], [], 3, "wrap", 0.4);
