// The tests of the group transform. Run them with SCIENTIFIC_SUITES=transform.
namespace transform_2_tests;

import scientific from "../..";
import os;
import common_3;

fn test_transform_pins13() {
    let r390, g390 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([2, 2], [0.04, -0.92, 0.0, 1.0]), [], [], 1, "grid-wrap", 0.4);
    assert(g390.kind == scientific::F_NONE && r390.shape == [7] && common_3::tr_same(r390, [0.2387999999999999, 0.18119999999999983, 0.1235999999999998, 0.0659999999999997, 0.00839999999999963, -0.04920000000000041, -0.10680000000000045]));
    let r391, g391 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1], [0.59]), [-1.7], [], 3, "grid-wrap", 0.4);
    assert(g391.kind == scientific::F_NONE && r391.shape == [7] && common_3::tr_same(r391, [-0.19889619512195006, 0.3733648620000004, -0.30918903570731815, -1.116750559170732, -0.7083109627317075, -0.1616737804878049, -0.07666433560975613]));
    let r392, g392 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1, 1], [1.04]), [-1.7], [5], 3, "grid-wrap", 0.4);
    assert(g392.kind == scientific::F_NONE && r392.shape == [5] && common_3::tr_same(r392, [-0.1988961951219515, -0.053900447999999684, -1.0099501440000003, -0.1081765053658536, -0.0005111972682926465]));
    let r393, g393 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([2, 2], [1.04, -1.7, 0.0, 1.0]), [], [], 3, "grid-wrap", 0.4);
    assert(g393.kind == scientific::F_NONE && r393.shape == [7] && common_3::tr_same(r393, [-0.1988961951219515, -0.053900447999999684, -1.0099501440000003, -0.1081765053658536, -0.0005111972682926465, -0.15344817073170727, -0.6937741765853662]));
    let r394, g394 = scientific::shift(common_3::tr_arr(1), [-1.41], 0, "nearest", 0.4);
    assert(g394.kind == scientific::F_NONE && r394.shape == [7] && common_3::tr_same(r394, [-0.324, -0.07, 0.026, -0.449, -0.552, 0.354, 0.354]));
    let r395, g395 = scientific::shift(common_3::tr_arr(1), [-1.29], 1, "nearest", 0.4);
    assert(g395.kind == scientific::F_NONE && r395.shape == [7] && common_3::tr_same(r395, [-0.25034, -0.04216, -0.11175000000000002, -0.47887, -0.28925999999999996, 0.354, 0.354]));
    let r396, g396 = scientific::shift(common_3::tr_arr(1), [-1.74], 3, "nearest", 0.4);
    assert(g396.kind == scientific::F_NONE && r396.shape == [7] && common_3::tr_same(r396, [-0.10445750550796025, 0.044831590321732846, -0.3027887677789714, -0.645969087205848, 0.15075440460236617, 0.4041927087963909, 0.3405509042120708]));
    let r397, g397 = scientific::shift(common_3::tr_arr(1), [0.4], 4, "nearest", 0.4);
    assert(g397.kind == scientific::F_NONE && r397.shape == [7] && common_3::tr_same(r397, [-1.171004805958429, -0.6361811817785504, -0.11856437908685541, 0.027224262527122775, -0.20704294095633233, -0.6721452761773938, 0.01646023646383468]));
    let r398, g398 = scientific::zoom(common_3::tr_arr(1), [1.59], 1, "nearest", 0.4, true, false);
    assert(g398.kind == scientific::F_NONE && r398.shape == [11] && common_3::tr_same(r398, [-1.086, -0.6288, -0.27320000000000005, -0.12080000000000006, -0.03160000000000001, 0.026, -0.25899999999999984, -0.4696, -0.5314, -0.18960000000000052, 0.354]));
    let r399, g399 = scientific::zoom(common_3::tr_arr(1), [1.59], 1, "nearest", 0.4, true, true);
    assert(g399.kind == scientific::F_NONE && r399.shape == [11] && common_3::tr_same(r399, [-1.086, -0.7396363636363636, -0.3009090909090909, -0.13927272727272733, -0.03509090909090908, 0.026, -0.27627272727272745, -0.47709090909090907, -0.5426363636363637, -0.057818181818182296, 0.354]));
    let r400, g400 = scientific::zoom(common_3::tr_arr(1), [1.79], 3, "nearest", 0.4, true, false);
    assert(g400.kind == scientific::F_NONE && r400.shape == [13] && common_3::tr_same(r400, [-1.086, -0.7251791004216485, -0.32400000000000007, -0.14037409023817984, -0.07000000000000006, 0.02142546137436744, 0.025999999999999922, -0.1684527552592898, -0.449, -0.6414894403372084, -0.5520000000000002, -0.09596448339187749, 0.3540000000000001]));
    let r401, g401 = scientific::zoom(common_3::tr_arr(1), [1.79], 3, "nearest", 0.4, true, true);
    assert(g401.kind == scientific::F_NONE && r401.shape == [13] && common_3::tr_same(r401, [-1.1522354847324379, -0.8877656012056799, -0.4308018052056692, -0.16560206770675132, -0.08126018832347456, 0.015329314984536817, 0.025999999999999922, -0.18913322723639717, -0.48900202223308414, -0.6531070084892062, -0.44028944447900537, 0.10441241209894266, 0.43797925773984675]));
    let r402, g402 = scientific::zoom(common_3::tr_arr(1), [1.82], 5, "nearest", 0.4, true, false);
    assert(g402.kind == scientific::F_NONE && r402.shape == [13] && common_3::tr_same(r402, [-1.0859999999999999, -0.7254310166876442, -0.32400000000000023, -0.12987244875589393, -0.06999999999999995, 0.005178131783978783, 0.02600000000000048, -0.14063165971881558, -0.4490000000000004, -0.6721876107125005, -0.5519999999999999, -0.08587905766071427, 0.3539999999999997]));
    let r403, g403 = scientific::zoom(common_3::tr_arr(1), [1.82], 5, "nearest", 0.4, true, true);
    assert(g403.kind == scientific::F_NONE && r403.shape == [13] && common_3::tr_same(r403, [-1.1600061159051154, -0.8877789974197305, -0.43154529661448066, -0.15560437624309004, -0.07852806895162397, -0.0007715233570260752, 0.02600000000000048, -0.1613367444351055, -0.49613352056805776, -0.6814707322916885, -0.433564876921085, 0.11135043511832629, 0.4449795087750248]));
    let r404, g404 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1], [1.24]), [-0.88], [], 1, "nearest", 0.4);
    assert(g404.kind == scientific::F_NONE && r404.shape == [7] && common_3::tr_same(r404, [-1.086, -0.8116800000000002, -0.17160000000000003, 0.010639999999999985, -0.45724000000000004, -0.2620800000000006, 0.354]));
    let r405, g405 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1, 1], [-0.51]), [-0.88], [4], 1, "nearest", 0.4);
    assert(g405.kind == scientific::F_NONE && r405.shape == [4] && common_3::tr_same(r405, [-1.086, -1.086, -1.086, -1.086]));
    let r406, g406 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([2, 2], [-0.51, -0.88, 0.0, 1.0]), [], [], 1, "nearest", 0.4);
    assert(g406.kind == scientific::F_NONE && r406.shape == [7] && common_3::tr_same(r406, [-1.086, -1.086, -1.086, -1.086, -1.086, -1.086, -1.086]));
    let r407, g407 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1], [1.4]), [1.11], [], 3, "nearest", 0.4);
    assert(g407.kind == scientific::F_NONE && r407.shape == [7] && common_3::tr_same(r407, [-0.26396563770536, 0.022929378801668024, -0.3997235971435128, -0.2949276636999502, 0.41028862155632756, 0.35767899865991587, 0.35228504046848813]));
    let r408, g408 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1, 1], [0.43]), [1.11], [5], 3, "nearest", 0.4);
    assert(g408.kind == scientific::F_NONE && r408.shape == [5] && common_3::tr_same(r408, [-0.26396563770536, -0.1331579292953292, -0.07458211189263618, 0.004697925638717254, 0.04464760773886357]));
    let r409, g409 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([2, 2], [0.43, 1.11, 0.0, 1.0]), [], [], 3, "nearest", 0.4);
    assert(g409.kind == scientific::F_NONE && r409.shape == [7] && common_3::tr_same(r409, [-0.26396563770536, -0.1331579292953292, -0.07458211189263618, 0.004697925638717254, 0.04464760773886357, -0.05395291311612768, -0.2740879342059023]));
    let r410, g410 = scientific::shift(common_3::tr_arr(1), [1.7], 0, "constant", 0.4);
    assert(g410.kind == scientific::F_NONE && r410.shape == [7] && common_3::tr_same(r410, [0.4, 0.4, -1.086, -0.324, -0.07, 0.026, -0.449]));
    let r411, g411 = scientific::shift(common_3::tr_arr(1), [0.6], 1, "constant", 0.4);
    assert(g411.kind == scientific::F_NONE && r411.shape == [7] && common_3::tr_same(r411, [0.4, -0.7812000000000001, -0.22240000000000004, -0.03160000000000001, -0.16399999999999995, -0.4902000000000001, -0.1895999999999997]));
    let r412, g412 = scientific::shift(common_3::tr_arr(1), [0.94], 3, "constant", 0.4);
    assert(g412.kind == scientific::F_NONE && r412.shape == [7] && common_3::tr_same(r412, [0.4, -1.0805747717538463, -0.2830022675076923, -0.061946958215384665, 0.01399449236923073, -0.4832141232615388, -0.5030228073230766]));
    let r413, g413 = scientific::shift(common_3::tr_arr(1), [-1.0], 4, "constant", 0.4);
    assert(g413.kind == scientific::F_NONE && r413.shape == [7] && common_3::tr_same(r413, [-0.32399999999999995, -0.07000000000000003, 0.02599999999999996, -0.4489999999999999, -0.5520000000000002, 0.35400000000000026, 0.4]));
    let r414, g414 = scientific::zoom(common_3::tr_arr(1), [1.17], 1, "constant", 0.4, true, false);
    assert(g414.kind == scientific::F_NONE && r414.shape == [8] && common_3::tr_same(r414, [-1.086, -0.4328571428571429, -0.1425714285714286, -0.01514285714285717, -0.17757142857142846, -0.4784285714285714, -0.4225714285714291, 0.354]));
    let r415, g415 = scientific::zoom(common_3::tr_arr(1), [1.17], 1, "constant", 0.4, true, true);
    assert(g415.kind == scientific::F_NONE && r415.shape == [8] && common_3::tr_same(r415, [0.4, -0.466875, -0.149375, -0.016000000000000004, -0.18181250000000002, -0.4811875, -0.38212500000000005, 0.4]));
    let r416, g416 = scientific::zoom(common_3::tr_arr(1), [0.99], 3, "constant", 0.4, true, false);
    assert(g416.kind == scientific::F_NONE && r416.shape == [7] && common_3::tr_same(r416, [-1.0860000000000003, -0.3240000000000001, -0.07000000000000006, 0.02599999999999993, -0.44899999999999995, -0.5520000000000002, 0.3539999999999999]));
    let r417, g417 = scientific::zoom(common_3::tr_arr(1), [0.99], 3, "constant", 0.4, true, true);
    assert(g417.kind == scientific::F_NONE && r417.shape == [7] && common_3::tr_same(r417, [-1.0860000000000003, -0.3240000000000001, -0.07000000000000006, 0.02599999999999993, -0.44899999999999995, -0.5520000000000002, 0.3539999999999999]));
    let r418, g418 = scientific::zoom(common_3::tr_arr(1), [0.5], 5, "constant", 0.4, true, false);
    assert(g418.kind == scientific::F_NONE && r418.shape == [4] && common_3::tr_same(r418, [-1.0859999999999999, -0.07000000000000006, -0.4490000000000009, 0.3540000000000002]));
    let r419, g419 = scientific::zoom(common_3::tr_arr(1), [0.5], 5, "constant", 0.4, true, true);
    assert(g419.kind == scientific::F_NONE && r419.shape == [4] && common_3::tr_same(r419, [-0.9213221613534881, -0.0634759049727834, -0.3579864339883042, 0.15301669917650504]));
}

fn test_transform_pins14() {
    let r420, g420 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1], [1.6]), [-1.07], [], 1, "constant", 0.4);
    assert(g420.kind == scientific::F_NONE && r420.shape == [7] && common_3::tr_same(r420, [0.4, -0.68214, -0.057519999999999974, -0.32075, -0.25301999999999997, 0.4, 0.4]));
    let r421, g421 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1, 1], [0.33]), [-1.07], [2], 1, "constant", 0.4);
    assert(g421.kind == scientific::F_NONE && r421.shape == [2] && common_3::tr_same(r421, [0.4, 0.4]));
    let r422, g422 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([2, 2], [0.33, -1.07, 0.0, 1.0]), [], [], 1, "constant", 0.4);
    assert(g422.kind == scientific::F_NONE && r422.shape == [7] && common_3::tr_same(r422, [0.4, 0.4, 0.4, 0.4, -0.8955, -0.64404, -0.3925800000000001]));
    let r423, g423 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1], [1.7]), [1.7], [], 3, "constant", 0.4);
    assert(g423.kind == scientific::F_NONE && r423.shape == [7] && common_3::tr_same(r423, [-0.09675356153846157, -0.11029575384615381, -0.4661542846153849, 0.4, 0.4, 0.4, 0.4]));
    let r424, g424 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1, 1], [0.34]), [1.7], [4], 3, "constant", 0.4);
    assert(g424.kind == scientific::F_NONE && r424.shape == [4] && common_3::tr_same(r424, [-0.09675356153846157, -0.06478323593846151, -0.005833846584615397, 0.03927338535384622]));
    let r425, g425 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([2, 2], [0.34, 1.7, 0.0, 1.0]), [], [], 3, "constant", 0.4);
    assert(g425.kind == scientific::F_NONE && r425.shape == [7] && common_3::tr_same(r425, [-0.09675356153846157, -0.06478323593846151, -0.005833846584615397, 0.03927338535384622, 0.01399449236923073, -0.11029575384615402, -0.2956626376000002]));
    let r426, g426 = scientific::shift(common_3::tr_arr(1), [-1.84], 0, "grid-constant", 0.4);
    assert(g426.kind == scientific::F_NONE && r426.shape == [7] && common_3::tr_same(r426, [-0.07, 0.026, -0.449, -0.552, 0.354, 0.4, 0.4]));
    let r427, g427 = scientific::shift(common_3::tr_arr(1), [1.26], 1, "grid-constant", 0.4);
    assert(g427.kind == scientific::F_NONE && r427.shape == [7] && common_3::tr_same(r427, [0.4, -0.69964, -0.52212, -0.13604000000000002, 0.0010400000000000166, -0.3255000000000001, -0.5252200000000001]));
    let r428, g428 = scientific::shift(common_3::tr_arr(1), [-1.33], 3, "grid-constant", 0.4);
    assert(g428.kind == scientific::F_NONE && r428.shape == [7] && common_3::tr_same(r428, [-0.1380221154052845, -0.019635706685718478, -0.08139563885184177, -0.5976488469069142, -0.27780470452050166, 0.4633117119889133, 0.379328574564846]));
    let r429, g429 = scientific::shift(common_3::tr_arr(1), [-0.54], 4, "grid-constant", 0.4);
    assert(g429.kind == scientific::F_NONE && r429.shape == [7] && common_3::tr_same(r429, [-0.8497143139247875, -0.07079291241190876, -0.0010967727333811952, -0.16654895029674927, -0.6683768977795402, -0.05158596611363757, 0.4733050154569858]));
    let r430, g430 = scientific::zoom(common_3::tr_arr(1), [1.95], 1, "grid-constant", 0.4, true, false);
    assert(g430.kind == scientific::F_NONE && r430.shape == [14] && common_3::tr_same(r430, [-1.086, -0.7343076923076923, -0.38261538461538463, -0.22630769230769232, -0.10907692307692307, -0.040461538461538445, 0.003846153846153836, -0.08361538461538465, -0.30284615384615393, -0.46484615384615385, -0.5123846153846154, -0.4823076923076918, -0.06415384615384631, 0.354]));
    let r431, g431 = scientific::zoom(common_3::tr_arr(1), [1.95], 1, "grid-constant", 0.4, true, true);
    assert(g431.kind == scientific::F_NONE && r431.shape == [14] && common_3::tr_same(r431, [-0.7145, -0.8955, -0.5145, -0.2605, -0.1335, -0.046000000000000006, 0.0019999999999999983, -0.09275, -0.33025, -0.47475, -0.52625, -0.3255, 0.12749999999999995, 0.36549999999999994]));
    let r432, g432 = scientific::zoom(common_3::tr_arr(1), [0.89], 3, "grid-constant", 0.4, true, false);
    assert(g432.kind == scientific::F_NONE && r432.shape == [6] && common_3::tr_same(r432, [-1.086, -0.19002305218833698, -0.006706427923142167, -0.22100555503933933, -0.6336152343978435, 0.354]));
    let r433, g433 = scientific::zoom(common_3::tr_arr(1), [0.89], 3, "grid-constant", 0.4, true, true);
    assert(g433.kind == scientific::F_NONE && r433.shape == [6] && common_3::tr_same(r433, [-1.1110278155873035, -0.16719615769286117, -0.0036773927814875923, -0.2116312645688857, -0.6436346435726785, 0.2980321545499233]));
    let r434, g434 = scientific::zoom(common_3::tr_arr(1), [1.15], 5, "grid-constant", 0.4, true, false);
    assert(g434.kind == scientific::F_NONE && r434.shape == [8] && common_3::tr_same(r434, [-1.086, -0.47815205320229653, -0.053276911181807315, -0.012251999835704451, -0.09197768842645145, -0.6095670606904275, -0.44334030274123515, 0.35399999999999987]));
    let r435, g435 = scientific::zoom(common_3::tr_arr(1), [1.15], 5, "grid-constant", 0.4, true, true);
    assert(g435.kind == scientific::F_NONE && r435.shape == [8] && common_3::tr_same(r435, [-1.045902853995977, -0.5310591698922296, -0.05216019318603161, -0.013834204461195106, -0.09630966363066631, -0.6209618991692369, -0.4041167912629911, 0.38864520074448006]));
    let r436, g436 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1], [1.12]), [-0.11], [], 1, "grid-constant", 0.4);
    assert(g436.kind == scientific::F_NONE && r436.shape == [7] && common_3::tr_same(r436, [-0.92254, -0.32145999999999997, -0.05752000000000002, -0.09275000000000021, -0.48711000000000015, -0.10805999999999905, 0.38206000000000007]));
    let r437, g437 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1, 1], [-0.41]), [-0.11], [2], 1, "grid-constant", 0.4);
    assert(g437.kind == scientific::F_NONE && r437.shape == [2] && common_3::tr_same(r437, [-0.92254, -0.31327999999999995]));
    let r438, g438 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([2, 2], [-0.41, -0.11, 0.0, 1.0]), [], [], 1, "grid-constant", 0.4);
    assert(g438.kind == scientific::F_NONE && r438.shape == [7] && common_3::tr_same(r438, [-0.92254, -0.31327999999999995, 0.2959799999999999, 0.4, 0.4, 0.4, 0.4]));
    let r439, g439 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1], [1.72]), [1.18], [], 3, "grid-constant", 0.4);
    assert(g439.kind == scientific::F_NONE && r439.shape == [7] && common_3::tr_same(r439, [-0.2002364857669088, 0.03808896613724476, -0.6525207580017387, 0.4643176827847046, 0.40178112524425835, 0.39934844675951864, 0.39989928556695115]));
    let r440, g440 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1, 1], [1.18]), [1.18], [5], 3, "grid-constant", 0.4);
    assert(g440.kind == scientific::F_NONE && r440.shape == [5] && common_3::tr_same(r440, [-0.2002364857669088, -0.014072244735621768, -0.18759262316180889, -0.6478244328261806, 0.2854720548465212]));
    let r441, g441 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([2, 2], [1.18, 1.18, 0.0, 1.0]), [], [], 3, "grid-constant", 0.4);
    assert(g441.kind == scientific::F_NONE && r441.shape == [7] && common_3::tr_same(r441, [-0.2002364857669088, -0.014072244735621768, -0.18759262316180889, -0.6478244328261806, 0.2854720548465212, 0.3914584115993394, 0.40514557485388314]));
    let r442, g442 = scientific::shift(common_3::tr_arr(2), [-0.37, -1.58], 0, "mirror", 0.4);
