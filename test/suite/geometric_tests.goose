fn test_geometric_pins3() {
    let r60, g60 = scientific::geometric_transform(common_3::ni_nd([2], [-3.201, -2.077]), [], 2, "nearest", 0.0, true) { c, o => { o[0] = 0.02 * c[0] + -0.92; } };
    assert(g60.kind == scientific::F_NONE && r60.shape == [2] && common_3::tr_same(r60, [-3.21105988212275, -3.2138943735355845]));
    let r61, g61 = scientific::geometric_transform(common_3::ni_nd([2], [-3.201, -2.077]), [], 2, "nearest", 0.0, true) { c, o => { o[0] = 0.02 * c[0] + -0.92; } };
    assert(g61.kind == scientific::F_NONE && r61.shape == [2] && common_3::tr_same(r61, [-3.21105988212275, -3.2138943735355845]));
