fn test_rank_pins34() {
    let r1190, g1190 = scientific::maximum_filter1d(common_3::ni_arr(1), 7, -1, "constant", 0.3, -3);
    assert(g1190.kind == scientific::F_NONE && common_3::nd_same(r1190, [-0.025, -0.025, 0.236, 0.3, 0.3, 0.3, 0.3, 0.3, 0.3]));
    let r1191, g1191 = scientific::minimum_filter1d(common_3::ni_arr(2), 7, 1, "constant", 0.3, 0);
    assert(g1191.kind == scientific::F_NONE && common_3::nd_same(r1191, [-0.843, -0.843, -0.843, -0.843, -0.843, -0.843, -1.744, -1.744, -1.744, -1.744, -1.744, 0.083, -1.931, -1.931, -1.931, -1.931, -1.931, -1.931, 0.27, -0.781, -0.781, -0.781, -0.781, -0.781, -0.877, -0.877, -1.532, -1.532, -1.532, -1.532]));
    let r1192, g1192 = scientific::maximum_filter1d(common_3::ni_arr(2), 7, 1, "constant", 0.3, 0);
