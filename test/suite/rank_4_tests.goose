fn test_rank_pins39() {
    let r1365, g1365 = scientific::sobel(common_3::ni_arr(1), 0, "wrap", 0.5);
    assert(g1365.kind == scientific::F_NONE && common_3::nd_same(r1365, [-1.177, 0.23299999999999998, 0.9159999999999999, -0.025, -0.6869999999999999, -0.909, -0.06500000000000006, 1.221, 0.49300000000000005]));
    let r1366, g1366 = scientific::prewitt(common_3::ni_arr(1), 0, "wrap", 0.5);
    assert(g1366.kind == scientific::F_NONE && common_3::nd_same(r1366, [-1.177, 0.23299999999999998, 0.9159999999999999, -0.025, -0.6869999999999999, -0.909, -0.06500000000000006, 1.221, 0.49300000000000005]));
    let r1367, g1367 = scientific::sobel(common_3::ni_arr(1), -1, "wrap", 0.5);
    assert(g1367.kind == scientific::F_NONE && common_3::nd_same(r1367, [-1.177, 0.23299999999999998, 0.9159999999999999, -0.025, -0.6869999999999999, -0.909, -0.06500000000000006, 1.221, 0.49300000000000005]));
    let r1368, g1368 = scientific::prewitt(common_3::ni_arr(1), -1, "wrap", 0.5);
    assert(g1368.kind == scientific::F_NONE && common_3::nd_same(r1368, [-1.177, 0.23299999999999998, 0.9159999999999999, -0.025, -0.6869999999999999, -0.909, -0.06500000000000006, 1.221, 0.49300000000000005]));
    let r1369, g1369 = scientific::sobel(common_3::ni_arr(2), 0, "wrap", 0.5);
    assert(g1369.kind == scientific::F_NONE && common_3::nd_same(r1369, [2.218, -2.719, -3.0789999999999997, -2.423, 0.839, 5.12, -0.08900000000000008, -1.395, -2.371, -0.0029999999999998916, 1.6300000000000001, 0.5680000000000001, 1.9500000000000002, 4.775, 4.627000000000001, 2.136, -1.021, -1.355, -2.346, 3.52, 5.973, 2.993, -2.599, -5.484999999999999, -1.733, -4.181, -5.15, -2.703, 1.151, 1.1520000000000001]));
    let r1370, g1370 = scientific::prewitt(common_3::ni_arr(2), 0, "wrap", 0.5);
    assert(g1370.kind == scientific::F_NONE && common_3::nd_same(r1370, [1.077, -0.7269999999999999, -3.203, -1.088, 0.716, 3.192, -0.3320000000000001, -1.12, -1.283, -0.08299999999999996, 0.7050000000000001, 0.8680000000000001, 1.9440000000000002, 2.704, 4.0, 0.8340000000000001, 0.07400000000000007, -1.222, -1.516, 2.29, 4.083, 2.0300000000000002, -1.776, -3.569, -1.173, -3.1470000000000002, -3.597, -1.693, 0.281, 0.731]));
    let r1371, g1371 = scientific::sobel(common_3::ni_arr(2), 1, "wrap", 0.5);
