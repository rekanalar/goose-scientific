// The tests of the group vectorized. Run them with SCIENTIFIC_SUITES=vectorized.
namespace vectorized_tests;

import scientific from "../..";
import os;
import common_3;

fn test_vectorized_pins0() {
    let r0, g0 = scientific::vectorized_filter(common_3::ni_nd([3, 2], [4.842, 1.161, -2.542, 1.278, 0.279, -1.986]), [1, 1], "reflect", 0.0, [0, 0]) { x, o => { var h = x.ndim / 2; var d = 0; var n = 1; while d < h { n *= x.shape[d]; d += 1; } var w = 1; d = h; while d < x.ndim { w *= x.shape[d]; d += 1; } var p = 0; while p < n { var s = 0.0; var j = 0; while j < w { s += x.data[p * w + j]; j += 1; } o[p] = s; p += 1; } } };
    assert(g0.kind == scientific::F_NONE && r0.shape == [3, 2] && common_3::tr_same(r0, [4.842, 1.161, -2.542, 1.278, 0.279, -1.986]));
