// The tests of the group dpss. Run them with SCIENTIFIC_SUITES=dpss.
namespace dpss_tests;

import scientific from "../..";
import os;
import common;

// dpss is pinned against SciPy for one window, several windows, the
// periodic form and the norms.
fn test_dpss() {
    let d0, f0 = scientific::dpss(16, 2.5);
    assert(f0.kind == scientific::F_NONE);
    assert(common::win_close(d0, [0.016317047030418655, 0.06340126386238834, 0.15845631025268223, 0.3086652017129723, 0.5032772641781225, 0.7113142022250394, 0.8882720166419921, 0.9903288201160542, 0.9903288201160542, 0.8882720166419918, 0.711314202225039, 0.5032772641781222, 0.308665201712972, 0.15845631025268206, 0.06340126386238829, 0.01631704703041864]));
    let d1, f1 = scientific::dpss(15, 3.0, 3);
    assert(f1.kind == scientific::F_NONE);
    assert(common::win_close(d1, [0.0037469532703791183, 0.019738598733284245, 0.06007178916483362, 0.1335601667570441, 0.23662603744318103, 0.34848806231558105, 0.4363318253551655, 0.4697406456190516, 0.4363318253551655, 0.34848806231558105, 0.23662603744318103, 0.1335601667570441, 0.06007178916483362, 0.019738598733284245, 0.0037469532703791187, 0.018455407259290287, 0.07582785828710926, 0.18125465349655787, 0.3095306632862646, 0.3998304228518963, 0.38528012874584927, 0.2386250369880479, 5.628710300965063e-17, -0.2386250369880478, -0.3852801287458492, -0.39983042285189624, -0.30953066328626455, -0.1812546534965578, -0.07582785828710924, -0.01845540725929028, 0.06185554949593948, 0.18884289924318579, 0.33548858947046506, 0.400156093986345, 0.2997028445832034, 0.05223901255414873, -0.20925037531544208, -0.3209309213184132, -0.20925037531544213, 0.052239012554148694, 0.2997028445832034, 0.40015609398634505, 0.3354885894704652, 0.18884289924318587, 0.06185554949593951]));
    let d2, f2 = scientific::dpss(12, 2.0, 2, false, "approximate");
    assert(f2.kind == scientific::F_NONE);
    assert(common::win_close(d2, [0.048953888295962124, 0.1545806990403657, 0.32735499813886637, 0.5480588250591538, 0.7710682557928902, 0.9380097392736036, 1.0, 0.9380097392736036, 0.7710682557928903, 0.5480588250591539, 0.3273549981388664, 0.15458069904036575, 0.20660001936400177, 0.4677575329825821, 0.7306823089939881, 0.8721382022125558, 0.7924393885658259, 0.47356882249718596, -1.5049496818025036e-16, -0.4735688224971862, -0.7924393885658259, -0.8721382022125558, -0.7306823089939883, -0.4677575329825822]));
    let d3, f3 = scientific::dpss(20, 4.0, 4);
    assert(f3.kind == scientific::F_NONE);
    assert(common::win_close(d3, [0.00040168075357837387, 0.0028078249873478046, 0.011014484114096583, 0.03124001708094586, 0.07053306070242975, 0.1331186629685207, 0.21605978541162896, 0.30691464981244326, 0.38577536042617855, 0.43185430912259537, 0.43185430912259537, 0.38577536042617855, 0.30691464981244326, 0.21605978541162899, 0.13311866296852076, 0.07053306070242979, 0.03124001708094588, 0.011014484114096591, 0.002807824987347807, 0.00040168075357837425, 0.0023307242194475575, 0.013578066291007102, 0.04471378585280919, 0.10588329369261998, 0.19657350464766118, 0.2969486471173236, 0.3687184673821026, 0.3697111529304576, 0.27669497439742036, 0.10286016678522557, -0.10286016678522629, -0.27669497439742086, -0.36971115293045764, -0.3687184673821026, -0.2969486471173236, -0.19657350464766107, -0.1058832936926199, -0.04471378585280916, -0.013578066291007095, -0.0023307242194475566, 0.009331443187915733, 0.04418706065491568, 0.11916100702256513, 0.22812125781127837, 0.3314737853232691, 0.3668641255351118, 0.2859263317002585, 0.09551522418132546, -0.1298655142219386, -0.2819849996425258, -0.28198499964252577, -0.12986551422193848, 0.09551522418132562, 0.2859263317002586, 0.3668641255351118, 0.33147378532326915, 0.22812125781127843, 0.11916100702256517, 0.04418706065491569, 0.009331443187915737, 0.029639663336898242, 0.11032283569674116, 0.2351733031247714, 0.3451313944387695, 0.35394673663997367, 0.21423963250065986, -0.02531357323790679, -0.23084178071942488, -0.27089421536962716, -0.11848589453020822, 0.11848589453020833, 0.2708942153696272, 0.23084178071942482, 0.025313573237906697, -0.21423963250065992, -0.3539467366399736, -0.3451313944387694, -0.23517330312477128, -0.11032283569674113, -0.029639663336898235]));
    let d4, f4 = scientific::dpss(64, 3.5);
    assert(f4.kind == scientific::F_NONE);
    assert(common::win_close(d4, [0.0004363528176095625, 0.0011694279650277303, 0.002471684070279874, 0.004590970503823901, 0.007828996859395615, 0.012539975346116394, 0.01912564530369338, 0.028026299430360557, 0.03970764837226708, 0.054643619458447985, 0.07329547202426853, 0.09608790775903146, 0.12338313914535201, 0.15545413055250948, 0.19245842366382487, 0.23441408264775265, 0.28117932966896736, 0.33243737810994123, 0.38768780575300665, 0.44624554672951394, 0.50724823005927, 0.5696721716829668, 0.6323568595232404, 0.6940372852502605, 0.7533830026694702, 0.8090423621320525, 0.859690012565966, 0.9040755032813562, 0.9410706764910581, 0.9697135310354669, 0.9892463622340031, 0.9991462373460177, 0.9991462373460178, 0.9892463622340031, 0.9697135310354669, 0.9410706764910582, 0.9040755032813562, 0.8596900125659659, 0.8090423621320523, 0.7533830026694701, 0.6940372852502604, 0.6323568595232404, 0.5696721716829667, 0.50724823005927, 0.44624554672951394, 0.38768780575300665, 0.3324373781099413, 0.2811793296689674, 0.23441408264775268, 0.19245842366382487, 0.15545413055250948, 0.12338313914535198, 0.09608790775903142, 0.07329547202426848, 0.05464361945844795, 0.039707648372267056, 0.028026299430360533, 0.019125645303693366, 0.012539975346116386, 0.00782899685939561, 0.004590970503823897, 0.0024716840702798722, 0.0011694279650277294, 0.0004363528176095621]));
    // The norm subsample and the concentration ratios.
    let ds, fds = scientific::dpss(8, 2.0, 0, true, "subsample");
    assert(fds.kind == scientific::F_NONE && common::win_close(ds, [0.08664829928367265, 0.330962077699254, 0.686872284903535, 0.9595673129729012, 0.9595673129729012, 0.686872284903535, 0.33096207769925395, 0.08664829928367264]));
    let ds2, fds2 = scientific::dpss(10, 2.5, 0, true, "subsample");
    assert(fds2.kind == scientific::F_NONE && common::win_close(ds2, [0.03348635548276011, 0.1611735001228393, 0.4175208958618425, 0.7384470765647055, 0.9675042425395557, 0.9675042425395557, 0.7384470765647057, 0.41752089586184254, 0.16117350012283935, 0.03348635548276011]));
    let dw, dr, fdr = scientific::dpss_ratios(8, 2.0, 0, false);
    assert(fdr.kind == scientific::F_NONE && dr.ndim == 0 && common::near(dr.data[0], 0.9999780799508334));
    assert(common::win_close(dw, [0.0740907202847688, 0.27352337476511307, 0.5821741797391821, 0.8772657297808555, 1.0, 0.8772657297808554, 0.5821741797391818, 0.27352337476511296]));
    let dw2, dr2, fdr2 = scientific::dpss_ratios(16, 3.0, 4);
    assert(fdr2.kind == scientific::F_NONE && dr2.ndim == 1 && common::win_close(dr2, [0.9999999527920653, 0.9999957218401485, 0.9998315378762141, 0.9962957001645156]));
    let e1, g1 = scientific::dpss(8, 4.0);
    assert(g1.kind == scientific::F_RANGE);
    let e2, g2 = scientific::dpss(8, 0.0);
    assert(g2.kind == scientific::F_RANGE);
    let e3, g3 = scientific::dpss(8, 2.0, 9);
    assert(g3.kind == scientific::F_RANGE);
    let e4, g4 = scientific::dpss(8, 2.0, 0, true, "bogus");
    assert(g4.kind == scientific::F_VALUE);
    let e5, g5 = scientific::dpss(0, 2.0);
    assert(g5.kind == scientific::F_RANGE);
}
