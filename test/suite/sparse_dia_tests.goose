    let qr, qo2 = scientific::dia_to_dense(qp);
    assert(qo2.kind == scientific::F_NONE && common_3::ms_same(qr, [-1.484, 0.815, 0.0, 2.469, 1.615, -1.426, 2.825]));
    let qu2, qw2 = scientific::dia_from_diagonals(7, 1, [-6.0, -5.0, -4.0, -3.0, -1.0, 0.0], [2.825, -1.426, 1.615, 2.469, 0.815, -1.484]);
