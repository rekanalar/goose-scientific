fn test_sparse_dia_pins8() {
    let qc, qg = scientific::dia_from_dense(common_3::ni_nd([2, 2], [0.0, -0.131, 0.0, 2.078]));
    assert(qg.kind == scientific::F_NONE && qc.nnz == 3);
    assert(qc.ndiag == 2 && scientific::dia_nnz(qc) == 3);
    let qo, qv, qu = scientific::dia_diagonals(qc);
    assert(qu.kind == scientific::F_NONE);
    assert(qo.shape == [2] && common_3::ms_same(qo, [0.0, 1.0]));
    assert(qv.shape == [3] && common_3::ms_same(qv, [0.0, 2.078, -0.131]));
    let qd, qh = scientific::dia_to_dense(qc);
    assert(qh.kind == scientific::F_NONE && common_3::ms_same(qd, [0.0, -0.131, 0.0, 2.078]));
    assert(common_3::dia_same(qc, 2, 2, [0.0, -0.131, 0.0, 2.078]));
    let qm, qn = scientific::dia_matvec(qc, [1.004, -1.929]);
    assert(qn.kind == scientific::F_NONE && common_3::ms_same(qm, [0.252699, -4.008462]));
    let qt, qtg = scientific::dia_transpose(qc);
    assert(qtg.kind == scientific::F_NONE && qt.nnz == 3);
    let qy, qz = scientific::dia_to_dense(qt);
    assert(qz.kind == scientific::F_NONE && common_3::ms_same(qy, [0.0, 0.0, -0.131, 2.078]));
    let qsc, qsg = scientific::dia_scale(qc, 2.5);
    assert(qsg.kind == scientific::F_NONE && qsc.nnz == 3);
    let qsd, qse = scientific::dia_to_dense(qsc);
    assert(qse.kind == scientific::F_NONE && common_3::ms_same(qsd, [0.0, -0.3275, 0.0, 5.194999999999999]));
    assert(common::near(scientific::dia_sum(qc), 1.9469999999999998));
    let qk, ql = scientific::dia_to_csr(qc);
    assert(ql.kind == scientific::F_NONE && qk.nnz == 2);
    let qj, qi = scientific::dia_to_coo(qc);
    assert(qi.kind == scientific::F_NONE && qj.nnz == 2);
    let qf, qe = scientific::dia_from_csr(qk);
    assert(qe.kind == scientific::F_NONE && qf.nnz == 3);
    let qb, qa = scientific::dia_to_dense(qf);
    assert(qa.kind == scientific::F_NONE && common_3::ms_same(qb, [0.0, -0.131, 0.0, 2.078]));
    let qp, qq = scientific::dia_from_coo(qj);
    assert(qq.kind == scientific::F_NONE && qp.nnz == 3);
    let qr, qo2 = scientific::dia_to_dense(qp);
    assert(qo2.kind == scientific::F_NONE && common_3::ms_same(qr, [0.0, -0.131, 0.0, 2.078]));
    let qu2, qw2 = scientific::dia_from_diagonals(2, 2, [0.0, 1.0], [0.0, 2.078, -0.131]);
    assert(qw2.kind == scientific::F_NONE && qu2.nnz == 3);
    let qx2, qy2 = scientific::dia_to_dense(qu2);
    assert(qy2.kind == scientific::F_NONE && common_3::ms_same(qx2, [0.0, -0.131, 0.0, 2.078]));
}

fn test_sparse_dia_pins9() {
    let qc, qg = scientific::dia_from_dense(common_3::ni_nd([1, 7], [0.0, -0.313, 0.0, -0.605, 0.0, -0.145, 0.0]));
