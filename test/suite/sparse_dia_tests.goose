fn test_sparse_dia_pins10() {
    let qc, qg = scientific::dia_from_dense(common_3::ni_nd([7, 1], [-1.484, 0.815, 0.0, 2.469, 1.615, -1.426, 2.825]));
    assert(qg.kind == scientific::F_NONE && qc.nnz == 6);
