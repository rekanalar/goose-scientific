    assert(i133.shape == [2, 3, 1] && common_3::ms_same(i133, [0.0, 0.0, 2.0, 0.0, 0.0, 0.0]));
    let r134, i134, g134 = scientific::distance_transform_cdt_st_indices(common_3::ni_nd([3, 1], [0.0, 1.0, 0.0]), common_3::ni_nd([3, 3], [1.0, 0.0, 1.0, 0.0, 1.0, 1.0, 1.0, 0.0, 0.0]));
