fn test_dist_pins9() {
    let r157, i157, g157 = scientific::distance_transform_cdt_indices(common_3::ni_nd([4], [0.0, 1.0, 1.0, 1.0]), "chessboard");
    assert(g157.kind == scientific::F_NONE);
    assert(r157.shape == [4] && common_3::ms_same(r157, [0.0, 1.0, 2.0, 3.0]));
    assert(i157.shape == [1, 4] && common_3::ms_same(i157, [0.0, 0.0, 0.0, 0.0]));
    let r158, i158, g158 = scientific::distance_transform_cdt_st_indices(common_3::ni_nd([4], [0.0, 1.0, 1.0, 1.0]), common_3::ni_nd([3], [0.0, 1.0, 1.0]));
    assert(g158.kind == scientific::F_NONE);
    assert(r158.shape == [4] && common_3::ms_same(r158, [0.0, -1.0, -1.0, -1.0]));
    assert(i158.shape == [1, 4] && common_3::ms_same(i158, [0.0, 1.0, 2.0, 3.0]));
    let r159, g159 = scientific::distance_transform_cdt_st(common_3::ni_nd([4], [0.0, 1.0, 1.0, 1.0]), common_3::ni_nd([3], [0.0, 1.0, 1.0]));
