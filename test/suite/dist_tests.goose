    assert(r134.shape == [3, 1] && common_3::ms_same(r134, [0.0, -1.0, 0.0]));
    assert(i134.shape == [2, 3, 1] && common_3::ms_same(i134, [0.0, 1.0, 2.0, 0.0, 0.0, 0.0]));
    let r135, g135 = scientific::distance_transform_cdt_st(common_3::ni_nd([3, 1], [0.0, 1.0, 0.0]), common_3::ni_nd([3, 3], [1.0, 0.0, 1.0, 0.0, 1.0, 1.0, 1.0, 0.0, 0.0]));
    assert(g135.kind == scientific::F_NONE);
    assert(r135.shape == [3, 1] && common_3::ms_same(r135, [0.0, -1.0, 0.0]));
