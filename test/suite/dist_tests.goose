    assert(g16.kind == scientific::F_NONE);
    assert(r16.shape == [3] && common_3::ms_same(r16, [0.0, 0.0, 1.0]));
    let r17, i17, g17 = scientific::distance_transform_cdt_indices(common_3::ni_nd([3], [0.0, 0.0, 1.0]), "taxicab");
    assert(g17.kind == scientific::F_NONE);
