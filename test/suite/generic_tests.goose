// The tests of the group generic. Run them with SCIENTIFIC_SUITES=generic.
namespace generic_tests;

import scientific from "../..";
import os;
import common_3;

fn test_generic_pins0() {
    let r0, g0 = scientific::generic_filter(common_3::ni_arr(1), [3], "reflect", 0.7, [0]) { w => common_3::gsum(w) };
    assert(g0.kind == scientific::F_NONE && common_3::nd_same(r0, [-1.509, -1.2759999999999998, -1.017, -0.152, -0.813, -1.773, -2.474, -1.526, -0.30500000000000005]));
    let r1, g1 = scientific::generic_filter(common_3::ni_arr(1), [3], "reflect", 0.7, [-1]) { w => common_3::gsum(w) };
    assert(g1.kind == scientific::F_NONE && common_3::nd_same(r1, [-1.2759999999999998, -1.017, -0.152, -0.813, -1.773, -2.474, -1.526, -0.30500000000000005, -0.30500000000000005]));
