    let r3, g3 = scientific::generic_filter(common_3::ni_arr(1), [3], "reflect", 0.7, [0]) { w => common_3::grange(w) };
    assert(g3.kind == scientific::F_NONE && common_3::nd_same(r3, [0.657, 0.8899999999999999, 0.9159999999999999, 0.051, 0.6869999999999999, 0.909, 0.273, 1.221, 1.013]));
    let r4, g4 = scientific::generic_filter(common_3::ni_arr(1), [3], "reflect", 0.7, [-1]) { w => common_3::grange(w) };
    assert(g4.kind == scientific::F_NONE && common_3::nd_same(r4, [0.8899999999999999, 0.9159999999999999, 0.051, 0.6869999999999999, 0.909, 0.273, 1.221, 1.013, 1.013]));
