    let r399, g399 = scientific::find_objects(common_3::ni_nd([3, 2, 4], [3.0, 0.0, 3.0, 3.0, -1.0, -1.0, 4.0, 1.0, 0.0, 3.0, 2.0, 4.0, -1.0, 1.0, 4.0, -1.0, 4.0, 1.0, 4.0, 3.0, 3.0, -1.0, 1.0, 4.0]));
