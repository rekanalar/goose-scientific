    assert(g401.kind == scientific::F_NONE && r401.shape == [3] && common_3::ms_same(r401, [11.0, 0.0, -7.5]));
    let r402, g402 = scientific::labeled_comprehension(common_3::ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), common_3::ni_nd([3, 2, 4], [3.0, 0.0, 3.0, 3.0, -1.0, -1.0, 4.0, 1.0, 0.0, 3.0, 2.0, 4.0, -1.0, 1.0, 4.0, -1.0, 4.0, 1.0, 4.0, 3.0, 3.0, -1.0, 1.0, 4.0])) { v => common_3::msrange(v) };
    assert(g402.kind == scientific::F_NONE && r402.shape == [1] && common_3::ms_same(r402, [13.0]));
    let r403, g403 = scientific::sum_labels(common_3::ni_nd([3, 2, 4], [-0.573, 1.98, -0.091, 0.161, -0.224, -1.036, 1.074, -0.279, 0.179, -0.096, -1.995, 1.027, -0.403, 0.292, 0.739, -0.296, 0.074, 0.264, 1.452, 0.466, -0.038, 0.083, 0.957, 0.607]), common_3::ni_nd([3, 2, 4], [3.0, 0.0, 3.0, 3.0, -1.0, -1.0, 4.0, 1.0, 0.0, 3.0, 2.0, 4.0, -1.0, 1.0, 4.0, -1.0, 4.0, 1.0, 4.0, 3.0, 3.0, -1.0, 1.0, 4.0]), []);
