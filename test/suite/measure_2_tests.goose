// The tests of the group measure. Run them with SCIENTIFIC_SUITES=measure.
namespace measure_2_tests;

import scientific from "../..";
import os;
import common_3;

fn test_measure_pins13() {
    let r390, g390 = scientific::histogram_labels(common_3::ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), -2.0, 3.0, 5, common_3::ni_nd([3, 2, 4], [3.0, 0.0, 3.0, 3.0, -1.0, -1.0, 4.0, 1.0, 0.0, 3.0, 2.0, 4.0, -1.0, 1.0, 4.0, -1.0, 4.0, 1.0, 4.0, 3.0, 3.0, -1.0, 1.0, 4.0]));
    assert(g390.kind == scientific::F_NONE && r390.shape == [5] && common_3::ms_same(r390, [2.0, 5.0, 2.0, 2.0, 3.0]));
    let r391, g391 = scientific::histogram_labels(common_3::ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), -2.0, 3.0, 5, scientific::empty_arr());
    assert(g391.kind == scientific::F_NONE && r391.shape == [5] && common_3::ms_same(r391, [4.0, 5.0, 2.0, 2.0, 5.0]));
    let r392, g392 = scientific::histogram_labels(common_3::ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), 0.5, 0.5, 3, common_3::ni_nd([3, 2, 4], [3.0, 0.0, 3.0, 3.0, -1.0, -1.0, 4.0, 1.0, 0.0, 3.0, 2.0, 4.0, -1.0, 1.0, 4.0, -1.0, 4.0, 1.0, 4.0, 3.0, 3.0, -1.0, 1.0, 4.0]), [1]);
    assert(g392.kind == scientific::F_NONE && r392.shape == [1, 3] && common_3::ms_same(r392, [0.0, 0.0, 0.0]));
    let r393, g393 = scientific::sum_labels(common_3::ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), scientific::empty_arr());
    assert(g393.kind == scientific::F_NONE && r393.shape == [1] && common_3::ms_same(r393, [5.0]));
    let r394, g394 = scientific::mean_labels(common_3::ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), scientific::empty_arr());
    assert(g394.kind == scientific::F_NONE && r394.shape == [1] && common_3::ms_same(r394, [0.20833333333333334]));
    let r395, g395 = scientific::variance_labels(common_3::ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), scientific::empty_arr());
    assert(g395.kind == scientific::F_NONE && r395.shape == [1] && common_3::ms_same(r395, [8.664930555555555]));
    let r396, g396 = scientific::median_labels(common_3::ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), scientific::empty_arr());
    assert(g396.kind == scientific::F_NONE && r396.shape == [1] && common_3::ms_same(r396, [-0.5]));
    let r397, g397 = scientific::center_of_mass(common_3::ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), scientific::empty_arr());
    assert(g397.kind == scientific::F_NONE && r397.shape == [1, 3] && common_3::ms_same(r397, [4.6, -0.2, 7.2]));
    let r398, g398 = scientific::minimum_position(common_3::ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), scientific::empty_arr());
