    assert(g830.kind == scientific::F_NONE && r830.shape == [3, 2, 4] && common_3::tr_same(r830, [-1.0647322049937875, -0.9060643032071624, 0.3757048679663678, 1.6595789374014345, 0.0055847423633751305, 0.5577004764231728, -0.25279068583619235, -0.19721890034593978, -1.6220379715554538, -1.535002586252021, -1.6231142358865513, 0.3899208187558146, 2.1321784995591173, -0.21261004308818102, -0.18074057710323965, -0.5473758537157078, -1.0022532762876906, 2.0000476866126315, 0.26631308557515276, 0.09838790377589629, 0.4885244742183117, -0.7230463511505802, -0.18384476978945127, 0.4349460745260113]));
    let r831, g831 = scientific::rotate(common_3::tr_arr(3), 90.0, [1, 0], true, 3, "grid-constant", 0.4);
    assert(g831.kind == scientific::F_NONE && r831.shape == [2, 3, 4] && common_3::tr_same(r831, [-0.6870000000000002, 0.20499999999999965, -0.41000000000000025, 0.11700000000000033, 2.0370000000000004, 0.12300000000000004, -0.10600000000000008, -0.622, 1.1500000000000001, -1.9339999999999997, -0.49999999999999983, 0.46600000000000014, -1.0340000000000005, -1.298, 0.573, 2.070000000000001, -1.6429999999999996, -1.1810000000000003, -1.7230000000000005, 0.12700000000000047, -0.8289999999999997, 2.315, 0.5620000000000003, 0.15200000000000008]));
    let r832, g832 = scientific::rotate(common_3::tr_arr(3), 90.0, [1, 0], false, 3, "grid-constant", 0.4);
    assert(g832.kind == scientific::F_NONE && r832.shape == [3, 2, 4] && common_3::tr_same(r832, [0.7869951907726733, 0.6903093041196389, 0.14614649427313745, -0.1865045151967844, 1.5709029804533332, -0.5796634592491513, 0.10782925759747777, 0.14390473029389636, -0.618764484085062, -0.9204704822239684, -0.7211856456489169, 0.44709686703765117, 0.27375590692756385, -0.2762123743137767, -0.765330875566779, -0.23868398188439138, -0.78960723811626, -0.9306140396605199, -0.22944888708739514, 1.0236087855822076, -0.8703617185510802, 0.8469238450737793, -0.22591053593270957, 0.15292160561223014]));
