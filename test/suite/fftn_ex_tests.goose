// The tests of the group fftn_ex. Run them with SCIENTIFIC_SUITES=fftn_ex.
namespace fftn_ex_tests;

import scientific from "../..";
import os;
import common;

// hfft2, ihfft2, hfftn and ihfftn are pinned against SciPy.
// fftn_ex and ifftn_ex are pinned against SciPy.
fn test_fftn_ex() {
    let xr0 = common::av([0.42, -1.31, 0.75, -0.08, 1.92, -0.63, 0.11, -1.44, 0.87, 0.33, -0.92, 1.05, -0.27, 0.68, -1.7, 0.5]);
    let xi0 = common::av([0.13, 0.87, -0.44, 1.21, -0.76, 0.05, -1.02, 0.6, -0.35, 1.13, 0.4, -0.58, 0.95, -0.2, 0.71, -0.83]);
    let xr3, g1 = scientific::reshape(xr0, [2, 4, 2]);
    let xi3, g2 = scientific::reshape(xi0, [2, 4, 2]);
    let xr4, g3 = scientific::reshape(xr0, [2, 2, 2, 2]);
    let xi4, g4 = scientific::reshape(xi0, [2, 2, 2, 2]);
    assert(g1.kind == scientific::F_NONE && g2.kind == scientific::F_NONE && g3.kind == scientific::F_NONE && g4.kind == scientific::F_NONE);
    let f0r, f0i, ff0 = scientific::fftn_ex(xr3, xi3, [], [1000], "backward");
    assert(ff0.kind == scientific::F_NONE && f0r.shape[0] == 2 && f0r.shape[1] == 4 && f0r.shape[2] == 2);
    assert(common::all_close(f0r, [0.28000000000000014, 2.079999999999999, -0.26000000000000023, 0.08000000000000052, 3.7399999999999993, 5.659999999999999, -2.5200000000000005, 1.2600000000000002, -0.7999999999999999, 11.239999999999998, -1.7200000000000002, -1.7799999999999998, -1.62, -1.8600000000000003, -4.22, -2.8400000000000003], 1.0e-12) && common::all_close(f0i, [1.87, -2.6300000000000003, -1.5900000000000003, -2.07, 1.7699999999999996, -1.1300000000000001, 5.07, -3.05, -0.59, -7.01, 1.0100000000000002, 3.65, -1.8899999999999997, 4.57, 2.35, 1.75], 1.0e-12));
    let f1r, f1i, ff1 = scientific::fftn_ex(xr3, xi3, [3, 2], [0, 1], "ortho");
    assert(ff1.kind == scientific::F_NONE && f1r.shape[0] == 3 && f1r.shape[1] == 2 && f1r.shape[2] == 2);
    assert(common::all_close(f1r, [0.45723808531952664, -0.004082482904638585, 0.5960425040772401, -0.7960841664045328, 0.5055343766339799, -0.6547020793385346, -0.7652691987631874, 0.24940028521093718, 0.47017903757465257, -1.0436108089911356, -0.2349391128732769, -0.9597523106180588], 1.0e-12) && common::all_close(f1i, [-0.10614455552060437, 1.0736930039199597, -0.07348469228349533, 0.5593001579354924, -0.11908550777573045, 0.24898448526855502, -0.24706593467360943, -0.2332982658771592, -0.1544408468350577, 1.2247918433059906, 1.0186552036503105, -0.7424151483314734], 1.0e-12));
    let f2r, f2i, ff2 = scientific::fftn_ex(xr3, xi3, [2], [1], "forward");
    assert(ff2.kind == scientific::F_NONE && f2r.shape[0] == 2 && f2r.shape[1] == 2 && f2r.shape[2] == 2);
    assert(common::all_close(f2r, [0.585, -0.6950000000000001, -0.165, -0.615, -0.025000000000000022, 0.6900000000000001, 0.895, -0.36], 1.0e-12) && common::all_close(f2i, [-0.155, 1.04, 0.28500000000000003, -0.16999999999999998, 0.025000000000000022, 0.27499999999999997, -0.375, 0.855], 1.0e-12));
    let f3r, f3i, ff3 = scientific::fftn_ex(xr3, xi3, [], [2, 0], "backward");
    assert(ff3.kind == scientific::F_NONE && f3r.shape[0] == 2 && f3r.shape[1] == 4 && f3r.shape[2] == 2);
    assert(common::all_close(f3r, [0.30999999999999983, 2.27, 0.8, -1.1400000000000001, 1.7000000000000002, 1.5999999999999996, -2.53, -0.6500000000000001, -2.09, 1.19, 0.54, 2.8000000000000003, 0.88, 3.5, -0.1299999999999999, 3.75], 1.0e-12) && common::all_close(f3i, [1.7799999999999998, -2.2199999999999998, 0.5900000000000001, -0.6699999999999999, 0.040000000000000036, 0.33999999999999986, -0.54, -0.08000000000000007, 0.22000000000000008, 0.74, 0.95, -2.63, -1.46, -1.96, -0.30000000000000004, -3.16], 1.0e-12));
    let f4r, f4i, ff4 = scientific::fftn_ex(xr3, xi3, [-1, 3], [1000], "ortho");
    assert(ff4.kind == scientific::F_NONE && f4r.shape[0] == 2 && f4r.shape[1] == 4 && f4r.shape[2] == 3);
    assert(common::all_close(f4r, [-0.07505553499465145, 2.1056684135524275, 0.7406684135524275, -0.28578838324886474, -0.3904774941164093, -0.12047749411640937, 0.30599564267050167, 0.26536097746523374, 0.7103609774652337, -0.9728352035845195, 0.1307511818564433, -0.9592488181435563, 0.15588457268119893, -1.0726279441628823, -0.8326279441628824, 0.21073284825421343, 0.4490341184434353, 0.05903411844343545, 0.7736493607140985, 1.5924762197358966, 0.422476219735897, 0.24537386440559097, 0.9751814855409224, 0.03518148554092265], 1.0e-12) && common::all_close(f4i, [0.18475208614068028, -0.1323725900250784, -1.8623725900250783, -0.08371578903249571, 0.1676110699893027, 0.13261106998930267, -0.017320508075688773, 0.4730607966083864, 0.26306079660838644, 1.0709847493467557, 0.4495170592217177, -0.19548294077828232, 0.3550704155516198, -0.07708348754011485, 1.2029165124598848, -0.37527767497325665, -0.6880275824491876, -0.7380275824491876, 0.5282754963085076, -0.3499742261192855, -0.6199742261192855, 0.39259818304894545, -0.27146569650842667, -0.5714656965084267], 1.0e-12));
    let f5r, f5i, ff5 = scientific::fftn_ex(xr4, xi4, [4], [2], "backward");
    assert(ff5.kind == scientific::F_NONE && f5r.shape[0] == 2 && f5r.shape[1] == 2 && f5r.shape[2] == 4 && f5r.shape[3] == 2);
    assert(common::all_close(f5r, [1.17, -1.3900000000000001, -0.020000000000000018, -0.10000000000000009, -0.33, -1.23, 0.86, -2.52, 2.03, -2.07, 0.8999999999999999, -0.030000000000000027, 1.8099999999999998, 0.8099999999999999, 2.94, -1.23, -0.050000000000000044, 1.3800000000000001, 1.27, -0.24999999999999994, 1.79, -0.72, 0.47, 0.9099999999999999, -1.97, 1.1800000000000002, 0.43999999999999995, -0.1499999999999999, 1.43, 0.18000000000000005, -0.98, 1.51], 1.0e-12) && common::all_close(f5i, [-0.31, 2.08, -0.62, 0.95, 0.5700000000000001, -0.33999999999999997, 0.88, 0.79, -1.78, 0.65, -0.87, 1.49, 0.26, -0.5499999999999999, -0.65, -1.39, 0.050000000000000044, 0.5499999999999999, 0.5700000000000001, 0.07999999999999985, -0.75, 1.71, -1.27, 2.1799999999999997, 1.66, -1.03, 2.65, -0.7, 0.24, 0.6299999999999999, -0.75, 0.3], 1.0e-12));
    let i0r, i0i, fi0 = scientific::ifftn_ex(xr3, xi3, [], [1000], "backward");
    assert(fi0.kind == scientific::F_NONE && i0r.shape[0] == 2 && i0r.shape[1] == 4 && i0r.shape[2] == 2);
    assert(common::all_close(i0r, [0.01750000000000001, 0.12999999999999995, -0.15750000000000003, 0.07875000000000001, 0.23374999999999996, 0.35374999999999995, -0.016250000000000014, 0.005000000000000032, -0.049999999999999996, 0.7024999999999999, -0.26375, -0.17750000000000002, -0.10125, -0.11625000000000002, -0.10750000000000001, -0.11124999999999999], 1.0e-12) && common::all_close(i0i, [0.116875, -0.16437500000000002, 0.316875, -0.190625, 0.11062499999999997, -0.07062500000000001, -0.09937500000000002, -0.129375, -0.036875, -0.438125, 0.146875, 0.109375, -0.11812499999999998, 0.285625, 0.06312500000000001, 0.228125], 1.0e-12));
    let i1r, i1i, fi1 = scientific::ifftn_ex(xr3, xi3, [3, 2], [0, 1], "ortho");
    assert(fi1.kind == scientific::F_NONE && i1r.shape[0] == 3 && i1r.shape[1] == 2 && i1r.shape[2] == 2);
    assert(common::all_close(i1r, [0.45723808531952664, -0.004082482904638585, 0.5960425040772401, -0.7960841664045328, 0.47017903757465257, -1.0436108089911356, -0.2349391128732769, -0.9597523106180588, 0.5055343766339799, -0.6547020793385346, -0.7652691987631874, 0.24940028521093718], 1.0e-12) && common::all_close(i1i, [-0.10614455552060437, 1.0736930039199597, -0.07348469228349533, 0.5593001579354924, -0.1544408468350577, 1.2247918433059906, 1.0186552036503105, -0.7424151483314734, -0.11908550777573045, 0.24898448526855502, -0.24706593467360943, -0.2332982658771592], 1.0e-12));
    let i2r, i2i, fi2 = scientific::ifftn_ex(xr3, xi3, [2], [1], "forward");
    assert(fi2.kind == scientific::F_NONE && i2r.shape[0] == 2 && i2r.shape[1] == 2 && i2r.shape[2] == 2);
    assert(common::all_close(i2r, [1.17, -1.3900000000000001, -0.33, -1.23, -0.050000000000000044, 1.3800000000000001, 1.79, -0.72], 1.0e-12) && common::all_close(i2i, [-0.31, 2.08, 0.5700000000000001, -0.33999999999999997, 0.050000000000000044, 0.5499999999999999, -0.75, 1.71], 1.0e-12));
    let i3r, i3i, fi3 = scientific::ifftn_ex(xr3, xi3, [], [2, 0], "backward");
    assert(fi3.kind == scientific::F_NONE && i3r.shape[0] == 2 && i3r.shape[1] == 4 && i3r.shape[2] == 2);
    assert(common::all_close(i3r, [0.07749999999999996, 0.5675, 0.2, -0.28500000000000003, 0.42500000000000004, 0.3999999999999999, -0.6325, -0.16250000000000003, -0.5225, 0.2975, 0.135, 0.7000000000000001, 0.22, 0.875, -0.03249999999999997, 0.9375], 1.0e-12) && common::all_close(i3i, [0.44499999999999995, -0.5549999999999999, 0.14750000000000002, -0.16749999999999998, 0.010000000000000009, 0.08499999999999996, -0.135, -0.020000000000000018, 0.05500000000000002, 0.185, 0.2375, -0.6575, -0.365, -0.49, -0.07500000000000001, -0.79], 1.0e-12));
    let i4r, i4i, fi4 = scientific::ifftn_ex(xr3, xi3, [-1, 3], [1000], "ortho");
    assert(fi4.kind == scientific::F_NONE && i4r.shape[0] == 2 && i4r.shape[1] == 4 && i4r.shape[2] == 3);
    assert(common::all_close(i4r, [-0.07505553499465145, 0.7406684135524275, 2.1056684135524275, -0.9728352035845195, -0.9592488181435563, 0.1307511818564433, 0.30599564267050167, 0.7103609774652337, 0.26536097746523374, -0.28578838324886474, -0.12047749411640937, -0.3904774941164093, 0.15588457268119893, -0.8326279441628824, -1.0726279441628823, 0.24537386440559097, 0.03518148554092265, 0.9751814855409224, 0.7736493607140985, 0.422476219735897, 1.5924762197358966, 0.21073284825421343, 0.05903411844343545, 0.4490341184434353], 1.0e-12) && common::all_close(i4i, [0.18475208614068028, -1.8623725900250783, -0.1323725900250784, 1.0709847493467557, -0.19548294077828232, 0.4495170592217177, -0.017320508075688773, 0.26306079660838644, 0.4730607966083864, -0.08371578903249571, 0.13261106998930267, 0.1676110699893027, 0.3550704155516198, 1.2029165124598848, -0.07708348754011485, 0.39259818304894545, -0.5714656965084267, -0.27146569650842667, 0.5282754963085076, -0.6199742261192855, -0.3499742261192855, -0.37527767497325665, -0.7380275824491876, -0.6880275824491876], 1.0e-12));
    // Faults.
    let e1, e2, ef1 = scientific::fftn_ex(xr3, xi3, [], [1000], "other");
    assert(ef1.kind == scientific::F_VALUE);
    let e3, e4, ef2 = scientific::fftn_ex(xr3, xi3, [3, 4], [0], "backward");
    assert(ef2.kind == scientific::F_SHAPE);
    let e5, e6, ef3 = scientific::ifftn_ex(xr3, xi3, [], [0, 0], "backward");
    assert(ef3.kind == scientific::F_VALUE);
    let e7, e8, ef4 = scientific::ifftn_ex(xr3, xi3, [], [9], "backward");
    assert(ef4.kind == scientific::F_RANGE);
    let e9, e10, ef5 = scientific::ifftn_ex(xr3, xi3, [0], [1], "backward");
    assert(ef5.kind == scientific::F_VALUE);
    return;
}
