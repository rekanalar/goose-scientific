    assert(icf.kind == scientific::F_NONE);
    let s3, f9 = scientific::bsr_from_coo(ic, 2, 2);
    assert(f9.kind == scientific::F_NONE);
    let s3p, s3i, s3d, s3f = scientific::bsr_blocks(s3);
    assert(s3f.kind == scientific::F_NONE && common::all_near(s3p, [0.0, 1.0, 3.0, 4.0]) && common::all_near(s3i, [0.0, 0.0, 1.0, 1.0]) && common::all_near(s3d, [0.806, 0.0, 0.0, 0.827, 0.0, 0.0, 0.0, 0.865, 0.736, 0.905, 0.0, 0.0, 0.0, 0.787, 0.888, 0.0]));
    assert(scientific::bsr_nnz(s3) == 16 && s3.br == 2 && s3.bc == 2);
