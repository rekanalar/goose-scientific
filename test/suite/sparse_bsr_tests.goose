fn test_sparse_bsr_pins15() {
    let a = common::mx(4, 8, [0.0, 0.0, 0.861, 0.693, 0.0, 0.843, 0.937, 0.99, 0.0, 0.858, 0.0, 0.0, 0.0, 0.98, 0.0, 0.0, 0.0, 0.7, 0.0, 0.974, 0.834, 0.0, 0.0, 0.0, 0.849, 0.922, 0.0, 0.825, 0.0, 0.0, 0.946, 0.0]);
