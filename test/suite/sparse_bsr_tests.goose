fn test_sparse_bsr_pins7() {
    let a = common::mx(4, 6, [0.0, 0.0, 0.0, 0.0, 0.881, 0.934, 0.0, 0.868, 0.0, 0.0, 0.0, 0.937, 0.0, 0.0, 0.835, 0.0, 0.0, 0.0, 0.929, 0.0, 0.768, 0.853, 0.895, 0.0]);
    let s, f0 = scientific::bsr_from_dense(a, 1, 3);
    assert(f0.kind == scientific::F_NONE);
    let sp, si, sd, sf = scientific::bsr_blocks(s);
    assert(sf.kind == scientific::F_NONE && common::all_near(sp, [0.0, 1.0, 3.0, 4.0, 6.0]) && common::all_near(si, [1.0, 0.0, 1.0, 0.0, 0.0, 1.0]) && common::all_near(sd, [0.0, 0.881, 0.934, 0.0, 0.868, 0.0, 0.0, 0.0, 0.937, 0.0, 0.0, 0.835, 0.929, 0.0, 0.768, 0.853, 0.895, 0.0]));
    assert(scientific::bsr_nnz(s) == 18 && s.br == 1 && s.bc == 3);
    let d, f1 = scientific::bsr_to_dense(s);
    assert(f1.kind == scientific::F_NONE && common::all_near(d, [0.0, 0.0, 0.0, 0.0, 0.881, 0.934, 0.0, 0.868, 0.0, 0.0, 0.0, 0.937, 0.0, 0.0, 0.835, 0.0, 0.0, 0.0, 0.929, 0.0, 0.768, 0.853, 0.895, 0.0]));
    assert(common_3::bsr_same(s, 4, 6, [0.0, 0.0, 0.0, 0.0, 0.881, 0.934, 0.0, 0.868, 0.0, 0.0, 0.0, 0.937, 0.0, 0.0, 0.835, 0.0, 0.0, 0.0, 0.929, 0.0, 0.768, 0.853, 0.895, 0.0]));
    let c, f2 = scientific::csr_from_dense(a);
    let s2, f3 = scientific::bsr_from_csr(c, 1, 3);
