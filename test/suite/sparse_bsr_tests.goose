    let scp, sci, scd, f8 = scientific::bsr_blocks(sc);
    assert(f8.kind == scientific::F_NONE && common::all_near(scd, [0.0, 2.2025, 2.335, 0.0, 2.17, 0.0, 0.0, 0.0, 2.3425000000000002, 0.0, 0.0, 2.0875, 2.3225000000000002, 0.0, 1.92, 2.1325, 2.2375, 0.0]));
    assert(common::near(scientific::bsr_sum(s), 7.9));
    let g0, gf0 = scientific::bsr_get(s, 0, 4);
