// The tests of the group hfftn_ex. Run them with SCIENTIFIC_SUITES=hfftn_ex.
namespace hfftn_ex_tests;

import scientific from "../..";
import os;
import common;

fn test_hfftn_ex() {
    let xr0 = common::av([-0.802, -1.324, -0.248, 0.42, 1.136, 0.11, -0.553, -0.785, 0.749, 1.635, 0.273, -1.233, -0.958, 1.6, 0.203, -1.732, -0.084, -1.163, -0.629, -0.488, -0.713, 0.553, -0.063, -0.589]);
    let xi0 = common::av([0.41, 0.83, -1.643, -0.257, -0.981, -0.173, -1.289, 0.021, -0.038, -0.304, -1.048, -0.396, -1.091, -1.355, 0.225, -1.109, 1.17, 0.717, -1.998, 0.272, -1.102, 0.033, 0.044, -1.988]);
    let ya0 = common::av([-0.233, -0.256, 0.962, -1.181, 0.738, -1.099, -0.331, -0.84, 1.449, 0.568, 2.432, 0.642, 0.845, 0.841, -0.607, -0.07, 1.35, -0.397, 0.189, -0.021, 0.609, -0.365, -0.152, 0.242]);
    let xr, g1 = scientific::reshape(xr0, [2, 3, 4]);
    let xi, g2 = scientific::reshape(xi0, [2, 3, 4]);
    let ya, g3 = scientific::reshape(ya0, [2, 3, 4]);
    assert(g1.kind == scientific::F_NONE && g2.kind == scientific::F_NONE && g3.kind == scientific::F_NONE);
    let h0, hf0 = scientific::hfftn_ex(xr, xi, [], [1000], "forward");
    assert(hf0.kind == scientific::F_NONE && h0.ndim == 3 && h0.shape[0] == 2 && h0.shape[1] == 3 && h0.shape[2] == 6);
    assert(common::all_close(h0, [-0.11919444444444445, -0.11560430177550213, 0.11052225713620453, -0.031138888888888876, -0.4145778126917601, 0.45799319066439104, -0.023412578276406946, 0.14742666138673094, 0.08028623579452349, -0.21132765683749458, 0.05985948977858856, -0.24500752490768832, -0.07489297727914859, -0.32285358620342275, -0.3371650453341441, 0.1516332123930501, -0.04942512468341236, 0.056878894168824606, 0.0786944444444444, -0.03173726928295996, 0.28375419559690357, 0.07463888888888891, -0.025031973374681327, 0.09268171372740439, -0.2860626967915481, -0.23422082356690388, 0.21692419910016822, 0.16584890963958018, -0.1760995433370943, -0.3479353239053638, -0.16279841431956307, -0.060703564983525075, 0.5579050988926499, 0.00534553480486424, 0.08971468978872076, -0.16291806532198505], 1.0e-12));
    let h1, hf1 = scientific::hfftn_ex(xr, xi, [3, 6], [0, 2], "ortho");
    assert(hf1.kind == scientific::F_NONE && h1.ndim == 3 && h1.shape[0] == 3 && h1.shape[1] == 3 && h1.shape[2] == 6);
    assert(common::all_close(h1, [-0.6151828996322963, -0.8231606154415162, -0.4139588427021592, -0.2569154638311123, -1.1430902894706185, 0.7632922413010553, -1.1056793035153647, -0.5414117137317801, 2.038703553203628, 0.48719657223753116, -1.0892948483304903, 1.698238407752972, 0.7094638037905028, 0.3836373005357736, -0.6869322605848267, -0.4945033423097922, -1.2854242544048498, 1.424670441218624, -1.8494314931501497, -1.8550428521752156, 1.429778067575805, 1.105968918714379, -0.2466221026737578, -0.3776381736257941, 0.13506954513051764, 1.6600675298377732, 0.6894048118091096, -0.9583246449068814, 0.508993714949539, 1.0636841191836066, 0.22399950516058595, 0.16790382050254238, -0.9108785444040101, 0.17025977920528074, -1.0872649545984274, 1.6497246390639537, -0.0286441176813207, 0.05755450400868356, 2.8544319116897454, -0.19144414837977744, -0.7976246051950314, -1.0148678704005853, 0.5923076304500441, -1.082068895494457, -0.7998503042776056, 0.8918566074753458, -0.2250713588299433, 0.8558183976239631, 1.4226164859624877, 0.1571688891280707, 0.8176215687059573, -0.20042966853590682, -0.2299203959102867, 0.9460250621266654], 1.0e-12));
    let h2, hf2 = scientific::hfftn_ex(xr, xi, [5], [1], "backward");
    assert(hf2.kind == scientific::F_NONE && h2.ndim == 3 && h2.shape[0] == 2 && h2.shape[1] == 5 && h2.shape[2] == 4);
    assert(common::all_close(h2, [2.968, 2.166, -0.808, -3.6160000000000005, -3.22246541049911, -4.587940820875537, -4.715317662521342, 1.504297680828711, -3.2581335234056095, -0.11662950254215276, 1.2936001524520595, 1.7060445145420924, -1.0962247838868082, -0.8663668317706682, 0.3373919969627671, 0.15019703153800157, 0.5988237177915285, -3.2150628448116434, 2.6523255131065158, 2.3554607730911954, -2.5519999999999996, 0.3800000000000001, -1.181, -3.886, 1.073736931001732, 1.3890625463237338, -3.8325039745461367, -2.9002379853865703, 2.2088026733552217, 4.603660646406746, -1.2506756039622555, 2.794734453172896, -4.73428943120259, 3.043432002982894, 3.6142900792271364, -5.407577318900374, -0.7862501731543645, -1.416155195713373, 3.6648894992812555, 0.7390808511140488], 1.0e-12));
    let h3, hf3 = scientific::hfftn_ex(xr, xi, [], [2, 0], "forward");
    assert(hf3.kind == scientific::F_NONE && h3.ndim == 3 && h3.shape[0] == 2 && h3.shape[1] == 3 && h3.shape[2] == 4);
    assert(common::all_close(h3, [-0.355125, -0.10925000000000001, -0.09612499999999999, -0.3195, -0.307, 0.31062500000000004, 0.2745, 0.247875, 0.0765, 0.242375, -0.015, -0.285875, -0.13337500000000005, 0.2425, 0.05962500000000001, -0.09075, 0.284, 0.06312500000000001, 0.039999999999999994, 0.222875, 0.27949999999999997, -0.10037499999999999, 0.17000000000000004, 0.38187499999999996], 1.0e-12));
    let pr0, pi0, pf0 = scientific::ihfftn_ex(ya, [], [1000], "forward");
    assert(pf0.kind == scientific::F_NONE && pr0.shape[0] == 2 && pr0.shape[1] == 3 && pr0.shape[2] == 3);
    assert(common::all_close(pr0, [5.3149999999999995, 2.2649999999999997, 9.187000000000001, -2.206, -0.7868371685740844, -2.1440000000000006, -2.206, -0.7071628314259158, -2.1440000000000006, 0.38700000000000045, -4.4830000000000005, 5.179, -2.769, -1.3687334320256739, 1.4589999999999999, -2.769, -2.0892665679743265, 1.4589999999999999], 1.0e-12) && common::all_close(pi0, [0.0, 0.52, 0.0, -5.054124256485984, 4.617494290079444, 0.9110587247812298, 5.054124256485984, 0.37050570992055665, -0.9110587247812298, 0.0, 0.6639999999999999, 0.0, -6.41724824204269, 1.1196739670518923, -1.4739752372411148, 6.41724824204269, -1.7416739670518921, 1.4739752372411148], 1.0e-12));
    let pr1, pi1, pf1 = scientific::ihfftn_ex(ya, [3, 6], [0, 2], "ortho");
    assert(pf1.kind == scientific::F_NONE && pr1.shape[0] == 3 && pr1.shape[1] == 3 && pr1.shape[2] == 4);
    assert(common::all_close(pr1, [0.07094638037905021, 0.4662190710623303, -0.2613938067786271, 0.3849017912258774, -0.09687362902255703, 0.535515535618612, 0.4822468247692254, 1.0142268264819048, 1.2786847626456734, 0.031937656283592415, 0.40081169380257464, 0.766268048545822, -0.285788990729563, -0.15462068281945834, -0.7500045925785312, 0.5733457484120923, -0.49320697987761686, 0.19115453318076336, 0.07919595949289333, 0.32232284109086784, 1.16059793018752, 0.031230549502405856, 0.046197643037521115, 0.5612070820017232, -0.285788990729563, -0.07188918942063231, -0.23805928299947104, 0.5733457484120923, -0.49320697987761686, 0.1176154279373624, -0.12798632739476506, 0.32232284109086784, 1.16059793018752, -0.15155655343431662, -0.02910922915884618, 0.5612070820017232], 1.0e-12) && common::all_close(pi1, [0.0, 0.1918766965180156, 0.046948553403344195, 0.0, 0.0, -0.3343553498899038, -0.2763840926440353, 0.0, 0.0, 0.506840252610886, -0.42396584964672174, 0.0, 0.20596126253901884, 0.4547885955767433, -0.2620954024778, -0.10879816940861946, 0.22882316680499518, -0.050622788017519016, 0.19555093113219035, 0.39947095221889, 0.0681774645074651, 0.718312867071167, -0.13227244611029168, 0.11839200423452026, -0.20596126253901884, -0.214330352493528, -0.5307227776030219, 0.10879816940861946, -0.22882316680499518, -0.4907144451375633, -0.3894688691025253, -0.39947095221889, -0.0681774645074651, 0.6119641874053307, -0.5852239243799476, -0.11839200423452026], 1.0e-12));
    let pr2, pi2, pf2 = scientific::ihfftn_ex(ya, [5], [1], "backward");
    assert(pf2.kind == scientific::F_NONE && pr2.shape[0] == 2 && pr2.shape[1] == 3 && pr2.shape[2] == 4);
    assert(common::all_close(pr2, [0.39080000000000004, -0.1574, 0.6126, -0.2758, -0.23544221660011755, -0.2110262659246075, -0.22156279109159602, -0.39199263713273447, -0.07645778339988246, 0.16172626592460748, 0.39626279109159596, -0.06060736286726559, 0.5608000000000001, 0.01579999999999999, -0.11399999999999999, 0.030199999999999994, 0.1538963185663672, 0.20272229123600033, -0.0851250409836286, -0.054454293904122236, -0.011796318566367254, 0.2098777087639997, -0.16137495901637144, 0.004354293904122235], 1.0e-12) && common::all_close(pi2, [0.0, 0.0, 0.0, 0.0, 0.3107161079195234, -0.1422698176212498, 0.22293880533631977, -0.08430586834323223, -0.1888590751839665, -0.237235218705015, -0.5015052732277244, -0.2208635790774332, 0.0, 0.0, 0.0, 0.0, 0.32837750312891467, -0.11842221081118574, 0.01808126464626562, 0.024454368842516058, 0.04286333443421806, 0.022756976657523843, 0.05113040063202815, -0.04849983344831382], 1.0e-12));
    let pr3, pi3, pf3 = scientific::ihfftn_ex(ya, [], [2, 0], "ortho");
    assert(pf3.kind == scientific::F_NONE && pr3.shape[0] == 2 && pr3.shape[1] == 3 && pr3.shape[2] == 4);
    assert(common::all_close(pr3, [0.10641957056857532, 0.09086322138247135, 0.5773526868388161, 0.09086322138247135, -0.1453104435338355, 0.7884240610230006, 1.521340239722857, 0.7884240610230006, 1.9180271439685102, -0.0784888527117068, 1.1494020728187329, -0.0784888527117068, -0.6070511716486512, -0.9358558249003958, 0.954240601211246, -0.9358558249003958, -0.9379771452439554, -0.03252691193458121, 0.1375322689407834, -0.03252691193458121, 1.6818534790522035, -0.6165971131946695, 0.7392801397305355, -0.6165971131946695], 1.0e-12) && common::all_close(pi3, [0.0, 0.6491240251292507, 0.0, -0.6491240251292507, 0.0, -0.22450640302672886, 0.0, 0.22450640302672886, 0.0, -0.24076985899401943, 0.0, 0.24076985899401943, 0.0, 0.004949747468305843, 0.0, -0.004949747468305843, 0.0, 0.041365746699413036, 0.0, -0.041365746699413036, 0.0, 0.1884439571862149, 0.0, -0.1884439571862149], 1.0e-12));
    // A size of -1 keeps the size of the input, also on the half axis.
    let h4, hf4 = scientific::hfftn_ex(xr, xi, [-1], [1], "backward");
    assert(hf4.kind == scientific::F_NONE && h4.ndim == 3 && h4.shape[0] == 2 && h4.shape[1] == 3 && h4.shape[2] == 4);
    assert(common::all_close(h4, [1.4699999999999998, -1.104, -1.354, -1.1500000000000001, -3.6371418422250685, -1.7336447897094158, -1.9276134909562823, 1.2413730669589464, -0.23885815777493136, -1.1343552102905845, 2.5376134909562826, 1.1686269330410537, -1.126, -0.726, -1.055, -2.708, 1.1524994448555859, 4.004880429026885, -2.6286375135226168, -0.7728821803412653, -2.900499444855586, 1.521119570973115, 4.2926375135226165, -1.7151178196587347], 1.0e-12));
    let pr4, pi4, pf4 = scientific::ihfftn_ex(ya, [-1], [1], "backward");
    assert(pf4.kind == scientific::F_NONE && pr4.shape[0] == 2 && pr4.shape[1] == 2 && pr4.shape[2] == 4);
    assert(common::all_close(pr4, [0.6513333333333333, -0.2623333333333333, 1.021, -0.45966666666666667, -0.4421666666666667, 0.003166666666666669, -0.029500000000000005, -0.3606666666666667, 0.9346666666666668, 0.02633333333333332, -0.18999999999999997, 0.05033333333333333, -0.04483333333333335, 0.4073333333333333, -0.20849999999999996, -0.06016666666666666], 1.0e-12) && common::all_close(pi4, [0.0, 0.0, 0.0, 0.0, -0.20524802069691198, -0.481221449369553, -0.7976093968854678, -0.42781654946951264, 0.0, 0.0, 0.0, 0.0, 0.21390827473475638, -0.00923760430703402, 0.09843822089683119, -0.07592156039843578], 1.0e-12));
    // Faults.
    let e1, ef1 = scientific::hfftn_ex(xr, xi, [], [1000], "other");
    assert(ef1.kind == scientific::F_VALUE);
    let e2, ef2 = scientific::hfftn_ex(xr, xi, [3, 4], [0], "backward");
    assert(ef2.kind == scientific::F_SHAPE);
    let e3, ef3 = scientific::hfftn_ex(xr, xi, [], [0, 0], "backward");
    assert(ef3.kind == scientific::F_VALUE);
    let e4, ef4 = scientific::hfftn_ex(xr, xi, [], [5], "backward");
    assert(ef4.kind == scientific::F_RANGE);
    let e5, ef5 = scientific::hfftn_ex(xr, xi, [0], [1], "backward");
    assert(ef5.kind == scientific::F_VALUE);
    let e6, e7, ef6 = scientific::ihfftn_ex(ya, [], [1000], "other");
    assert(ef6.kind == scientific::F_VALUE);
}
