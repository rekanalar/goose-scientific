    let v363, c363, w363, g363 = scientific::value_indices(common_3::ni_nd([5, 1], [2.0, -2.0, 2.0, 3.0, -2.0]), -1.0, true);
    assert(g363.kind == scientific::F_NONE);
    assert(v363.shape == [3] && common_3::ms_same(v363, [-2.0, 2.0, 3.0]));
    assert(c363.shape == [3] && common_3::ms_same(c363, [2.0, 2.0, 1.0]));
    assert(w363.shape == [5, 2] && common_3::ms_same(w363, [1.0, 0.0, 4.0, 0.0, 0.0, 0.0, 2.0, 0.0, 3.0, 0.0]));
    let v364, c364, w364, g364 = scientific::value_indices(common_3::ni_nd([3], [3.0, 2.0, -2.0]));
