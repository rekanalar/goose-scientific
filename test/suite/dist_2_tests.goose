    assert(v390.shape == [1] && common_3::ms_same(v390, [1.0]));
    assert(c390.shape == [1] && common_3::ms_same(c390, [2.0]));
    assert(w390.shape == [2, 1] && common_3::ms_same(w390, [0.0, 1.0]));
    let v391, c391, w391, g391 = scientific::value_indices(common_3::ni_nd([2], [1.0, 1.0]), 3.0, true);
    assert(g391.kind == scientific::F_NONE);
    assert(v391.shape == [1] && common_3::ms_same(v391, [1.0]));
    assert(c391.shape == [1] && common_3::ms_same(c391, [2.0]));
    assert(w391.shape == [2, 1] && common_3::ms_same(w391, [0.0, 1.0]));
}

