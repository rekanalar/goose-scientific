    assert(v364.shape == [3] && common_3::ms_same(v364, [-2.0, 2.0, 3.0]));
    assert(c364.shape == [3] && common_3::ms_same(c364, [1.0, 1.0, 1.0]));
    assert(w364.shape == [3, 1] && common_3::ms_same(w364, [2.0, 1.0, 0.0]));
    let v365, c365, w365, g365 = scientific::value_indices(common_3::ni_nd([3], [3.0, 2.0, -2.0]), 1.0, true);
    assert(g365.kind == scientific::F_NONE);
    assert(v365.shape == [3] && common_3::ms_same(v365, [-2.0, 2.0, 3.0]));
    assert(c365.shape == [3] && common_3::ms_same(c365, [1.0, 1.0, 1.0]));
    assert(w365.shape == [3, 1] && common_3::ms_same(w365, [2.0, 1.0, 0.0]));
    let v366, c366, w366, g366 = scientific::value_indices(common_3::ni_nd([5], [-2.0, -1.0, -2.0, -2.0, 2.0]));
    assert(g366.kind == scientific::F_NONE);
    assert(v366.shape == [3] && common_3::ms_same(v366, [-2.0, -1.0, 2.0]));
    assert(c366.shape == [3] && common_3::ms_same(c366, [3.0, 1.0, 1.0]));
    assert(w366.shape == [5, 1] && common_3::ms_same(w366, [0.0, 2.0, 3.0, 1.0, 4.0]));
    let v367, c367, w367, g367 = scientific::value_indices(common_3::ni_nd([5], [-2.0, -1.0, -2.0, -2.0, 2.0]), -1.0, true);
    assert(g367.kind == scientific::F_NONE);
    assert(v367.shape == [2] && common_3::ms_same(v367, [-2.0, 2.0]));
    assert(c367.shape == [2] && common_3::ms_same(c367, [3.0, 1.0]));
    assert(w367.shape == [4, 1] && common_3::ms_same(w367, [0.0, 2.0, 3.0, 4.0]));
}

fn test_dist_pins21() {
    let v368, c368, w368, g368 = scientific::value_indices(common_3::ni_nd([3, 3], [-2.0, 1.0, 1.0, 1.0, -1.0, 0.0, -2.0, 0.0, -2.0]));
    assert(g368.kind == scientific::F_NONE);
    assert(v368.shape == [4] && common_3::ms_same(v368, [-2.0, -1.0, 0.0, 1.0]));
    assert(c368.shape == [4] && common_3::ms_same(c368, [3.0, 1.0, 2.0, 3.0]));
    assert(w368.shape == [9, 2] && common_3::ms_same(w368, [0.0, 0.0, 2.0, 0.0, 2.0, 2.0, 1.0, 1.0, 1.0, 2.0, 2.0, 1.0, 0.0, 1.0, 0.0, 2.0, 1.0, 0.0]));
    let v369, c369, w369, g369 = scientific::value_indices(common_3::ni_nd([3, 3], [-2.0, 1.0, 1.0, 1.0, -1.0, 0.0, -2.0, 0.0, -2.0]), -2.0, true);
