// The helpers that the tests of more than one group share.
namespace common_10;

import scientific from "../..";
import os;
import common;
import common_7;

fn lil_pin_r34() {
    var d, f0 = scientific::lil_new(6, 4);
    assert(f0.kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, -4, [2.0, 2.0]).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 4.0, 1.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 3.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 3.0, 2.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 1.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 1.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 3.0, 2.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 1.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 6, 3).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 2, 4).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 3.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 3, 2).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 3, 1).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 6, 2).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 1.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 1.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 3, 2).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 1, 1).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 4, 4).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 3.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 3.0, 1.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 1, 2).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 1, 1).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 2, 2).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 1.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 1.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 1.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 1.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 3, 1).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 2.0).kind == scientific::F_NONE);
    assert(common_7::lil_is(d, [0.0], [0.0], [2.0]));
    assert(scientific::lil_nnz(d) == 1);
    let dn, fd = scientific::lil_to_dense(d);
    assert(fd.kind == scientific::F_NONE && common::all_near(dn, [2.0, 0.0, 0.0]));
    let t, ft = scientific::lil_transpose(d);
    assert(ft.kind == scientific::F_NONE && common_7::lil_is(t, [0.0], [0.0], [2.0]));
    let co, fc = scientific::lil_to_coo(d);
    assert(fc.kind == scientific::F_NONE && co.nnz == 1);
    let cs, fs = scientific::lil_to_csr(d);
    assert(fs.kind == scientific::F_NONE && cs.nnz == 1);
    let mv, fm = scientific::lil_matvec(d, [-2.0]);
    assert(fm.kind == scientific::F_NONE && common::all_near(mv, [-4.0, 0.0, 0.0]));
    let sm, fz = scientific::lil_sum(d);
    assert(fz.kind == scientific::F_NONE && common::near(sm, 2.0));
    let dg, fg = scientific::lil_diagonal(d);
    assert(fg.kind == scientific::F_NONE && common::all_near(dg, [2.0]));
    let sd, fk = scientific::lil_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && common_7::lil_is(sd, [0.0], [0.0], [-3.0]));
}

fn lil_pin_r35() {
    var d, f0 = scientific::lil_new(3, 3);
    assert(f0.kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, -2, [2.0]).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 1.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 1.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 1.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, 2, [0.0]).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 6, 4).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 3.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 4, 2).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 2, 2).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 0.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 1.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, -1, [0.0]).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, 0, [2.0, 0.0, 2.0]).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 1.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 1.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 1.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 4, 1).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, -1, [1.0]).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 0.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 3.0, 0.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 0.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 3, 2).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 0.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 1, 3).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 2.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, -3.0).kind == scientific::F_NONE);
    assert(common_7::lil_is(d, [0.0], [0.0], [-3.0]));
    assert(scientific::lil_nnz(d) == 1);
    let dn, fd = scientific::lil_to_dense(d);
    assert(fd.kind == scientific::F_NONE && common::all_near(dn, [-3.0, 0.0, 0.0]));
    let t, ft = scientific::lil_transpose(d);
    assert(ft.kind == scientific::F_NONE && common_7::lil_is(t, [0.0], [0.0], [-3.0]));
    let co, fc = scientific::lil_to_coo(d);
    assert(fc.kind == scientific::F_NONE && co.nnz == 1);
    let cs, fs = scientific::lil_to_csr(d);
    assert(fs.kind == scientific::F_NONE && cs.nnz == 1);
    let mv, fm = scientific::lil_matvec(d, [-2.0, 1.0, 4.0]);
    assert(fm.kind == scientific::F_NONE && common::all_near(mv, [6.0]));
    let sm, fz = scientific::lil_sum(d);
    assert(fz.kind == scientific::F_NONE && common::near(sm, -3.0));
    let dg, fg = scientific::lil_diagonal(d);
    assert(fg.kind == scientific::F_NONE && common::all_near(dg, [-3.0]));
    let sd, fk = scientific::lil_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && common_7::lil_is(sd, [0.0], [0.0], [4.5]));
}

fn lil_pin_r36() {
    var d, f0 = scientific::lil_new(4, 3);
    assert(f0.kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 3.0, 1.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 1.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 2.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, 2, [4.0, 2.0]).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 1.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, -2, [1.0, 2.0]).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 3.0, 1.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 1.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 0.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 3.0, 0.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 3.0, 0.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, -2, [2.0]).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 1.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, -1, [1.0, 4.0, 4.0, 2.0]).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, 0, [0.0, 4.0]).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, 1, [2.0, 0.0]).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 3, 4).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 3.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, 0, [0.0, 4.0]).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, -1, [0.0, 2.0]).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, -2, [0.0]).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 1.0, 2.0).kind == scientific::F_NONE);
    assert(common_7::lil_is(d, [0.0, 0.0, 1.0, 2.0, 2.0], [1.0, 2.0, 1.0, 1.0, 3.0], [2.0, 4.0, 4.0, 2.0, 7.0]));
    assert(scientific::lil_nnz(d) == 5);
    let dn, fd = scientific::lil_to_dense(d);
    assert(fd.kind == scientific::F_NONE && common::all_near(dn, [0.0, 2.0, 4.0, 0.0, 0.0, 4.0, 0.0, 0.0, 0.0, 2.0, 0.0, 7.0]));
    let t, ft = scientific::lil_transpose(d);
    assert(ft.kind == scientific::F_NONE && common_7::lil_is(t, [1.0, 1.0, 1.0, 2.0, 3.0], [0.0, 1.0, 2.0, 0.0, 2.0], [2.0, 4.0, 2.0, 4.0, 7.0]));
    let co, fc = scientific::lil_to_coo(d);
    assert(fc.kind == scientific::F_NONE && co.nnz == 5);
    let cs, fs = scientific::lil_to_csr(d);
    assert(fs.kind == scientific::F_NONE && cs.nnz == 5);
    let mv, fm = scientific::lil_matvec(d, [-2.0, 1.0, 4.0, 0.0]);
    assert(fm.kind == scientific::F_NONE && common::all_near(mv, [18.0, 4.0, 2.0]));
    let sm, fz = scientific::lil_sum(d);
    assert(fz.kind == scientific::F_NONE && common::near(sm, 19.0));
    let dg, fg = scientific::lil_diagonal(d);
    assert(fg.kind == scientific::F_NONE && common::all_near(dg, [0.0, 4.0, 0.0]));
    let sd, fk = scientific::lil_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && common_7::lil_is(sd, [0.0, 0.0, 1.0, 2.0, 2.0], [1.0, 2.0, 1.0, 1.0, 3.0], [-3.0, -6.0, -6.0, -3.0, -10.5]));
}

fn lil_pin_r37() {
    var d, f0 = scientific::lil_new(2, 3);
    assert(f0.kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 2, 3).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 1.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 4, 5).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 1.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 3.0, 1.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 3.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 1, 4).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 6, 3).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 5.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 4.0, 0.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 2, 4).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 2.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 1.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 5, 4).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 3, 1).kind == scientific::F_NONE);
    assert(common_7::lil_is(d, [1.0], [0.0], [7.0]));
    assert(scientific::lil_nnz(d) == 1);
    let dn, fd = scientific::lil_to_dense(d);
    assert(fd.kind == scientific::F_NONE && common::all_near(dn, [0.0, 7.0, 0.0]));
    let t, ft = scientific::lil_transpose(d);
    assert(ft.kind == scientific::F_NONE && common_7::lil_is(t, [0.0], [1.0], [7.0]));
    let co, fc = scientific::lil_to_coo(d);
    assert(fc.kind == scientific::F_NONE && co.nnz == 1);
    let cs, fs = scientific::lil_to_csr(d);
    assert(fs.kind == scientific::F_NONE && cs.nnz == 1);
    let mv, fm = scientific::lil_matvec(d, [-2.0]);
    assert(fm.kind == scientific::F_NONE && common::all_near(mv, [0.0, -14.0, 0.0]));
    let sm, fz = scientific::lil_sum(d);
    assert(fz.kind == scientific::F_NONE && common::near(sm, 7.0));
    let dg, fg = scientific::lil_diagonal(d);
    assert(fg.kind == scientific::F_NONE && common::all_near(dg, [0.0]));
    let sd, fk = scientific::lil_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && common_7::lil_is(sd, [1.0], [0.0], [-10.5]));
}

fn lil_pin_r38() {
    var d, f0 = scientific::lil_new(6, 1);
    assert(f0.kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, 0, [0.0, 0.0]).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 3.0, 0.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 5.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 0.0, 5.0).kind == scientific::F_NONE);
    assert(common_7::lil_is(d, [2.0, 3.0], [0.0, 0.0], [5.0, -3.0]));
    assert(scientific::lil_nnz(d) == 2);
    let dn, fd = scientific::lil_to_dense(d);
    assert(fd.kind == scientific::F_NONE && common::all_near(dn, [0.0, 0.0, 5.0, -3.0, 0.0, 0.0]));
    let t, ft = scientific::lil_transpose(d);
    assert(ft.kind == scientific::F_NONE && common_7::lil_is(t, [0.0, 0.0], [2.0, 3.0], [5.0, -3.0]));
    let co, fc = scientific::lil_to_coo(d);
    assert(fc.kind == scientific::F_NONE && co.nnz == 2);
    let cs, fs = scientific::lil_to_csr(d);
    assert(fs.kind == scientific::F_NONE && cs.nnz == 2);
    let mv, fm = scientific::lil_matvec(d, [-2.0]);
    assert(fm.kind == scientific::F_NONE && common::all_near(mv, [0.0, 0.0, -10.0, 6.0, 0.0, 0.0]));
    let sm, fz = scientific::lil_sum(d);
    assert(fz.kind == scientific::F_NONE && common::near(sm, 2.0));
    let dg, fg = scientific::lil_diagonal(d);
    assert(fg.kind == scientific::F_NONE && common::all_near(dg, [0.0]));
    let sd, fk = scientific::lil_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && common_7::lil_is(sd, [2.0, 3.0], [0.0, 0.0], [-7.5, 4.5]));
}

fn lil_pin_r39() {
    var d, f0 = scientific::lil_new(4, 1);
    assert(f0.kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 0.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::lil_setdiag(d, -1, [1.0, 2.0]).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 0.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 3.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 0.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 0.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_resize(d, 6, 2).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 3.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 4.0, 0.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 2.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 0.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 3.0, 1.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::lil_set(d, 1.0, 0.0, -3.0).kind == scientific::F_NONE);
    assert(common_7::lil_is(d, [1.0, 2.0, 3.0, 4.0], [0.0, 0.0, 1.0, 0.0], [-3.0, 7.0, 5.0, 1.0]));
    assert(scientific::lil_nnz(d) == 4);
    let dn, fd = scientific::lil_to_dense(d);
    assert(fd.kind == scientific::F_NONE && common::all_near(dn, [0.0, 0.0, -3.0, 0.0, 7.0, 0.0, 0.0, 5.0, 1.0, 0.0, 0.0, 0.0]));
    let t, ft = scientific::lil_transpose(d);
    assert(ft.kind == scientific::F_NONE && common_7::lil_is(t, [0.0, 0.0, 0.0, 1.0], [1.0, 2.0, 4.0, 3.0], [-3.0, 7.0, 1.0, 5.0]));
    let co, fc = scientific::lil_to_coo(d);
    assert(fc.kind == scientific::F_NONE && co.nnz == 4);
    let cs, fs = scientific::lil_to_csr(d);
    assert(fs.kind == scientific::F_NONE && cs.nnz == 4);
    let mv, fm = scientific::lil_matvec(d, [-2.0, 1.0]);
    assert(fm.kind == scientific::F_NONE && common::all_near(mv, [0.0, 6.0, -14.0, 5.0, -2.0, 0.0]));
    let sm, fz = scientific::lil_sum(d);
    assert(fz.kind == scientific::F_NONE && common::near(sm, 10.0));
