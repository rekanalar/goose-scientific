// The tests of the group dct. Run them with SCIENTIFIC_SUITES=dct.
namespace dct_tests;

import scientific from "../..";
import os;
import common;

// The cosine, sine and real transforms, pinned against SciPy.
fn test_transforms() {
    let r1, e1 = scientific::dct([1.0, 3.0, 2.0, 5.0, 4.0], 1);
    assert(e1.kind == scientific::F_NONE && common::all_near(r1, [25.0, -5.82842712474619, 1.0, -0.17157287525381015, -7.0]));
    let r2, e2 = scientific::dct([1.0, 3.0, 2.0, 5.0, 4.0], 1, "ortho");
    assert(e2.kind == scientific::F_NONE && common::all_near(r2, [6.76776695296637, -2.5000000000000004, 1.085786437626905, -0.5000000000000003, -1.2322330470336313]));
    let r3, e3 = scientific::dct([2.0, -1.0, 4.0, 0.5], 1, "forward");
    assert(e3.kind == scientific::F_NONE && common::all_near(r3, [1.4166666666666665, -0.5833333333333333, -0.08333333333333333, 1.9166666666666665]));
    let r4, e4 = scientific::idct([2.0, -1.0, 4.0, 0.5], 1);
    assert(e4.kind == scientific::F_NONE && common::all_near(r4, [1.4166666666666665, -0.5833333333333333, -0.08333333333333333, 1.9166666666666665]));
    let r5, e5 = scientific::idct([2.0, -1.0, 4.0, 0.5], 1, "ortho");
    assert(e5.kind == scientific::F_NONE && common::all_near(r5, [2.752671533728535, -1.1752160485348764, 0.21863080158247541, 3.4991237816439233]));
    let r6, e6 = scientific::idct([2.0, -1.0, 4.0, 0.5], 1, "forward");
    assert(e6.kind == scientific::F_NONE && common::all_near(r6, [8.5, -3.5, -0.5, 11.5]));
    let r7, e7 = scientific::dst([1.0, 3.0, 2.0, 5.0, 4.0], 1);
    assert(e7.kind == scientific::F_NONE && common::all_near(r7, [22.856406460551018, -8.660254037844386, 6.0, -1.7320508075688785, -4.8564064605510175]));
    let r8, e8 = scientific::dst([1.0, 3.0, 2.0, 5.0, 4.0], 1, "ortho");
    assert(e8.kind == scientific::F_NONE && common::all_near(r8, [6.598076211353315, -2.4999999999999996, 1.7320508075688772, -0.5000000000000003, -1.4019237886466838]));
    let r9, e9 = scientific::dst([2.0, -1.0, 4.0, 0.5], 1, "forward");
    assert(e9.kind == scientific::F_NONE && common::all_near(r9, [0.8645265359233287, -0.3024682974039271, 0.12285710677209292, 1.1273920919828955]));
    let r10, e10 = scientific::idst([2.0, -1.0, 4.0, 0.5], 1);
    assert(e10.kind == scientific::F_NONE && common::all_near(r10, [0.8645265359233287, -0.3024682974039271, 0.12285710677209292, 1.1273920919828955]));
    let r11, e11 = scientific::idst([2.0, -1.0, 4.0, 0.5], 1, "ortho");
    assert(e11.kind == scientific::F_NONE && common::all_near(r11, [2.7338729511730984, -0.956488739789604, 0.38850828413831073, 3.565126826728005]));
    let r12, e12 = scientific::dct([1.0, 3.0, 2.0, 5.0, 4.0], 2);
    assert(e12.kind == scientific::F_NONE && common::all_near(r12, [30.0, -8.057480106940814, -0.8541019662496844, 0.27751455142577564, -5.854101966249684]));
    let r13, e13 = scientific::dct([1.0, 3.0, 2.0, 5.0, 4.0], 2, "ortho");
    assert(e13.kind == scientific::F_NONE && common::all_near(r13, [6.708203932499369, -2.5479989339430063, -0.27009075673772637, 0.08775780663453792, -1.8512295868219164]));
    let r14, e14 = scientific::dct([2.0, -1.0, 4.0, 0.5], 2, "forward");
    assert(e14.kind == scientific::F_NONE && common::all_near(r14, [1.375, -0.13189946576462963, -0.08838834764831843, 1.2983557027760169]));
    let r15, e15 = scientific::idct([2.0, -1.0, 4.0, 0.5], 2);
    assert(e15.kind == scientific::F_NONE && common::all_near(r15, [0.773972327104362, -0.6682625808417307, -0.2459509815313642, 1.140241235268733]));
    let r16, e16 = scientific::idct([2.0, -1.0, 4.0, 0.5], 2, "ortho");
    assert(e16.kind == scientific::F_NONE && common::all_near(r16, [2.482017542598361, -1.5972387912921924, -0.4027612087078072, 3.5179824574016387]));
    let r17, e17 = scientific::idct([2.0, -1.0, 4.0, 0.5], 2, "forward");
    assert(e17.kind == scientific::F_NONE && common::all_near(r17, [6.191778616834896, -5.346100646733846, -1.9676078522509135, 9.121929882149864]));
    let r18, e18 = scientific::dst([1.0, 3.0, 2.0, 5.0, 4.0], 2);
    assert(e18.kind == scientific::F_NONE && common::all_near(r18, [20.034441853748632, -7.330937578935451, 9.034441853748632, -3.3551980886010284, -2.0]));
    let r19, e19 = scientific::dst([1.0, 3.0, 2.0, 5.0, 4.0], 2, "ortho");
    assert(e19.kind == scientific::F_NONE && common::all_near(r19, [6.335446790805166, -2.318246013395644, 2.85694136461995, -1.0610067961022676, -0.447213595499958]));
    let r20, e20 = scientific::dst([2.0, -1.0, 4.0, 0.5], 2, "forward");
    assert(e20.kind == scientific::F_NONE && common::all_near(r20, [0.9320867946116462, -0.618718433538229, 0.29041213354573686, 1.625]));
    let r21, e21 = scientific::idst([2.0, -1.0, 4.0, 0.5], 2);
    assert(e21.kind == scientific::F_NONE && common::all_near(r21, [1.0009445533971948, -0.16002036140608322, 0.3185330291871905, 1.2294979439904683]));
    let r22, e22 = scientific::idst([2.0, -1.0, 4.0, 0.5], 2, "ortho");
    assert(e22.kind == scientific::F_NONE && common::all_near(r22, [2.90432202989895, -0.5258292354160173, 0.9741707645839827, 3.40432202989895]));
    let r23, e23 = scientific::dct([1.0, 3.0, 2.0, 5.0, 4.0], 3);
    assert(e23.kind == scientific::F_NONE && common::all_near(r23, [18.29239555319502, -12.692057581696067, 5.000000000000002, -0.7243502833026718, -4.8759876881962825]));
    let r24, e24 = scientific::dct([1.0, 3.0, 2.0, 5.0, 4.0], 3, "ortho");
    assert(e24.kind == scientific::F_NONE && common::all_near(r24, [5.915549210366321, -3.882595185733698, 1.7121246595673103, -0.09807384241934769, -1.4109368642807965]));
    let r25, e25 = scientific::dct([2.0, -1.0, 4.0, 0.5], 3, "forward");
    assert(e25.kind == scientific::F_NONE && common::all_near(r25, [0.773972327104362, -0.6682625808417307, -0.2459509815313642, 1.140241235268733]));
    let r26, e26 = scientific::idct([2.0, -1.0, 4.0, 0.5], 3);
    assert(e26.kind == scientific::F_NONE && common::all_near(r26, [1.375, -0.13189946576462963, -0.08838834764831843, 1.2983557027760169]));
    let r27, e27 = scientific::idct([2.0, -1.0, 4.0, 0.5], 3, "ortho");
    assert(e27.kind == scientific::F_NONE && common::all_near(r27, [2.7500000000000004, -0.37306802670821004, -0.25, 3.6723044873005897]));
    let r28, e28 = scientific::idct([2.0, -1.0, 4.0, 0.5], 3, "forward");
    assert(e28.kind == scientific::F_NONE && common::all_near(r28, [11.0, -1.055195726117037, -0.7071067811865475, 10.386845622208135]));
    let r29, e29 = scientific::dst([1.0, 3.0, 2.0, 5.0, 4.0], 3);
    assert(e29.kind == scientific::F_NONE && common::all_near(r29, [20.89137864295606, -1.3174114589041253, 2.0, -0.9743846085965062, -5.183174710456689]));
    let r30, e30 = scientific::dst([1.0, 3.0, 2.0, 5.0, 4.0], 3, "ortho");
    assert(e30.kind == scientific::F_NONE && common::all_near(r30, [7.130377315206354, -0.9405454005067148, 1.1563988499661557, -0.8320707859501444, -1.1151204416302094]));
    let r31, e31 = scientific::dst([2.0, -1.0, 4.0, 0.5], 3, "forward");
    assert(e31.kind == scientific::F_NONE && common::all_near(r31, [1.0009445533971948, -0.16002036140608322, 0.3185330291871905, 1.2294979439904683]));
    let r32, e32 = scientific::idst([2.0, -1.0, 4.0, 0.5], 3);
    assert(e32.kind == scientific::F_NONE && common::all_near(r32, [0.9320867946116462, -0.618718433538229, 0.29041213354573686, 1.625]));
    let r33, e33 = scientific::idst([2.0, -1.0, 4.0, 0.5], 3, "ortho");
    assert(e33.kind == scientific::F_NONE && common::all_near(r33, [2.6363395724973113, -1.7499999999999998, 0.8214095558761754, 3.250000000000001]));
    let r34, e34 = scientific::dct([1.0, 3.0, 2.0, 5.0, 4.0], 4);
    assert(e34.kind == scientific::F_NONE && common::all_near(r34, [15.941223668783987, -13.61661468999582, 7.0710678118654755, -7.753429462450177, -0.5912054607332058]));
    let r35, e35 = scientific::dct([1.0, 3.0, 2.0, 5.0, 4.0], 4, "ortho");
    assert(e35.kind == scientific::F_NONE && common::all_near(r35, [5.041057548354302, -4.305951644129437, 2.23606797749979, -2.4518496778797525, -0.18695558210461716]));
    let r36, e36 = scientific::dct([2.0, -1.0, 4.0, 0.5], 4, "forward");
    assert(e36.kind == scientific::F_NONE && common::all_near(r36, [0.8624817603975973, -0.5857241728753759, 0.8220054601645551, 0.9453091715151061]));
    let r37, e37 = scientific::idct([2.0, -1.0, 4.0, 0.5], 4);
    assert(e37.kind == scientific::F_NONE && common::all_near(r37, [0.8624817603975973, -0.5857241728753759, 0.8220054601645551, 0.9453091715151061]));
    let r38, e38 = scientific::idct([2.0, -1.0, 4.0, 0.5], 4, "ortho");
    assert(e38.kind == scientific::F_NONE && common::all_near(r38, [2.4394668057074087, -1.6566781381802402, 2.3249825402189024, 2.6737381019846747]));
    let r39, e39 = scientific::idct([2.0, -1.0, 4.0, 0.5], 4, "forward");
    assert(e39.kind == scientific::F_NONE && common::all_near(r39, [6.899854083180778, -4.685793383003007, 6.576043681316441, 7.562473372120849]));
    let r40, e40 = scientific::dst([1.0, 3.0, 2.0, 5.0, 4.0], 4);
    assert(e40.kind == scientific::F_NONE && common::all_near(r40, [22.676811019908712, 0.9701413238868586, 1.4142135623730951, 4.259938541424164, -3.830664616267361]));
    let r41, e41 = scientific::dst([1.0, 3.0, 2.0, 5.0, 4.0], 4, "ortho");
    assert(e41.kind == scientific::F_NONE && common::all_near(r41, [7.171037289211745, 0.30678562357335903, 0.447213595499958, 1.3471108483235905, -1.2113625139619755]));
    let r42, e42 = scientific::dst([2.0, -1.0, 4.0, 0.5], 4, "forward");
    assert(e42.kind == scientific::F_NONE && common::all_near(r42, [0.9127203751061128, 0.12374541688730373, -0.5443767756285396, 1.2294439860448376]));
    let r43, e43 = scientific::idst([2.0, -1.0, 4.0, 0.5], 4);
    assert(e43.kind == scientific::F_NONE && common::all_near(r43, [0.9127203751061128, 0.12374541688730373, -0.5443767756285396, 1.2294439860448376]));
    let r44, e44 = scientific::idst([2.0, -1.0, 4.0, 0.5], 4, "ortho");
    assert(e44.kind == scientific::F_NONE && common::all_near(r44, [2.581563066258647, 0.3500048936870751, -1.5397300382696322, 3.4773927184852957]));
    let h45, he45 = scientific::hfft([1.0, 2.0, 3.0], [0.0, 1.0, -2.0]);
    assert(he45.kind == scientific::F_NONE && common::all_near(h45, [8.0, 0.0, 0.0, -4.0]));
    let h46, he46 = scientific::hfft([1.0, 2.0, 3.0], [0.0, 1.0, -2.0], 5);
    assert(he46.kind == scientific::F_NONE && common::all_near(h46, [11.0, -3.06706196532948, 4.597830558515455, -5.3617625810156655, -2.1690060121703096]));
    let ia47, ib47, ie47 = scientific::ihfft([1.0, 3.0, 2.0, 5.0, 4.0]);
    assert(ie47.kind == scientific::F_NONE && common::all_near(ia47, [3.0, -0.5, -0.5]) && common::all_near(ib47, [0.0, -0.5428824546345146, 0.45307685931859754]));
    let ma = common::mx(3, 4, [0.0, 1.1, 2.4, 3.9, 5.6, 7.5, 9.6, 11.9, 14.4, 17.1, 20.0, 23.1]);
    let qa, qb, qe = scientific::rfft2(ma);
    assert(qe.kind == scientific::F_NONE && qa.shape[1] == 3 && common::all_near(qa, [116.6, -12.0, -12.600000000000003, -47.199999999999996, 1.0143593539448985, 2.4000000000000017, -47.199999999999996, 3.7856406460551013, 2.4000000000000017]) && common::all_near(qb, [0.0, 13.2, 0.0, 34.64101615137754, -3.7856406460551018, -1.385640646055106, -34.64101615137754, -1.014359353944899, 1.385640646055106]));
    let ba, be = scientific::irfft2(qa, qb, 4);
    assert(be.kind == scientific::F_NONE && common::all_near(ba, [0.0, 1.1, 2.4, 3.9, 5.6, 7.5, 9.6, 11.9, 14.4, 17.1, 20.0, 23.1]));
    let ca, ce = scientific::reshape(common::av([0.0, 1.0, 2.8284271247461903, 5.196152422706632, 8.0, 11.180339887498949, 14.696938456699069, 18.520259177452136, 22.627416997969522, 27.0, 31.622776601683793, 36.4828726939094, 41.569219381653056, 46.87216658103186, 52.38320341483518, 58.09475019311125, 64.0, 70.09279563550022, 76.36753236814714, 82.8190799272728, 89.44271909999159, 96.23408959407264, 103.18914671611545, 110.30412503619254]), [2, 3, 4]);
    assert(ce.kind == scientific::F_NONE);
    let ra, rb, re2 = scientific::rfftn(ca);
    assert(re2.kind == scientific::F_NONE && ra.shape[2] == 3 && common::all_near(ra, [1070.5240113105895, -55.44866920261264, -57.06925098690747, -223.34612697816848, 4.241143144896084, 6.961296580030753, -223.34612697816848, 10.280292583931617, 6.961296580030753, -712.213644585258, 18.407218832293587, 17.86112098597038, 71.26468225786121, 2.0825964921200417, 2.539592526556465, 71.26468225786121, 3.466855400894173, 2.539592526556465]) && common::all_near(rb, [0.0, 59.03784775254108, 0.0, 148.28624010836558, -9.575469239907518, -3.1099181009967474, -148.28624010836558, -3.2061704082754985, 3.1099181009967474, 0.0, -16.999958939402646, 0.0, -35.1217847360348, -2.8360001023628683, -0.7508551677725565, 35.1217847360348, -1.24333452635276, 0.7508551677725565]));
    let sa, se = scientific::irfftn(ra, rb, 4);
    assert(se.kind == scientific::F_NONE && common::all_near(sa, [0.0, 1.0, 2.8284271247461903, 5.196152422706632, 8.0, 11.180339887498949, 14.696938456699069, 18.520259177452136, 22.627416997969522, 27.0, 31.622776601683793, 36.4828726939094, 41.569219381653056, 46.87216658103186, 52.38320341483518, 58.09475019311125, 64.0, 70.09279563550022, 76.36753236814714, 82.8190799272728, 89.44271909999159, 96.23408959407264, 103.18914671611545, 110.30412503619254]));
    let nf1, nfe1 = scientific::next_fast_len(1);
    let nr1, nre1 = scientific::next_fast_len(1, true);
    assert(nfe1.kind == scientific::F_NONE && nre1.kind == scientific::F_NONE && nf1 == 1 && nr1 == 1);
    let nf13, nfe13 = scientific::next_fast_len(13);
    let nr13, nre13 = scientific::next_fast_len(13, true);
    assert(nfe13.kind == scientific::F_NONE && nre13.kind == scientific::F_NONE && nf13 == 14 && nr13 == 15);
    let nf127, nfe127 = scientific::next_fast_len(127);
    let nr127, nre127 = scientific::next_fast_len(127, true);
    assert(nfe127.kind == scientific::F_NONE && nre127.kind == scientific::F_NONE && nf127 == 128 && nr127 == 128);
    let nf1031, nfe1031 = scientific::next_fast_len(1031);
    let nr1031, nre1031 = scientific::next_fast_len(1031, true);
    assert(nfe1031.kind == scientific::F_NONE && nre1031.kind == scientific::F_NONE && nf1031 == 1050 && nr1031 == 1080);
    let nf100001, nfe100001 = scientific::next_fast_len(100001);
    let nr100001, nre100001 = scientific::next_fast_len(100001, true);
    assert(nfe100001.kind == scientific::F_NONE && nre100001.kind == scientific::F_NONE && nf100001 == 100352 && nr100001 == 101250);
    // bad input
    let bk, k1 = scientific::dct([1.0, 2.0], 5);
    assert(k1.kind == scientific::F_VALUE && bk.data.len == 0);
    let bn, k2 = scientific::dct([1.0, 2.0], 2, "nope");
    assert(k2.kind == scientific::F_VALUE && bn.data.len == 0);
    let b1, k3 = scientific::dct([1.0], 1);
    assert(k3.kind == scientific::F_SHAPE && b1.data.len == 0);
    let b0, k4 = scientific::next_fast_len(0);
    assert(k4.kind == scientific::F_RANGE);
}

// The cosine and sine transforms along many axes, pinned against SciPy.
fn test_dctn() {
    let x0 = common::av([1.0, 2.4622888266898326, 4.171167510947728, 6.062866266041593, 8.103282983463814, 10.270619156458231, 12.549529737646981, 14.92852786458892, 17.398638404385867, 19.952623149688797, 22.584500550247288, 25.289230792133658, 28.06249997748054, 30.90056685321995, 33.800150712639834, 36.75834735990512, 39.77256477258468, 42.840472942735936, 45.95996414826417, 49.129121044631624, 52.34619071934546, 55.60956336124427, 58.9177545493537, 62.26939041505117]);
    let x, xf = scientific::reshape(x0, [2, 3, 4]);
    assert(xf.kind == scientific::F_NONE);
    let r0, g0 = scientific::dctn(x, [0, 2]);
    assert(g0.kind == scientific::F_NONE && common::all_near(r0, [572.8715500276984, -57.89990479056862, 1.5543329934066363, -4.030270173898586, 894.2163306014975, -68.06365523843954, 0.885045055397859, -4.820137152500244, 1257.471567765801, -74.92385495323913, 0.6760187477795762, -5.316541228602198, -327.6032570503931, 10.78224715196562, 0.6185603137562878, 0.8208478562759156, -372.92857790109076, 7.524473343398311, 0.2208264554626511, 0.5433286805358346, -407.0613094872042, 6.043495630025117, 0.12496454556957676, 0.43278520149230637]));
    let r1, g1 = scientific::dctn(x, [0, 1, 2], 3, "ortho");
    assert(g1.kind == scientific::F_NONE && common::all_near(r1, [122.84341045578911, -38.2565476360308, 25.908638226000306, 1.3769744442855796, -58.528862482871645, 15.060355134850209, -11.90921190173123, -1.4272406237638187, 17.620371767234364, -5.463806689473594, 3.749543409305727, 0.2146714908807148, -73.98506732569552, 17.157327818265166, -14.838971498549116, -2.275988222671373, 17.25562393481787, -3.2084408492392753, 3.4561679976691457, 0.7541676869036333, -10.913313035669105, 2.757476220325989, -2.1802725221062556, -0.26802631295973445]));
    let r2, g2 = scientific::dstn(x, [1], 1);
    assert(g2.kind == scientific::F_NONE && common::all_near(r2, [42.2261699276086, 52.24071082931024, 62.937288117788604, 74.1956165976869, -32.797276808771734, -34.98066864599793, -36.82666607859912, -38.45272905218413, 9.813037993753348, 11.158234203477313, 12.739169167200679, 14.481505139331208, 193.26019046128403, 208.02474531742965, 223.04284739286334, 238.30461190173293, -48.56738148372983, -49.41799301604864, -50.23520767342774, -51.02208611029209, 34.16993137094529, 36.662853546485906, 39.20299079980667, 41.788127723206415]));
    let r3, g3 = scientific::dstn(x, [-1, 0], 4, "ortho");
    assert(g3.kind == scientific::F_NONE && common::all_near(r3, [59.67405338270412, 13.98516625077658, 11.025243204838889, 8.796922617710356, 85.81820710312842, 22.303437627337455, 16.726069965802818, 13.570940507386034, 114.4667659656682, 31.72803616027591, 23.146858248246943, 18.969747855527423, -16.315885128021467, -6.754749256257228, -4.115876624725164, -3.591731452681997, -10.777378516330712, -5.709364368823441, -3.310441464866356, -2.9672762697531154, -2.9757055340617526, -3.487695818561505, -1.7363024457421345, -1.6673003542772942]));
    let r4, g4 = scientific::idctn(x, [2, 1]);
    assert(g4.kind == scientific::F_NONE && common::all_near(r4, [4.564283502812174, -2.3142059457757935, 0.8081960802857989, -0.3554456173343866, -4.063193641890532, 1.6203939853856697, -0.6127933403239767, 0.23915326276452667, 0.5044698334815361, -0.19475575765153041, 0.08079976996579413, -0.026902131719281214, 17.309917061229775, -6.491954152635282, 2.5584297265551204, -0.9349931659607159, -8.56390431765439, 2.9778747795131775, -1.218955525877761, 0.4191616089181166, 1.3223344510769355, -0.48644757370716696, 0.19378629982824513, -0.0696241969159172]));
    let r5, g5 = scientific::idstn(x, [0, 1, 2], 3);
    assert(g5.kind == scientific::F_NONE && common::all_near(r5, [8.700905863107534, -0.8883483619171197, 3.6199801177941935, -0.6274213466537222, -2.8550118964446596, 0.09718761670483059, -1.176520371925791, 0.06949080920886774, 4.500730748908281, -0.42793404009117386, 1.8749892705395361, -0.30171584127455864, -7.1274225536214555, 0.21031110796336966, -2.9428261719513316, 0.149583979058181, 0.6598259841307222, 0.053959329750888484, 0.28012488550243686, 0.03918701518701173, -3.4842016501221584, 0.1225862522492332, -1.4348690767198933, 0.08782661229356736]));
    let r6, g6 = scientific::dctn(x);
    assert(g6.kind == scientific::F_NONE && common::all_near(r6, [5449.1188967899925, -401.77482996449453, 6.230793593167821, -28.333897110001942, -1185.762013584948, 29.486346627265767, 1.521284898437642, 2.2278868190518715, 41.91045659050428, 3.3035507330713036, 0.46026163039061474, 0.29346290249967555, -2215.186288877376, 48.70043225077816, 1.9287026295770313, 3.5939234766080475, 137.62538389102886, 8.207758400445293, 0.8549329489003654, 0.6721442346052675, 11.192589264584237, 1.7767960951941144, 0.3018719484005662, 0.16697569669655454]));
    let r7, g7 = scientific::dctn(x, []);
    assert(g7.kind == scientific::F_NONE && common::all_near(r7, [1.0, 2.4622888266898326, 4.171167510947728, 6.062866266041593, 8.103282983463814, 10.270619156458231, 12.549529737646981, 14.92852786458892, 17.398638404385867, 19.952623149688797, 22.584500550247288, 25.289230792133658, 28.06249997748054, 30.90056685321995, 33.800150712639834, 36.75834735990512, 39.77256477258468, 42.840472942735936, 45.95996414826417, 49.129121044631624, 52.34619071934546, 55.60956336124427, 58.9177545493537, 62.26939041505117]));
    let e1, h1 = scientific::dctn(x, [3]);
    assert(h1.kind == scientific::F_RANGE);
    let e2, h2 = scientific::dctn(x, [1, 1]);
    assert(h2.kind == scientific::F_VALUE);
    let e3, h3 = scientific::dstn(x, [0], 5);
    assert(h3.kind == scientific::F_VALUE);
    let e4, h4 = scientific::idctn(x, [0], 2, "nope");
    assert(h4.kind == scientific::F_VALUE);
    return;
}

// The axis variants of the one-row cosine, sine and Hermitian
// transforms are pinned against SciPy.
fn test_axis_transforms() {
    let a = common::mx(3, 4, [1.5, -2.0, 0.5, 3.0, 0.25, -1.0, 2.0, 0.75, -0.5, 1.25, 2.5, -1.5]);
    let zr = common::mx(3, 4, [1.5, -2.0, 0.5, 3.0, 0.25, -1.0, 2.0, 0.75, -0.5, 1.25, 2.5, -1.5]);
    let zi = common::mx(3, 4, [-1.5, 2.5, 1.25, -0.5, 0.75, 2.0, -1.0, 0.25, 3.0, 0.5, -2.0, 1.5]);
    let d0r, fd0 = scientific::dct_axis(a, 2, 5, 1, "ortho");
    assert(fd0.kind == scientific::F_NONE && d0r.shape[0] == 3 && d0r.shape[1] == 5);
    assert(common::all_close(d0r, [1.3416407864998738, -0.956488739789604, 0.2558336368008465, 3.5651268267280054, 0.09771975379242726, 0.894427190999916, -0.5001838215534362, -1.088134368770715, 1.1455636798782511, 1.4416877593639885, 0.7826237921249265, 0.7215566172617345, -1.7881125899888226, -1.8400016435008433, 1.6113358946921854], 1.0e-12));
    let d1r, fd1 = scientific::dct_axis(a, 3, 3, 0, "backward");
    assert(fd1.kind == scientific::F_NONE && d1r.shape[0] == 3 && d1r.shape[1] == 4);
    assert(common::all_close(d1r, [1.4330127018922194, -2.482050807568877, 6.464101615137755, 2.799038105676658, 2.5, -4.5, -4.5, 6.0, 0.5669872981077806, 0.982050807568877, -0.4641016151377553, 0.200961894323342], 1.0e-12));
    let d2r, fd2 = scientific::idct_axis(a, 2, 6, 0, "forward");
    assert(fd2.kind == scientific::F_NONE && d2r.shape[0] == 6 && d2r.shape[1] == 4);
    assert(common::all_close(d2r, [1.1169375093600955, -1.76678814311704, 8.693830324078466, 1.8508125280802865, 1.8535533905932735, -3.414213562373095, 3.32842712474619, 4.060660171779821, 2.4954349263356987, -4.682701599666138, -2.79485083851211, 5.986304779007098, 2.236615881233178, -3.647425419256055, -4.865403199332276, 5.2098476436995345, 1.146446609406726, -0.5857864376269051, -2.32842712474619, 1.9393398282201788, 0.1510116830710273, 2.096915162039233, 0.96642371376592, -1.0469649507869185], 1.0e-12));
    let d3r, fd3 = scientific::dst_axis(a, 1, 4, 1, "ortho");
    assert(fd3.kind == scientific::F_NONE && d3r.shape[0] == 3 && d3r.shape[1] == 4);
    assert(common::all_close(d3r, [0.7706147225595117, -1.8316215186617797, 3.264376349224232, 0.9461303358285874, 0.9732489894677304, -1.4159945808843262, 0.2297529205473611, 1.6186288477925448, 1.5121325123579272, 0.13681591193231507, -2.5970570392407835, 1.1236242282196167], 1.0e-12));
    let d4r, fd4 = scientific::idst_axis(a, 2, 3, 0, "backward");
    assert(fd4.kind == scientific::F_NONE && d4r.shape[0] == 3 && d4r.shape[1] == 4);
    assert(common::all_close(d4r, [0.23883545031536985, -0.4136751345948129, 1.0773502691896257, 0.46650635094610965, 0.5833333333333331, -0.875, -0.25000000000000006, 1.25, 0.09449788301796333, 0.16367513459481292, -0.07735026918962579, 0.033493649053890295], 1.0e-12));
    let d5r, fd5 = scientific::dct_axis(a, 2, 0, 0, "backward");
    assert(fd5.kind == scientific::F_NONE && d5r.shape[0] == 3 && d5r.shape[1] == 4);
    assert(common::all_close(d5r, [2.5, -3.5, 10.0, 4.5, 3.4641016151377544, -5.629165124598851, -3.4641016151377544, 7.794228634059948, 0.5, 1.2499999999999996, -1.0000000000000002, 0.0], 1.0e-12));
    let h0r, fh0 = scientific::hfft_axis(zr, zi, 5, 0, "backward");
    assert(fh0.kind == scientific::F_NONE && h0r.shape[0] == 5 && h0r.shape[1] == 4);
    assert(common::all_close(h0r, [1.0, -1.5, 9.5, 1.5, 7.4168217797599905, -0.24856515721417605, -6.562271036135147, 8.129460489712258, -4.038186710894632, 1.7906609675620024, 1.4376725549706153, -1.6998533974264873, 5.61113572776979, -1.0095080181874754, -3.8196385662207204, 3.4187004480519603, -2.4897707966351477, -9.03258779216035, 1.9442370473852524, 3.651692459662267], 1.0e-12));
    let h1r, fh1 = scientific::hfft_axis(zr, zi, 0, 1, "ortho");
    assert(fh1.kind == scientific::F_NONE && h1r.shape[0] == 3 && h1r.shape[1] == 6);
    assert(common::all_close(h1r, [0.6123724356957945, 1.0186572675941008, 3.333373219266362, 1.4288690166235203, 1.5656062662999939, -4.284643591305005, 1.224744871391589, -0.721762235436973, 2.121320343559643, 2.2453655975512468, -2.121320343559643, -2.135975797810068, 2.2453655975512468, -1.162722244395787, -0.5796607172008438, 1.4288690166235205, -4.115194623133581, 0.9585980991638555], 1.0e-12));
    let h2r, fh2 = scientific::hfft_axis(zr, zi, 6, 0, "forward");
    assert(fh2.kind == scientific::F_NONE && h2r.shape[0] == 6 && h2r.shape[1] == 4);
    assert(common::all_close(h2r, [0.16666666666666666, -0.25, 1.5833333333333333, 0.25, 1.4575317547305482, 0.013354503153698793, -0.8660254037844386, 1.3801814855409225, -0.35785238617166226, 0.05801270189221933, -0.37799153207185376, 0.2641560817564839, 0.0, 0.41666666666666663, 0.25, -0.2499999999999999, 0.9411857195049956, -0.8080127018922193, -0.9553418012614794, 0.985843918243516, -0.7075317547305482, -1.4300211698203653, 0.8660254037844386, 0.3698185144590774], 1.0e-12));
    let p0r, p0i, fp0 = scientific::ihfft_axis(a, 5, 1, "ortho");
    assert(fp0.kind == scientific::F_NONE && p0r.shape[0] == 3 && p0r.shape[1] == 3);
    assert(common::all_close(p0r, [1.3416407864998738, -0.8718847050625473, 1.8781152949374529, 0.8944271909999159, -1.0213525491562423, 0.8536474508437579, 0.7826237921249264, -0.4126644452187053, -0.5376644452187053], 1.0e-12) && common::all_close(p0i, [0.0, -1.5078146985009568, 0.5375823983209161, 0.0, -0.09674345910156142, -0.7945223112795917, 0.0, 1.5831189794582923, -1.3727196716296213], 1.0e-12));
    let p1r, p1i, fp1 = scientific::ihfft_axis(a, 3, 0, "backward");
    assert(fp1.kind == scientific::F_NONE && p1r.shape[0] == 2 && p1r.shape[1] == 4);
    assert(common::all_close(p1r, [0.41666666666666663, -0.5833333333333333, 1.6666666666666665, 0.75, 0.5416666666666666, -0.7083333333333333, -0.5833333333333333, 1.125], 1.0e-12) && common::all_close(p1i, [0.0, 0.0, 0.0, 0.0, 0.21650635094610965, -0.6495190528383289, -0.14433756729740643, 0.6495190528383289], 1.0e-12));
    let p2r, p2i, fp2 = scientific::ihfft_axis(a, 0, 1, "forward");
    assert(fp2.kind == scientific::F_NONE && p2r.shape[0] == 3 && p2r.shape[1] == 3);
    assert(common::all_close(p2r, [3.0, 1.0, 1.0, 2.0, -1.75, 2.5, 1.75, -3.0, 2.25], 1.0e-12) && common::all_close(p2i, [0.0, -5.0, 0.0, 0.0, -1.75, 0.0, 0.0, 2.75, 0.0], 1.0e-12));
    // Faults.
    let x1, g1 = scientific::dct_axis(a, 2, 0, 9, "backward");
    assert(g1.kind == scientific::F_RANGE);
    let x2, g2 = scientific::dct_axis(a, 2, -1, 0, "backward");
    assert(g2.kind == scientific::F_VALUE);
    let x3, g3 = scientific::dst_axis(a, 0, 0, 0, "backward");
    assert(g3.kind == scientific::F_VALUE);
    let x4, g4 = scientific::hfft_axis(zr, zi, 0, 0, "other");
    assert(g4.kind == scientific::F_VALUE);
    let x5, x6, g5 = scientific::ihfft_axis(a, 0, 0, "other");
    assert(g5.kind == scientific::F_VALUE);
    let x7, g6 = scientific::hfft_axis(zr, common::av([1.0, 2.0, 3.0, 4.0]), 0, 0, "backward");
    assert(g6.kind == scientific::F_SHAPE);
    return;
}

fn test_hfftn() {
    let zr = common::mx(3, 4, [1.5, -2.0, 0.5, 3.0, 0.25, -1.0, 2.0, 0.75, -0.5, 1.25, 2.5, -1.5]);
    let zi = common::mx(3, 4, [-1.5, 2.5, 1.25, -0.5, 0.75, 2.0, -1.0, 0.25, 3.0, 0.5, -2.0, 1.5]);
    let h, f1 = scientific::hfft2(zr, zi);
    assert(f1.kind == scientific::F_NONE && h.shape[0] == 3 && h.shape[1] == 6);
    assert(common::all_near(h, [10.0, -2.1208348754011492, 11.94134295108992, 12.499999999999996, -11.44134295108992, -13.379165124598849, -1.4509618943233418, 8.495190528383286, 3.705771365940053, -2.7320508075688767, 3.651923788646684, -13.611215932167726, -4.049038105676658, 1.1112159321677293, 8.848076211353316, 0.7320508075688781, 19.294228634059948, -4.49519052838329]));
    let h2, f2 = scientific::hfft2(zr, zi, 5);
    assert(f2.kind == scientific::F_NONE && h2.shape[1] == 5);
    assert(common::all_near(h2, [7.75, -0.46841264413391226, 16.37827975401956, -2.0348209058959785, -15.375046203989669, -3.7434301395927934, 10.422144364009288, -1.827769576130672, 2.7608714046501683, -9.229601845510924, -8.506569860407206, 7.085250501121263, 2.2685996499087713, 12.725349504696574, 4.295155997255532]));
    let a = common::mx(3, 4, [1.5, -2.0, 0.5, 3.0, 0.25, -1.0, 2.0, 0.75, -0.5, 1.25, 2.5, -1.5]);
    let ir, ii, f3 = scientific::ihfft2(a);
    assert(f3.kind == scientific::F_NONE && ir.shape[1] == 3);
    assert(common::all_near(ir, [0.5625, -0.3125, 0.47916666666666663, 0.09375, 0.6060095264191645, -0.11458333333333333, 0.09375, -0.0435095264191645, -0.11458333333333333]));
    assert(common::all_near(ii, [0.0, -0.33333333333333326, 0.0, 0.01804219591217581, -0.3681223537724543, 0.018042195912175787, -0.01804219591217581, -0.5485443128942123, -0.018042195912175787]));
    // The three dimensional forms.
    let z3r0 = common::av([1.5, -2.0, 0.5, 3.0, 0.25, -1.0, 2.0, 0.75, -0.5, 1.25, 2.5, -1.5]);
    let z3i0 = common::av([-1.5, 2.5, 1.25, -0.5, 0.75, 2.0, -1.0, 0.25, 3.0, 0.5, -2.0, 1.5]);
    let z3r, g1 = scientific::reshape(z3r0, [2, 3, 2]);
    let z3i, g2 = scientific::reshape(z3i0, [2, 3, 2]);
    assert(g1.kind == scientific::F_NONE && g2.kind == scientific::F_NONE);
    let h3, f4 = scientific::hfftn(z3r, z3i);
    assert(f4.kind == scientific::F_NONE);
    assert(common::all_near(h3, [6.75, 5.75, 1.7320508075688776, 12.044228634059948, -1.7320508075688772, -3.5442286340599476, -2.25, -1.25, -8.946152422706632, 1.4019237886466844, 1.446152422706632, 6.598076211353316]));
    let i3r, i3i, f5 = scientific::ihfftn(z3r);
    assert(f5.kind == scientific::F_NONE && i3r.shape[2] == 2);
    assert(common::all_near(i3i, [0.0, 0.0, 0.28867513459481287, -0.6856034446626805, -0.28867513459481287, 0.6856034446626805, 0.0, 0.0, 0.32475952641916445, 0.14433756729740643, -0.32475952641916445, -0.14433756729740643]));
    let b1, k1 = scientific::hfft2(z3r, z3i);
    assert(k1.kind == scientific::F_SHAPE);
    let b2, b3, k2 = scientific::ihfft2(z3r);
    assert(k2.kind == scientific::F_SHAPE);
    return;
}
