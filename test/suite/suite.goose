// run_group runs every test of one group. It tells whether the group exists.
fn run_group(g: const u8[:]) -> bool {
    if g == "array_helpers" {
        array_helpers_tests::test_pack_bits();
        array_helpers_tests::test_unpack_bits();
        array_helpers_tests::test_copy_into_array();
        array_helpers_tests::test_block_grid();
        array_helpers_tests::test_roll_axis();
        array_helpers_tests::test_split_sections();
        array_helpers_tests::test_sort_complex();
        array_helpers_tests::test_strided_array();
        array_helpers_tests::test_required_form();
        array_helpers_tests::test_bits_faults();
        array_helpers_tests::test_copy_faults();
        array_helpers_tests::test_block_faults();
        array_helpers_tests::test_roll_faults();
        array_helpers_tests::test_cut_faults();
        array_helpers_tests::test_sort_and_stride_faults();
        array_helpers_tests::test_forged_array();
        array_helpers_tests::test_element_limit();
        array_helpers_tests::test_forged_grid();
        array_helpers_tests::test_forged_pieces();
        return true;
    }
    if g == "assemble" {
        assemble_tests::test_assemble();
        return true;
    }
    if g == "balance" {
        balance_tests::test_balance();
        return true;
    }
    if g == "banded" {
