fn test_grey_pins1() {
    let r30, g30 = scientific::black_tophat(common_3::ni_nd([4, 5, 1], [-0.1, 5.0, -4.4, -2.1, 0.0, -1.1, 0.1, -1.9, 1.3, 1.1, -3.3, -5.4, -2.7, -0.5, 0.4, 0.7, -6.6, 3.5, -2.8, -0.1]), [1, 3, 2], "constant", 1.9, [0, 1, -1]);
    assert(g30.kind == scientific::F_NONE && r30.shape == [4, 5, 1] && common_3::ms_same(r30, [2.0, -3.1, 6.300000000000001, 4.0, 1.9, 3.0, 1.7999999999999998, 3.8, 0.5999999999999999, 0.7999999999999998, 5.199999999999999, 7.300000000000001, 4.6, 2.4, 1.5, 1.2, 8.5, -1.6, 4.699999999999999, 2.0]));
    let r31, g31 = scientific::black_tophat_st(common_3::ni_nd([4, 5, 1], [-0.1, 5.0, -4.4, -2.1, 0.0, -1.1, 0.1, -1.9, 1.3, 1.1, -3.3, -5.4, -2.7, -0.5, 0.4, 0.7, -6.6, 3.5, -2.8, -0.1]), scientific::empty_arr(), common_3::ni_nd([1, 3, 2], [0.2, 0.7, -0.9, 0.4, 2.0, -0.0]), "constant", 1.9, [0, 1, -1]);
    assert(g31.kind == scientific::F_NONE && r31.shape == [4, 5, 1] && common_3::ms_same(r31, [1.3, -3.8, 5.0, 2.6999999999999997, 0.5999999999999996, 1.6999999999999997, 0.49999999999999967, 2.4999999999999996, -0.10000000000000009, 0.0, 3.8999999999999995, 6.0, 3.3, 1.0999999999999996, 0.19999999999999962, 0.5, 7.199999999999999, -2.3, 3.3999999999999995, 0.6999999999999996]));
    let r32, g32 = scientific::grey_erosion(common_3::ni_nd([5], [-4.0, -1.7, 0.5, -1.7, -1.3]), [1], "mirror", 0.2, [0]);
    assert(g32.kind == scientific::F_NONE && r32.shape == [5] && common_3::ms_same(r32, [-4.0, -1.7, 0.5, -1.7, -1.3]));
    let r33, g33 = scientific::grey_erosion_st(common_3::ni_nd([5], [-4.0, -1.7, 0.5, -1.7, -1.3]), common_3::ni_nd([1], [1.0]), common_3::ni_nd([1], [-1.2]), "mirror", 0.2, [0]);
    assert(g33.kind == scientific::F_NONE && r33.shape == [5] && common_3::ms_same(r33, [-2.8, -0.5, 1.7, -0.5, -0.10000000000000009]));
    let r34, g34 = scientific::grey_dilation(common_3::ni_nd([5], [-4.0, -1.7, 0.5, -1.7, -1.3]), [1], "mirror", 0.2, [0]);
    assert(g34.kind == scientific::F_NONE && r34.shape == [5] && common_3::ms_same(r34, [-4.0, -1.7, 0.5, -1.7, -1.3]));
    let r35, g35 = scientific::grey_dilation_st(common_3::ni_nd([5], [-4.0, -1.7, 0.5, -1.7, -1.3]), common_3::ni_nd([1], [1.0]), common_3::ni_nd([1], [-1.6]), "mirror", 0.2, [0]);
    assert(g35.kind == scientific::F_NONE && r35.shape == [5] && common_3::ms_same(r35, [-5.6, -3.3, -1.1, -3.3, -2.9000000000000004]));
    let r36, g36 = scientific::grey_opening(common_3::ni_nd([5], [-4.0, -1.7, 0.5, -1.7, -1.3]), [1], "mirror", 0.2, [0]);
    assert(g36.kind == scientific::F_NONE && r36.shape == [5] && common_3::ms_same(r36, [-4.0, -1.7, 0.5, -1.7, -1.3]));
    let r37, g37 = scientific::grey_opening_st(common_3::ni_nd([5], [-4.0, -1.7, 0.5, -1.7, -1.3]), common_3::ni_nd([1], [1.0]), common_3::ni_nd([1], [1.2]), "mirror", 0.2, [0]);
    assert(g37.kind == scientific::F_NONE && r37.shape == [5] && common_3::ms_same(r37, [-4.0, -1.7, 0.5, -1.7, -1.3]));
