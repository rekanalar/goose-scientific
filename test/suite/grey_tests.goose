    assert(g146.kind == scientific::F_NONE && r146.shape == [2, 3] && common_3::ms_same(r146, [1.5, 2.7, 1.9, 1.5, 2.7, 1.9]));
    let r147, g147 = scientific::grey_dilation_st(common_3::ni_nd([2, 3], [-2.1, -3.5, -2.7, 1.5, 2.7, 1.9]), common_3::ni_nd([2, 1], [1.0, 1.0]), scientific::empty_arr(), "mirror", 1.4, [0, 0]);
    assert(g147.kind == scientific::F_NONE && r147.shape == [2, 3] && common_3::ms_same(r147, [1.5, 2.7, 1.9, 1.5, 2.7, 1.9]));
    let r148, g148 = scientific::grey_opening(common_3::ni_nd([2, 3], [-2.1, -3.5, -2.7, 1.5, 2.7, 1.9]), [2, 1], "mirror", 1.4, [0, 0]);
