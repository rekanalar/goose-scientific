fn test_grey_pins6() {
    let r180, g180 = scientific::grey_opening(common_3::ni_nd([5, 1], [-4.1, 1.7, -2.7, 4.4, -2.1]), [1, 1], "wrap", -0.6, [0, 0]);
    assert(g180.kind == scientific::F_NONE && r180.shape == [5, 1] && common_3::ms_same(r180, [-4.1, 1.7, -2.7, 4.4, -2.1]));
    let r181, g181 = scientific::grey_opening_st(common_3::ni_nd([5, 1], [-4.1, 1.7, -2.7, 4.4, -2.1]), common_3::ni_nd([1, 1], [1.0]), common_3::ni_nd([1, 1], [-1.5]), "wrap", -0.6, [0, 0]);
