// The tests of the group dsp. Run them with SCIENTIFIC_SUITES=dsp.
namespace dsp_tests;

import scientific from "../..";
import os;
import common;

fn test_dsp() {
    let pg, pgf = scientific::from_rows(4, 4, [9.0, 0.0, 60.0, 0.0, 0.0, 60.0, 0.0, 708.0, 60.0, 0.0, 708.0, 0.0, 0.0, 708.0, 0.0, 9780.0]);
    let pz, pzf = scientific::solve(pg, common::av([0.0, 0.0, 2.0, 0.0]));
    assert(pgf.kind == scientific::F_NONE && pzf.kind == scientific::F_NONE && common::near(pz.data[0], -0.04329004329004329) && common::near(pz.data[2], 0.006493506493506493));
    let fw1, fw1f = scientific::firwin(21, [0.3]);
    assert(fw1f.kind == scientific::F_NONE && common::all_near(fw1, [9.34176167519117e-19, 0.0029289031790009096, 0.006342347322322931, 0.003783041971756365, -0.012387848056448455, -0.034326572827062196, -0.031859861089054115, 0.026531216606606865, 0.13786316455699657, 0.25134767914641787, 0.2995558583789267, 0.25134767914641787, 0.13786316455699657, 0.026531216606606865, -0.031859861089054115, -0.034326572827062196, -0.012387848056448455, 0.003783041971756365, 0.006342347322322931, 0.0029289031790009096, 9.34176167519117e-19]));
    let fw2, fw2f = scientific::firwin(21, [0.3], false);
    assert(fw2f.kind == scientific::F_NONE && common::all_near(fw2, [-4.049811415111009e-18, -0.002930143801192959, -0.006345033808135852, -0.0037846443892952065, 0.012393095290061624, 0.03434111284611499, 0.03187335626055248, -0.026542454675635645, -0.13792156051308088, -0.25145414477181155, 0.6992597359575647, -0.25145414477181155, -0.13792156051308088, -0.026542454675635645, 0.03187335626055248, 0.03434111284611499, 0.012393095290061624, -0.0037846443892952065, -0.006345033808135852, -0.002930143801192959, -4.049811415111009e-18]));
    let fw3, fw3f = scientific::firwin(31, [0.2, 0.5], false, "hann");
    assert(fw3f.kind == scientific::F_NONE && common::all_near(fw3, [-0.0, -0.00014473366026072868, 5.1347477247545135e-05, -0.0023878089307026035, -0.0075341704804547105, 6.7617430750278495e-18, 0.019230757412242647, 0.016793758106393993, -0.001218297966068349, 0.02022984189547462, 0.04732613340132475, -0.03869267749918786, -0.1855970250836558, -0.14354725180212657, 0.1286358403009461, 0.2973588660328248, 0.1286358403009461, -0.14354725180212657, -0.1855970250836558, -0.038692677499187866, 0.047326133401324764, 0.02022984189547462, -0.0012182979660683496, 0.016793758106394, 0.019230757412242647, 6.761743075027862e-18, -0.007534170480454718, -0.0023878089307026035, 5.13474772475452e-05, -0.00014473366026072942, -0.0]));
    let fw4, fw4f = scientific::firwin(25, [0.2, 0.5], true, "blackman");
    assert(fw4f.kind == scientific::F_NONE && common::all_near(fw4, [-3.5138955038598284e-19, 0.00029140643875987156, -1.7949927528714434e-18, -0.003745118805866899, -0.0049374556863222225, 0.000494354333258714, -0.01064118201960838, -0.030678215113981513, 0.029576226495676153, 0.1607246205466832, 0.13566801978202178, -0.1280391373185936, 0.7025729626959456, -0.12803913731859362, 0.1356680197820218, 0.16072462054668324, 0.029576226495676167, -0.030678215113981545, -0.01064118201960838, 0.0004943543332587145, -0.004937455686322234, -0.003745118805866899, -1.7949927528714465e-18, 0.0002914064387598722, -3.5138955038598284e-19]));
    let fw5, fw5f = scientific::firwin(15, [1000.0], true, "hamming", true, 8000.0);
    assert(fw5f.kind == scientific::F_NONE && common::all_near(fw5, [-0.0025775965600865667, -0.006674494920200382, -0.011421090886231026, 4.273721637740298e-18, 0.04829253250636341, 0.1318594485716218, 0.21526539121376717, 0.2505116201495313, 0.21526539121376717, 0.1318594485716218, 0.04829253250636341, 4.273721637740298e-18, -0.011421090886231026, -0.006674494920200382, -0.0025775965600865667]));
    let fw6, fw6f = scientific::firwin(21, [0.3], true, "kaiser", true, 2.0, 5.0);
    assert(fw6f.kind == scientific::F_NONE && common::all_near(fw6, [4.293432898844986e-19, 0.002720928098159983, 0.006780773912375082, 0.004040120705800866, -0.012938749717734762, -0.03519786593893117, -0.032286080016798197, 0.026709108004773673, 0.13832830319814807, 0.2518339613107667, 0.3000190008868794, 0.2518339613107667, 0.13832830319814807, 0.026709108004773673, -0.032286080016798197, -0.03519786593893117, -0.012938749717734762, 0.004040120705800866, 0.006780773912375082, 0.002720928098159983, 4.293432898844986e-19]));
    let zw, zr, zi, zf = scientific::freqz([0.2, 0.3, 0.2], [1.0, -0.4, 0.1], 16);
    assert(zf.kind == scientific::F_NONE && common::all_near(zw, [0.0, 0.19634954084936207, 0.39269908169872414, 0.5890486225480862, 0.7853981633974483, 0.9817477042468103, 1.1780972450961724, 1.3744467859455345, 1.5707963267948966, 1.7671458676442586, 1.9634954084936207, 2.1598449493429825, 2.356194490192345, 2.552544031041707, 2.748893571891069, 2.945243112740431]) && common::all_near(zr, [1.0, 0.9558703822250522, 0.8278830514729616, 0.6323091093921817, 0.40202601153348333, 0.18237446967487966, 0.01372138669228167, -0.0861515662909957, -0.12371134020618557, -0.11791721853266074, -0.08834405326697602, -0.04969604916721771, -0.01127527301866199, 0.02165598652001318, 0.046367130716893946, 0.06155463892161986]) && common::all_near(zi, [0.0, -0.24722625144999696, -0.46268125700051527, -0.6143659640622462, -0.6771730124445141, -0.6464108377705035, -0.5445465676681835, -0.4101742416852979, -0.27835051546391754, -0.1693563852684368, -0.08947825993234672, -0.03677942516941148, -0.006092234202688692, 0.008236834638692177, 0.011275793322261266, 0.007308207039902913]));
    let fc_full, fc_fullf = scientific::fftconvolve([1.0, 3.0, -2.0, 4.0, 0.5, 7.0, -1.0, 2.0, 2.5, -3.0, 1.0], [0.5, 1.0, -0.5, 2.0], "full");
    assert(fc_fullf.kind == scientific::F_NONE && common::all_near(fc_full, [0.5000000000000009, 2.4999999999999987, 1.5, 0.5, 11.249999999999998, -1.9999999999999976, 14.249999999999996, -2.499999999999999, 17.749999999999996, -1.9999999999999991, 0.2500000000000007, 7.499999999999999, -6.499999999999998, 2.0]));
    let fc_same, fc_samef = scientific::fftconvolve([1.0, 3.0, -2.0, 4.0, 0.5, 7.0, -1.0, 2.0, 2.5, -3.0, 1.0], [0.5, 1.0, -0.5, 2.0], "same");
    assert(fc_samef.kind == scientific::F_NONE && common::all_near(fc_same, [2.4999999999999987, 1.5, 0.5, 11.249999999999998, -1.9999999999999976, 14.249999999999996, -2.499999999999999, 17.749999999999996, -1.9999999999999991, 0.2500000000000007, 7.499999999999999]));
    let fc_valid, fc_validf = scientific::fftconvolve([1.0, 3.0, -2.0, 4.0, 0.5, 7.0, -1.0, 2.0, 2.5, -3.0, 1.0], [0.5, 1.0, -0.5, 2.0], "valid");
    assert(fc_validf.kind == scientific::F_NONE && common::all_near(fc_valid, [0.5, 11.249999999999998, -1.9999999999999976, 14.249999999999996, -2.499999999999999, 17.749999999999996, -1.9999999999999991, 0.2500000000000007]));
    let fc_v2, fc_v2f = scientific::fftconvolve([0.5, 1.0, -0.5, 2.0], [1.0, 3.0, -2.0, 4.0, 0.5, 7.0, -1.0, 2.0, 2.5, -3.0, 1.0], "valid");
    assert(fc_v2f.kind == scientific::F_NONE && common::all_near(fc_v2, [0.5, 11.249999999999998, -1.9999999999999976, 14.249999999999996, -2.499999999999999, 17.749999999999996, -1.9999999999999991, 0.2500000000000007]));
    let mf, mff = scientific::medfilt([1.0, 3.0, -2.0, 4.0, 0.5, 7.0, -1.0, 2.0, 2.5, -3.0, 1.0], 5);
    assert(mff.kind == scientific::F_NONE && common::all_near(mf, [0.0, 1.0, 1.0, 3.0, 0.5, 2.0, 2.0, 2.0, 1.0, 1.0, 0.0]));
    let sc1, sc1f = scientific::savgol_coeffs(7, 2);
    assert(sc1f.kind == scientific::F_NONE && common::all_near(sc1, [-0.09523809523809523, 0.14285714285714307, 0.285714285714286, 0.33333333333333365, 0.2857142857142859, 0.142857142857143, -0.09523809523809527]));
    let sc2, sc2f = scientific::savgol_coeffs(7, 3, 1);
    assert(sc2f.kind == scientific::F_NONE && common::all_near(sc2, [-0.08730158730158721, 0.2658730158730158, 0.23015873015873023, 5.204170427930421e-17, -0.23015873015873023, -0.2658730158730159, 0.08730158730158737]));
    let sc3, sc3f = scientific::savgol_coeffs(9, 3, 2, 0.5);
    assert(sc3f.kind == scientific::F_NONE && common::all_near(sc3, [0.2424242424242424, 0.060606060606060615, -0.0692640692640693, -0.14718614718614717, -0.17316017316017315, -0.14718614718614717, -0.06926406926406925, 0.060606060606060615, 0.2424242424242424]));
    let sg_interp, sg_interpf = scientific::savgol_filter([0.3, 0.3276536078418991, 0.2223589125935188, 0.4638590687632922, 0.9820259861980096, 1.2419609070739932, 1.0136816127728492, 0.6996694662346034, 0.7410021495975131, 0.9723520984840844, 0.8707061785390153, 0.3330266611024162, -0.15713327949527736, -0.2191256136890593, -0.11187748660204291, -0.3328168277981605, -0.8679804930592206, -1.1932138175073619, -1.0259015069623527, -0.7269469096485195, -0.7648484779645464, -1.027450276190937, -0.9897716712574192, -0.491826398794253, 0.013617992050752648], 7, 3, 0, 1.0, "interp");
    assert(sg_interpf.kind == scientific::F_NONE && common::all_near(sg_interp, [0.36902055538705236, 0.15236218380603747, 0.2819875201614215, 0.5978477711092478, 0.8934560564931378, 1.0586588297121307, 1.0020102667692072, 0.8744411202411712, 0.8439206034798812, 0.8505574463649376, 0.7008445101194162, 0.362574007160642, 0.027661374402489003, -0.15013170302162673, -0.25951257428529645, -0.4799911615823198, -0.7977732979650343, -1.0067441907565642, -0.9942965531792799, -0.8942674395029838, -0.883679122040222, -0.9215059868654039, -0.921585005747395, -0.6474378520571571, 0.07248917111392894]));
    let sg_nearest, sg_nearestf = scientific::savgol_filter([0.3, 0.3276536078418991, 0.2223589125935188, 0.4638590687632922, 0.9820259861980096, 1.2419609070739932, 1.0136816127728492, 0.6996694662346034, 0.7410021495975131, 0.9723520984840844, 0.8707061785390153, 0.3330266611024162, -0.15713327949527736, -0.2191256136890593, -0.11187748660204291, -0.3328168277981605, -0.8679804930592206, -1.1932138175073619, -1.0259015069623527, -0.7269469096485195, -0.7648484779645464, -1.027450276190937, -0.9897716712574192, -0.491826398794253, 0.013617992050752648], 7, 3, 0, 1.0, "nearest");
    assert(sg_nearestf.kind == scientific::F_NONE && common::all_near(sg_nearest, [0.28120382130025573, 0.24548828401658418, 0.33655926629675365, 0.5978477711092478, 0.8934560564931378, 1.0586588297121307, 1.0020102667692072, 0.8744411202411712, 0.8439206034798812, 0.8505574463649376, 0.7008445101194162, 0.362574007160642, 0.027661374402489003, -0.15013170302162673, -0.25951257428529645, -0.4799911615823198, -0.7977732979650343, -1.0067441907565642, -0.9942965531792799, -0.8942674395029838, -0.883679122040222, -0.9215059868654039, -0.8033854938694731, -0.516130607018702, -0.17498671264025553]));
    let sg_mirror, sg_mirrorf = scientific::savgol_filter([0.3, 0.3276536078418991, 0.2223589125935188, 0.4638590687632922, 0.9820259861980096, 1.2419609070739932, 1.0136816127728492, 0.6996694662346034, 0.7410021495975131, 0.9723520984840844, 0.8707061785390153, 0.3330266611024162, -0.15713327949527736, -0.2191256136890593, -0.11187748660204291, -0.3328168277981605, -0.8679804930592206, -1.1932138175073619, -1.0259015069623527, -0.7269469096485195, -0.7648484779645464, -1.027450276190937, -0.9897716712574192, -0.491826398794253, 0.013617992050752648], 7, 3, 0, 1.0, "mirror");
    assert(sg_mirrorf.kind == scientific::F_NONE && common::all_near(sg_mirror, [0.2624076426005113, 0.2568331886993775, 0.3339255893594299, 0.5978477711092478, 0.8934560564931378, 1.0586588297121307, 1.0020102667692072, 0.8744411202411712, 0.8439206034798812, 0.8505574463649376, 0.7008445101194162, 0.362574007160642, 0.027661374402489003, -0.15013170302162673, -0.25951257428529645, -0.4799911615823198, -0.7977732979650343, -1.0067441907565642, -0.9942965531792799, -0.8942674395029838, -0.883679122040222, -0.9215059868654039, -0.7552479328366153, -0.49277602825292455, -0.3635914173312637]));
    let sg_constant, sg_constantf = scientific::savgol_filter([0.3, 0.3276536078418991, 0.2223589125935188, 0.4638590687632922, 0.9820259861980096, 1.2419609070739932, 1.0136816127728492, 0.6996694662346034, 0.7410021495975131, 0.9723520984840844, 0.8707061785390153, 0.3330266611024162, -0.15713327949527736, -0.2191256136890593, -0.11187748660204291, -0.3328168277981605, -0.8679804930592206, -1.1932138175073619, -1.0259015069623527, -0.7269469096485195, -0.7648484779645464, -1.027450276190937, -0.9897716712574192, -0.491826398794253, 0.013617992050752648], 7, 3, 0, 1.0, "constant");
    assert(sg_constantf.kind == scientific::F_NONE && common::all_near(sg_constant, [0.1812038213002557, 0.2312025697308699, 0.3651306948681822, 0.5978477711092478, 0.8934560564931378, 1.0586588297121307, 1.0020102667692072, 0.8744411202411712, 0.8439206034798812, 0.8505574463649376, 0.7008445101194162, 0.362574007160642, 0.027661374402489003, -0.15013170302162673, -0.25951257428529645, -0.4799911615823198, -0.7977732979650343, -1.0067441907565642, -0.9942965531792799, -0.8942674395029838, -0.883679122040222, -0.9215059868654039, -0.8020885422455919, -0.5167790828306427, -0.17952604332383976]));
    let sg_wrap, sg_wrapf = scientific::savgol_filter([0.3, 0.3276536078418991, 0.2223589125935188, 0.4638590687632922, 0.9820259861980096, 1.2419609070739932, 1.0136816127728492, 0.6996694662346034, 0.7410021495975131, 0.9723520984840844, 0.8707061785390153, 0.3330266611024162, -0.15713327949527736, -0.2191256136890593, -0.11187748660204291, -0.3328168277981605, -0.8679804930592206, -1.1932138175073619, -1.0259015069623527, -0.7269469096485195, -0.7648484779645464, -1.027450276190937, -0.9897716712574192, -0.491826398794253, 0.013617992050752648], 7, 3, 0, 1.0, "wrap");
    assert(sg_wrapf.kind == scientific::F_NONE && common::all_near(sg_wrap, [0.2090977307496174, 0.2799886065756682, 0.36383374324430107, 0.5978477711092478, 0.8934560564931378, 1.0586588297121307, 1.0020102667692072, 0.8744411202411712, 0.8439206034798812, 0.8505574463649376, 0.7008445101194162, 0.362574007160642, 0.027661374402489003, -0.15013170302162673, -0.25951257428529645, -0.4799911615823198, -0.7977732979650343, -1.0067441907565642, -0.9942965531792799, -0.8942674395029838, -0.883679122040222, -0.9215059868654039, -0.8306599708170205, -0.5051270454822521, -0.06818113864104636]));
    let sg_d, sg_df = scientific::savgol_filter([0.3, 0.3276536078418991, 0.2223589125935188, 0.4638590687632922, 0.9820259861980096, 1.2419609070739932, 1.0136816127728492, 0.6996694662346034, 0.7410021495975131, 0.9723520984840844, 0.8707061785390153, 0.3330266611024162, -0.15713327949527736, -0.2191256136890593, -0.11187748660204291, -0.3328168277981605, -0.8679804930592206, -1.1932138175073619, -1.0259015069623527, -0.7269469096485195, -0.7648484779645464, -1.027450276190937, -0.9897716712574192, -0.491826398794253, 0.013617992050752648], 7, 3, 1, 0.25);
    assert(sg_df.kind == scientific::F_NONE && common::all_near(sg_d, [-1.7725992933221317, -0.0673668748886247, 0.997670370169059, 1.4225124418509227, 1.4280028357047037, 0.09881225012429662, -0.9331483694408783, -0.49889148049516674, 0.4163935236218692, 0.13834433912141875, -1.2228961485560814, -1.9155610045269744, -1.0975273194309065, -0.05929477767253738, -0.32767560631265036, -1.428650524223285, -1.5868343850185134, -0.3365201981012802, 0.7815120878063037, 0.4591529979433904, -0.48315903934790594, -0.3200301581276047, 0.4337671383440782, 1.8737792224502354, 4.0000060941908675]));
    let pk1, pk1f = scientific::find_peaks([0.0, 1.0, 0.0, 2.0, 2.0, 2.0, 0.0, 3.0, 1.0, 5.0, 4.0, 4.0, 6.0, 0.5, 0.7, 0.2, 3.0, 2.0, 1.0, 4.0, 0.0]);
    assert(pk1f.kind == scientific::F_NONE && common::all_near(pk1, [1.0, 4.0, 7.0, 9.0, 12.0, 14.0, 16.0, 19.0]));
    let pk2, pk2f = scientific::find_peaks([0.0, 1.0, 0.0, 2.0, 2.0, 2.0, 0.0, 3.0, 1.0, 5.0, 4.0, 4.0, 6.0, 0.5, 0.7, 0.2, 3.0, 2.0, 1.0, 4.0, 0.0], 2.0);
    assert(pk2f.kind == scientific::F_NONE && common::all_near(pk2, [4.0, 7.0, 9.0, 12.0, 16.0, 19.0]));
    let pk3, pk3f = scientific::find_peaks([0.0, 1.0, 0.0, 2.0, 2.0, 2.0, 0.0, 3.0, 1.0, 5.0, 4.0, 4.0, 6.0, 0.5, 0.7, 0.2, 3.0, 2.0, 1.0, 4.0, 0.0], 0.0 / 0.0, 3.0);
    assert(pk3f.kind == scientific::F_NONE && common::all_near(pk3, [1.0, 4.0, 9.0, 12.0, 16.0, 19.0]));
    let pk4, pk4f = scientific::find_peaks([0.0, 1.0, 0.0, 2.0, 2.0, 2.0, 0.0, 3.0, 1.0, 5.0, 4.0, 4.0, 6.0, 0.5, 0.7, 0.2, 3.0, 2.0, 1.0, 4.0, 0.0], 0.0 / 0.0, 0.0, 2.0);
    assert(pk4f.kind == scientific::F_NONE && common::all_near(pk4, [4.0, 7.0, 12.0, 16.0, 19.0]));
    let pk5, pk5f = scientific::find_peaks([0.0, 1.0, 0.0, 2.0, 2.0, 2.0, 0.0, 3.0, 1.0, 5.0, 4.0, 4.0, 6.0, 0.5, 0.7, 0.2, 3.0, 2.0, 1.0, 4.0, 0.0], 1.0, 2.0, 0.5);
    assert(pk5f.kind == scientific::F_NONE && common::all_near(pk5, [1.0, 4.0, 7.0, 9.0, 12.0, 16.0, 19.0]));
    let pp, ppf = scientific::peak_prominences([0.0, 1.0, 0.0, 2.0, 2.0, 2.0, 0.0, 3.0, 1.0, 5.0, 4.0, 4.0, 6.0, 0.5, 0.7, 0.2, 3.0, 2.0, 1.0, 4.0, 0.0], [1.0, 4.0, 7.0, 9.0, 12.0, 14.0, 16.0, 19.0]);
    assert(ppf.kind == scientific::F_NONE && common::all_near(pp, [1.0, 2.0, 2.0, 1.0, 6.0, 0.19999999999999996, 2.0, 3.8]));
    let pd1f, pd1p, pd1e = scientific::periodogram([0.8, 0.825118635510321, 0.7667649357308379, 1.4351187926374929, 1.325938592314405, 0.006107373853762976, -0.6522695660031785, -0.2657998949072589, -0.3831431188056557, -0.7401987785254835, 0.1454915028125274, 1.3789288776568174, 1.2824517760598095, 0.7520431520810179, 0.9814759095853356, 0.7755282581475771, -0.50067489807501, -1.0732204790461601, -0.33234452142080745, 0.054488300671869105]);
    assert(pd1e.kind == scientific::F_NONE && common::all_near(pd1f, [0.0, 0.05, 0.1, 0.15000000000000002, 0.2, 0.25, 0.30000000000000004, 0.35000000000000003, 0.4, 0.45, 0.5]) && common::all_near(pd1p, [1.7333369499485123e-31, 0.03622434387966118, 9.47608318658677, 0.06944862457564174, 0.1601399113760153, 1.5630346620482092, 0.5599806672167472, 0.0644731351727721, 0.020830783767041745, 0.010465452604919765, 0.004077693272727992]));
    let pd2f, pd2p, pd2e = scientific::periodogram([0.8, 0.825118635510321, 0.7667649357308379, 1.4351187926374929, 1.325938592314405, 0.006107373853762976, -0.6522695660031785, -0.2657998949072589, -0.3831431188056557, -0.7401987785254835, 0.1454915028125274, 1.3789288776568174, 1.2824517760598095, 0.7520431520810179, 0.9814759095853356, 0.7755282581475771, -0.50067489807501, -1.0732204790461601, -0.33234452142080745, 0.054488300671869105], 2.0, "hann");
    assert(pd2e.kind == scientific::F_NONE && common::all_near(pd2f, [0.0, 0.1, 0.2, 0.30000000000000004, 0.4, 0.5, 0.6000000000000001, 0.7000000000000001, 0.8, 0.9, 1.0]) && common::all_near(pd2p, [0.005756433759959763, 0.8318795578569342, 3.3580173408332294, 0.7924687802807604, 0.042238687955419046, 0.6763929859811776, 0.5182355825215812, 0.012165141222585373, 0.00031400805110706525, 2.7083702205284593e-05, 1.6267669950949622e-06]));
    let pd3f, pd3p, pd3e = scientific::periodogram([0.8, 0.825118635510321, 0.7667649357308379, 1.4351187926374929, 1.325938592314405, 0.006107373853762976, -0.6522695660031785, -0.2657998949072589, -0.3831431188056557, -0.7401987785254835, 0.1454915028125274, 1.3789288776568174, 1.2824517760598095, 0.7520431520810179, 0.9814759095853356, 0.7755282581475771, -0.50067489807501, -1.0732204790461601, -0.33234452142080745, 0.054488300671869105], 1.0, "hamming", false, "spectrum");
    assert(pd3e.kind == scientific::F_NONE && common::all_near(pd3f, [0.0, 0.05, 0.1, 0.15000000000000002, 0.2, 0.25, 0.30000000000000004, 0.35000000000000003, 0.4, 0.45, 0.5]) && common::all_near(pd3p, [0.09245173355387341, 0.12169751412756662, 0.4989637231458907, 0.08945733703008615, 0.003089328152875481, 0.09768649855838707, 0.06863048967668127, 0.0008542758259555562, 2.204459123191585e-05, 1.372156044293214e-05, 6.432195295839863e-06]));
    let rs1, rs1f = scientific::resample([1.0, 3.0, -2.0, 4.0, 0.5, 7.0, -1.0, 2.0, 2.5, -3.0, 1.0], 12);
    assert(rs1f.kind == scientific::F_NONE && common::all_near(rs1, [1.0, 3.4088286995133306, -2.1529261272935996, 3.1327083160009366, 1.3953954497041607, 4.0292262293565395, 5.016374675456964, -2.9511294345248875, 5.024080474603759, -0.30978345475750846, -2.1011062906531013, 0.8719678262297724]));
    let rs2, rs2f = scientific::resample([1.0, 3.0, -2.0, 4.0, 0.5, 7.0, -1.0, 2.0, 2.5, -3.0, 1.0], 31);
    assert(rs2f.kind == scientific::F_NONE && common::all_near(rs2, [1.0, 2.9167215048379447, 3.8747964201741305, 2.6096378418667507, -0.12251178875432132, -2.056981850680391, -1.4717167885085531, 1.1658267679267489, 3.5792707938294632, 3.8025325364964186, 2.0544240548735346, 0.5515822921059614, 1.3639488587931572, 4.303502775738238, 6.885768985587654, 6.513226623839117, 2.932276009238599, -1.3211558288909717, -2.98946564448787, -0.8864275163358073, 3.065295021599976, 5.477854527013384, 4.359296411218501, 0.6775105498082156, -2.667347940319169, -3.4176833960133144, -1.7265095606102192, 0.3647632116675908, 1.0533081616438729, 0.40228772169277777, -0.021303482624155837]));
    let rs3, rs3f = scientific::resample([1.0, 3.0, -2.0, 4.0, 0.5, 7.0, -1.0, 2.0, 2.5, -3.0, 1.0], 20);
    assert(rs3f.kind == scientific::F_NONE && common::all_near(rs3, [1.0, 3.681150542217898, 2.3715255774916217, -1.6151416067282278, -1.0513089318350106, 3.132708316000936, 3.4090001001719417, 0.6614515197982412, 2.3881269015744055, 6.811666879495357, 5.016374675456964, -1.48813649707764, -2.118816070426243, 3.6027939607803043, 5.064689208662752, -0.309783454757509, -3.5054435596706464, -0.9197122568236857, 1.0622157349378516, 0.07936623345796333]));
    let rs4, rs4f = scientific::resample([1.0, 3.0, -2.0, 4.0, 0.5, 7.0, -1.0, 2.0, 2.5, -3.0, 1.0], 9);
    assert(rs4f.kind == scientific::F_NONE && common::all_near(rs4, [3.021124695707862, 0.20713061429099255, 1.1639008055178017, 2.0286230383838757, 4.980912930938045, 0.21478346436268422, 2.3697281902161795, -0.1309848866660851, -1.5824915800240853]));
    let rs5, rs5f = scientific::resample([0.8, 0.825118635510321, 0.7667649357308379, 1.4351187926374929, 1.325938592314405, 0.006107373853762976, -0.6522695660031785, -0.2657998949072589, -0.3831431188056557, -0.7401987785254835, 0.1454915028125274, 1.3789288776568174, 1.2824517760598095, 0.7520431520810179, 0.9814759095853356, 0.7755282581475771, -0.50067489807501, -1.0732204790461601, -0.33234452142080745, 0.054488300671869105], 40);
    assert(rs5f.kind == scientific::F_NONE && common::all_near(rs5, [0.8, 0.9544946819635503, 0.825118635510321, 0.6781377130355204, 0.7667649357308379, 1.0873782738859785, 1.4351187926374933, 1.5682728292638606, 1.325938592314405, 0.7264307369636667, 0.006107373853762966, -0.5126244780727316, -0.6522695660031785, -0.4897716310952664, -0.26579989490725936, -0.20754228510647021, -0.3831431188056558, -0.6492339148910417, -0.7401987785254835, -0.46502547062663524, 0.1454915028125275, 0.8583871563594059, 1.3789288776568176, 1.511780922867767, 1.2824517760598095, 0.9357983193052916, 0.752043152081018, 0.8168738049890263, 0.9814759095853358, 1.0202303971429474, 0.7755282581475772, 0.21570837428959966, -0.5006748980750099, -1.0266564961356879, -1.0732204790461601, -0.7188267844117342, -0.3323445214208076, -0.12615509835973449, 0.054488300671868786, 0.4041477989109072]));
    let rs6, rs6f = scientific::resample([0.8, 0.825118635510321, 0.7667649357308379, 1.4351187926374929, 1.325938592314405, 0.006107373853762976, -0.6522695660031785, -0.2657998949072589, -0.3831431188056557, -0.7401987785254835, 0.1454915028125274, 1.3789288776568174, 1.2824517760598095, 0.7520431520810179, 0.9814759095853356, 0.7755282581475771, -0.50067489807501, -1.0732204790461601, -0.33234452142080745, 0.054488300671869105], 10);
    assert(rs6f.kind == scientific::F_NONE && common::all_near(rs6, [0.7546927755672231, 0.9592169106969927, 1.1138562962583884, -0.46978458613890467, -0.5037824576150864, 0.1827246613412708, 1.3406576375909123, 0.8250797492312961, -0.2522459938374652, -0.6595125679555172]));
    let li, lif = scientific::lfiltic([0.2, 0.3, 0.2], [1.0, -0.4, 0.1], [1.0, 0.5], [2.0, -1.0]);
    assert(lif.kind == scientific::F_NONE && common::all_near(li, [0.75, 0.30000000000000004]));
    let e1, e1f = scientific::firwin(20, [0.3], false);
    assert(e1f.kind == scientific::F_VALUE);
    let e2, e2f = scientific::medfilt([1.0, 2.0, 3.0], 2);
    assert(e2f.kind == scientific::F_VALUE);
    let e3, e3f = scientific::savgol_filter([1.0, 2.0, 3.0], 5, 2);
    assert(e3f.kind == scientific::F_SHAPE);
    let e4, e4f = scientific::find_peaks([1.0, 1.0, 1.0]);
    assert(e4f.kind == scientific::F_VALUE);
    let e5, e5f = scientific::savgol_coeffs(6, 2);
    assert(e5f.kind == scientific::F_VALUE);
}

// sosfreqz is pinned against SciPy.
fn test_sosfreqz() {
    let w, hr, hi, f1 = scientific::sosfreqz(common::sf_sos(), 5);
    assert(f1.kind == scientific::F_NONE);
    assert(common::all_near(w, [0.0, 0.6283185307179586, 1.2566370614359172, 1.8849555921538759, 2.5132741228718345]));
    assert(common::all_loose(hr, [1.0, -0.21708827518165963, -0.09993200670106575, 0.010342348962786515, 0.0006814869992726401]));
    assert(common::all_loose(hi, [0.0, -0.9624215957339939, 0.2128155141360432, 0.01567225283401711, 0.00031608231753612226]));
    let r2, i2, f2 = scientific::sosfreqz_at(common::sf_sos(), [0.1, 1.0, 2.0]);
    assert(f2.kind == scientific::F_NONE);
    assert(common::all_loose(r2, [0.9671606461491014, -0.5838102178759325, 0.007400139523795283]));
    assert(common::all_loose(i2, [-0.25416584326812836, 0.15258273743416995, 0.008744911198204164]));
    let w3, r3, i3, f3 = scientific::sosfreqz(common::sf_sos(), 0);
    assert(f3.kind == scientific::F_SHAPE);
    return;
}
