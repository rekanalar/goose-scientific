fn test_transform_pins11() {
    let r330, g330 = scientific::shift(common_3::tr_arr(1), [-0.51], 0, "mirror", 0.4);
    assert(g330.kind == scientific::F_NONE && r330.shape == [7] && common_3::tr_same(r330, [-0.324, -0.07, 0.026, -0.449, -0.552, 0.354, -0.552]));
    let r331, g331 = scientific::shift(common_3::tr_arr(1), [0.57], 1, "mirror", 0.4);
    assert(g331.kind == scientific::F_NONE && r331.shape == [7] && common_3::tr_same(r331, [-0.65166, -0.75834, -0.21477999999999997, -0.02871999999999999, -0.17825000000000008, -0.49329, -0.16242000000000031]));
    let r332, g332 = scientific::shift(common_3::tr_arr(1), [1.86], 3, "mirror", 0.4);
    assert(g332.kind == scientific::F_NONE && r332.shape == [7] && common_3::tr_same(r332, [-0.08386997704615386, -0.44035980806153846, -1.0577053827076928, -0.2367832691076924, -0.04935154086153857, -0.007234239446153815, -0.526878709353846]));
    let r333, g333 = scientific::shift(common_3::tr_arr(1), [1.62], 4, "mirror", 0.4);
    assert(g333.kind == scientific::F_NONE && r333.shape == [7] && common_3::tr_same(r333, [-0.09131695006366906, -0.6832910640908726, -0.9152577371278686, -0.12898523243154222, -0.02184700746312425, -0.07794758341897508, -0.661503096594244]));
    let r334, g334 = scientific::zoom(common_3::tr_arr(1), [0.95], 1, "mirror", 0.4, true, false);
    assert(g334.kind == scientific::F_NONE && r334.shape == [7] && common_3::tr_same(r334, [-1.086, -0.324, -0.07, 0.026, -0.449, -0.552, 0.354]));
    let r335, g335 = scientific::zoom(common_3::tr_arr(1), [0.95], 1, "mirror", 0.4, true, true);
    assert(g335.kind == scientific::F_NONE && r335.shape == [7] && common_3::tr_same(r335, [-1.086, -0.324, -0.07, 0.026, -0.449, -0.552, 0.354]));
    let r336, g336 = scientific::zoom(common_3::tr_arr(1), [2.13], 3, "mirror", 0.4, true, false);
    assert(g336.kind == scientific::F_NONE && r336.shape == [15] && common_3::tr_same(r336, [-1.0860000000000003, -0.8628565149136579, -0.44297896389324976, -0.17414868804664735, -0.0955263511998206, -0.04887055393586016, 0.024895537115945263, 0.02599999999999993, -0.12418474994393354, -0.36505131195335266, -0.5971471181879345, -0.6740962099125364, -0.42344902444494326, 0.07577546535097533, 0.3539999999999999]));
    let r337, g337 = scientific::zoom(common_3::tr_arr(1), [2.13], 3, "mirror", 0.4, true, true);
    assert(g337.kind == scientific::F_NONE && r337.shape == [15] && common_3::tr_same(r337, [-0.990482716809117, -1.030158030769231, -0.6299168091168091, -0.24028877037037047, -0.10679335384615388, -0.06097061652421652, 0.019613638746438754, 0.02599999999999993, -0.1433254609686611, -0.41011418347578377, -0.6401010461538464, -0.6306680296296295, -0.20649800569800605, 0.28366843076923065, 0.23401670199430202]));
    let r338, g338 = scientific::zoom(common_3::tr_arr(1), [1.06], 5, "mirror", 0.4, true, false);
    assert(g338.kind == scientific::F_NONE && r338.shape == [7] && common_3::tr_same(r338, [-1.0859999999999999, -0.3240000000000003, -0.07000000000000006, 0.026000000000000655, -0.4490000000000009, -0.5519999999999995, 0.3540000000000002]));
    let r339, g339 = scientific::zoom(common_3::tr_arr(1), [1.06], 5, "mirror", 0.4, true, true);
    assert(g339.kind == scientific::F_NONE && r339.shape == [7] && common_3::tr_same(r339, [-1.0859999999999999, -0.3240000000000003, -0.07000000000000006, 0.026000000000000655, -0.4490000000000009, -0.5519999999999995, 0.3540000000000002]));
    let r340, g340 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1], [1.57]), [-1.48], [], 1, "mirror", 0.4);
    assert(g340.kind == scientific::F_NONE && r340.shape == [7] && common_3::tr_same(r340, [-0.20208000000000004, -1.01742, -0.15635999999999992, -0.08325000000000021, -0.5314000000000001, 0.018779999999999075, -0.45518000000000003]));
    let r341, g341 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([1, 1], [1.01]), [-1.48], [5], 1, "mirror", 0.4);
    assert(g341.kind == scientific::F_NONE && r341.shape == [5] && common_3::tr_same(r341, [-0.20208000000000004, -0.7278600000000001, -0.67452, -0.18429999999999996, -0.016239999999999997]));
    let r342, g342 = scientific::affine_transform(common_3::tr_arr(1), common_3::ni_nd([2, 2], [1.01, -1.48, 0.0, 1.0]), [], [], 1, "mirror", 0.4);
