    assert(g6.kind == scientific::F_NONE && r6.shape == [7] && common_3::tr_same(r6, [-2.3483639585221767, 0.49085522614321886, -0.4262252484918576, 0.3720192307692307, -0.3555055207389115, -1.5991244569124499, 1.9143254969837156]));
    let r7, g7 = scientific::spline_filter(common_3::tr_arr(1), 5, "mirror");
    assert(g7.kind == scientific::F_NONE && r7.shape == [7] && common_3::tr_same(r7, [-2.3483639585221767, 0.49085522614321886, -0.4262252484918576, 0.3720192307692307, -0.3555055207389115, -1.5991244569124499, 1.9143254969837156]));
    let r8, g8 = scientific::spline_filter1d(common_3::tr_arr(1), 2, 0, "reflect");
    assert(g8.kind == scientific::F_NONE && r8.shape == [7] && common_3::tr_same(r8, [-1.2101202000445646, -0.21715859968804932, -0.07892820182713971, 0.13072781065088757, -0.4974386620781857, -0.7380958381817732, 0.5100136911688247]));
