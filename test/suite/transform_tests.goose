fn test_transform_pins1() {
    let r30, g30 = scientific::spline_filter1d(common_3::tr_arr(1), 5, 0, "grid-wrap");
    assert(g30.kind == scientific::F_NONE && r30.shape == [7] && common_3::tr_same(r30, [-3.3750381481234975, 0.9259204993867014, -0.5905917808479685, 0.38917411975011645, -0.2383644134678471, -1.938551350683186, 2.72645107398568]));
    let r31, g31 = scientific::spline_filter(common_3::tr_arr(1), 5, "grid-wrap");
    assert(g31.kind == scientific::F_NONE && r31.shape == [7] && common_3::tr_same(r31, [-3.3750381481234975, 0.9259204993867014, -0.5905917808479685, 0.38917411975011645, -0.2383644134678471, -1.938551350683186, 2.72645107398568]));
    let r32, g32 = scientific::spline_filter1d(common_3::tr_arr(1), 2, 0, "nearest");
    assert(g32.kind == scientific::F_NONE && r32.shape == [7] && common_3::tr_same(r32, [-1.2101202000445646, -0.21715859968804932, -0.07892820182713971, 0.13072781065088757, -0.4974386620781857, -0.7380958381817732, 0.5100136911688247]));
