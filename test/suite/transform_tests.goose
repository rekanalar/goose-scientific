// The tests of the group transform. Run them with SCIENTIFIC_SUITES=transform.
namespace transform_tests;

import scientific from "../..";
import os;
import common_3;

fn test_transform_pins0() {
    let r0, g0 = scientific::spline_filter1d(common_3::tr_arr(1), 2, 0, "mirror");
    assert(g0.kind == scientific::F_NONE && r0.shape == [7] && common_3::tr_same(r0, [-1.3856414141414146, -0.18707575757575756, -0.08390404040404043, 0.1305, -0.49109595959595964, -0.7759242424242425, 0.730641414141414]));
    let r1, g1 = scientific::spline_filter(common_3::tr_arr(1), 2, "mirror");
    assert(g1.kind == scientific::F_NONE && r1.shape == [7] && common_3::tr_same(r1, [-1.3856414141414146, -0.18707575757575756, -0.08390404040404043, 0.1305, -0.49109595959595964, -0.7759242424242425, 0.730641414141414]));
    let r2, g2 = scientific::spline_filter1d(common_3::tr_arr(1), 3, 0, "mirror");
    assert(g2.kind == scientific::F_NONE && r2.shape == [7] && common_3::tr_same(r2, [-1.6041871794871798, -0.04962564102564106, -0.14131025641025644, 0.19486666666666672, -0.4821564102564104, -0.9602410256410258, 1.011120512820513]));
