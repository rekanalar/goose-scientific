    assert(g3.kind == scientific::F_NONE && r3.shape == [7] && common_3::tr_same(r3, [-1.6041871794871798, -0.04962564102564106, -0.14131025641025644, 0.19486666666666672, -0.4821564102564104, -0.9602410256410258, 1.011120512820513]));
    let r4, g4 = scientific::spline_filter1d(common_3::tr_arr(1), 4, 0, "mirror");
    assert(g4.kind == scientific::F_NONE && r4.shape == [7] && common_3::tr_same(r4, [-1.9297864152732092, 0.17988292933788166, -0.2576648732600007, 0.277341251473267, -0.4363304765739221, -1.2407241808111484, 1.4147771149410542]));
    let r5, g5 = scientific::spline_filter(common_3::tr_arr(1), 4, "mirror");
    assert(g5.kind == scientific::F_NONE && r5.shape == [7] && common_3::tr_same(r5, [-1.9297864152732092, 0.17988292933788166, -0.2576648732600007, 0.277341251473267, -0.4363304765739221, -1.2407241808111484, 1.4147771149410542]));
