fn test_transform_pins9() {
    let r270, g270 = scientific::map_coordinates(common_3::tr_arr(2), common_3::ni_nd([2, 6], [3.0, 0.0, 1.8646220530363742, -2.057084798027239, 0.3001816371483521, -2.8489580168619835, 4.0, 0.0, -2.840893122596812, -1.18684657177523, 6.445648077879598, -2.440471978687352]), 4, "nearest", 0.7);
