    assert(g36.kind == scientific::F_NONE && r36.shape == [3] && ms_same(r36, [-3.0, -3.0, 3.0]));
    let r37, g37 = scientific::minimum_position(ni_nd([9], [5.0, -3.0, 3.0, 0.0, 2.0, -4.0, -3.0, 0.0, 3.0]), ni_nd([9], [1.0, -1.0, 4.0, 3.0, 0.0, 1.0, 2.0, 1.0, 3.0]), [2, 2, 4]);
    assert(g37.kind == scientific::F_NONE && r37.shape == [3, 1] && ms_same(r37, [6.0, 6.0, 2.0]));
    let r38, g38 = scientific::maximum_position(ni_nd([9], [5.0, -3.0, 3.0, 0.0, 2.0, -4.0, -3.0, 0.0, 3.0]), ni_nd([9], [1.0, -1.0, 4.0, 3.0, 0.0, 1.0, 2.0, 1.0, 3.0]), [2, 2, 4]);
