    let v399, c399, w399, g399 = scientific::value_indices(ni_nd([2, 3, 2], [1.0, 3.0, 0.0, 1.0, 3.0, 2.0, -1.0, 2.0, 0.0, 0.0, 1.0, 0.0]), 3.0, true);
    assert(g399.kind == scientific::F_NONE);
