    assert(scientific::dok_setdiag(d, 0, [4.0, 2.0, 0.0]).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 0.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::dok_setdiag(d, 1, [1.0, 2.0]).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 1.0, 1.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 1.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 1.0, 0.0, 5.0).kind == scientific::F_NONE);
