    let r33, g33 = scientific::grey_erosion_st(ni_nd([5], [-4.0, -1.7, 0.5, -1.7, -1.3]), ni_nd([1], [1.0]), ni_nd([1], [-1.2]), "mirror", 0.2, [0]);
