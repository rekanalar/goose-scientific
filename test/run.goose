    assert(g16.kind == scientific::F_NONE && p16 == 0.0);
    assert(scientific::dok_set(d, 4.0, 4.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 3.0, 4.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 2.0, 3.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 3.0, 1.0, 5.0).kind == scientific::F_NONE);
