    assert(scientific::dok_setdiag(d, 1, [2.0, 2.0]).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 1.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::dok_setdiag(d, 0, [2.0, 4.0]).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 2.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::dok_setdiag(d, -3, [2.0, 0.0]).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 3.0, 1.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 1.0, 0.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::dok_resize(d, 3, 5).kind == scientific::F_NONE);
    assert(scientific::dok_resize(d, 6, 5).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 4.0, 4.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::dok_setdiag(d, -4, [4.0]).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 1.0, 2.0, 0.0).kind == scientific::F_NONE);
    assert(dok_is(d, [1.0, 0.0, 1.0, 4.0], [0.0, 0.0, 1.0, 0.0], [2.0, 2.0, 4.0, 4.0]));
    assert(scientific::dok_nnz(d) == 4);
