// The removal of rows from the reduced form.
let qd1, rd1, fqd1 = scientific::qr_delete(q, r, 1, 1, "row");
vchk(qd1, fqd1, [-0.14002800840280108, 0.60415854001919933, 0.78446454055273573, -0.98019605881960703, 0.027461751819054459, -0.19611613513818396, -0.140028008402801, -0.79639080275257945, 0.5883484054145528]);
