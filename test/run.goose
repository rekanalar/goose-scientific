fn dok_pin_p10_3() {
    var d, f0 = scientific::dok_new(3, 4);
    assert(f0.kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 1.0, 1.0, 5.0).kind == scientific::F_NONE);
