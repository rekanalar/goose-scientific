    assert(fm.kind == scientific::F_NONE && all_near(mv, [0.0]));
    let sm, fz = scientific::lil_sum(d);
    assert(fz.kind == scientific::F_NONE && near(sm, 0.0));
    let dg, fg = scientific::lil_diagonal(d);
    assert(fg.kind == scientific::F_NONE && all_near(dg, [0.0]));
    let sd, fk = scientific::lil_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && lil_is(sd, [], [], []));
}

