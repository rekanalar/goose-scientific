    let v421, c421, w421, g421 = scientific::value_indices(ni_nd([2, 1, 2], [-1.0, -1.0, -2.0, -2.0]), -1.0, true);
    assert(g421.kind == scientific::F_NONE);
    assert(v421.shape == [1] && ms_same(v421, [-2.0]));
