    let v419, c419, w419, g419 = scientific::value_indices(ni_nd([2, 1, 2], [0.0, 0.0, -2.0, 3.0]), 1.0, true);
    assert(g419.kind == scientific::F_NONE);
    assert(v419.shape == [3] && ms_same(v419, [-2.0, 0.0, 3.0]));
    assert(c419.shape == [3] && ms_same(c419, [1.0, 2.0, 1.0]));
