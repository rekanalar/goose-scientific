    let r2, g2 = scientific::vectorized_filter(ni_nd([4], [0.431, 3.557, 3.795, 3.808]), [5], "mirror", 0.0, [0]) { x, o => { var h = x.ndim / 2; var d = 0; var n = 1; while d < h { n *= x.shape[d]; d += 1; } var w = 1; d = h; while d < x.ndim { w *= x.shape[d]; d += 1; } var p = 0; while p < n { var s = 0.0; var j = 0; while j < w { s += x.data[p * w + j]; j += 1; } o[p] = s; p += 1; } } };
