fn test_measure_pins3() {
    let r90, g90 = scientific::minimum_position(ni_nd([9], [-0.182, -0.044, 0.321, 0.21, 0.146, 0.09, -0.158, -0.326, -0.391]), ni_nd([9], [1.0, -1.0, 4.0, 3.0, 0.0, 1.0, 2.0, 1.0, 3.0]), []);
    assert(g90.kind == scientific::F_NONE && r90.shape == [1, 1] && ms_same(r90, [8.0]));
