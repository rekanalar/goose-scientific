    let r240, g240 = scientific::distance_transform_bf(ni_nd([4, 2], [0.0, 1.0, 1.0, 1.0, 1.0, 0.0, 0.0, 0.0]), "chessboard", [2.1, 0.6]);
    assert(g240.kind == scientific::F_NONE);
    assert(r240.shape == [4, 2] && ms_same(r240, [0.0, 1.0, 1.0, 1.0, 1.0, 0.0, 0.0, 0.0]));
    let r241, i241, g241 = scientific::distance_transform_bf_indices(ni_nd([4, 2], [0.0, 1.0, 1.0, 1.0, 1.0, 0.0, 0.0, 0.0]), "chessboard", [2.1, 0.6]);
