vchk(ri5, fqi5, [-8.1853527718724504, 0.061084722178152515, -9.5292166597918087, -12.094774991274218, 0.0, -3.7744229567864305, 0.905545161973905, -0.72562243328476694, 0.0, 0.0, 1.172185058073991, 1.1972107398323373, 0.0, 0.0, 0.0, -0.86981402563523047]);
let v2, fv2 = scientific::from_rows(4, 2, [1.0, 0.0, -2.0, 1.0, 0.5, 0.0, 3.0, 1.0]);
let qi6, ri6, fqi6 = scientific::qr_insert(q, r, v2, 0, "col");
vchk(qi6, fqi6, [0.26490647141300883, 0.050515682028271988, 0.16601127668694693, -0.94853201489749284, -0.52981294282601754, -0.82087983295942291, 0.13008346307559271, -0.1689166601872247, 0.13245323570650441, 0.025257841014136181, 0.96881207738203401, 0.20789742792273797, 0.79471941423902637, -0.56830142281806184, -0.13008346307559279, 0.16891666018722468]);
vchk(ri6, fqi6, [3.7749172176353749, 0.26490647141300883, -0.13245323570650416, -1.0596258856520346, 0.5298129428260181, 0.0, -1.3891812557774845, -3.6245001855285284, -3.801305072627482, -5.6577563871664847, 0.0, 0.0, 7.3379462075879616, 8.7329364878081286, 10.706488456183552, 0.0, 0.0, 0.0, -1.0784679073492056, -1.4422884062139965]);
// The insertion of columns into the full form.
let v3, fv3 = scientific::from_rows(4, 1, [1.0, -2.0, 0.5, 3.0]);
let qi7, ri7, fqi7 = scientific::qr_insert(qb, rb, v3, 2, "col");
vchk(qi7, fqi7, [-0.094915799575249871, -0.5609165308915004, -0.77514572535157544, -0.27479581662175112, -0.47457899787624952, -0.26328735123478553, 0.49037326568163836, -0.68190073013545793, -0.85424219617724917, 0.034341828421928788, -0.10065233488334008, 0.50888114189213274, -0.18983159915049982, 0.78413841563403452, -0.38542479455327844, -0.44781540486507704]);
