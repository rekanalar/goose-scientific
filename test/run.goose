    assert(g367.kind == scientific::F_NONE && r367.shape == [2] && ms_same(r367, [0.7000000000000001, 0.0]));
    let r368, g368 = scientific::grey_erosion(ni_nd([2, 1], [-1.9, 3.3]), [2, 3], "constant", 0.1, [0, 1]);
