    let t, ft = scientific::dok_transpose(d);
    assert(ft.kind == scientific::F_NONE && dok_is(t, [0.0, 0.0, 1.0, 0.0], [1.0, 0.0, 1.0, 4.0], [2.0, 2.0, 4.0, 4.0]));
    let co, fc = scientific::dok_to_coo(d);
    assert(fc.kind == scientific::F_NONE && co.nnz == 4);
    let cs, fs = scientific::dok_to_csr(d);
    assert(fs.kind == scientific::F_NONE && cs.nnz == 4);
    let mv, fm = scientific::dok_matvec(d, [-2.0, 1.0, 4.0, 0.0, 3.0]);
    assert(fm.kind == scientific::F_NONE && all_near(mv, [-4.0, 0.0, 0.0, 0.0, -8.0, 0.0]));
    let sm, fz = scientific::dok_sum(d);
    assert(fz.kind == scientific::F_NONE && near(sm, 12.0));
    let dg, fg = scientific::dok_diagonal(d);
    assert(fg.kind == scientific::F_NONE && all_near(dg, [2.0, 4.0, 0.0, 0.0, 0.0]));
    let sd, fk = scientific::dok_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && dok_is(sd, [1.0, 0.0, 1.0, 4.0], [0.0, 0.0, 1.0, 0.0], [-3.0, -3.0, -6.0, -6.0]));
