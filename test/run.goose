    let qe13 = ni_nd([5], [qr13.normr, qr13.normar, qr13.norma, qr13.conda, qr13.normx]);
    assert(all_near(qe13, [0.00000000000000016815769637902774, 0.000000000000000658227895282267, 4.773238942269704, 1.9431434708473636, 0.16543608734027349]));
    let qa14, qf14 = scientific::csr_from_dense(ni_nd([3, 7], [-2.951, 1.114, -0.256, -0.232, 2.555, -2.388, 0.0, 2.389, 1.32, 0.0, 1.672, 2.203, 0.0, 0.0, 0.0, 1.418, -0.295, 0.0, -1.368, -0.174, -1.481]));
    assert(qf14.kind == scientific::F_NONE);
    let qr14, qg14 = scientific::lsmr(qa14, [-1.215, -1.323, -0.216], 0.5, 1.0e-6, 1.0e-6, 1.0e8, 0);
    assert(qg14.kind == scientific::F_NONE && qr14.istop == 2 && qr14.itn == 3);
    assert(all_near(qr14.x, [-0.045409940054804226, -0.27697260469923196, 0.03374126573456056, -0.14039578248110487, -0.26832625744936744, 0.15243158198903622, 0.09325126968173555]));
    let qe14 = ni_nd([5], [qr14.normr, qr14.normar, qr14.norma, qr14.conda, qr14.normx]);
    assert(all_near(qe14, [0.22778764418351335, 0.0000000000000004007655310283012, 6.602321561390356, 1.7267446015200134, 0.45117125582557915]));
}

