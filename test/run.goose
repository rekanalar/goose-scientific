    assert(g626.kind == scientific::F_NONE && r626.shape == [2] && ms_same(r626, [1.0, 1.0]));
    let r627, g627 = scientific::binary_hit_or_miss_st(ni_nd([2], [1.0, 1.0]), ni_nd([1], [1.0]), scientific::empty_arr(), [0]);
    assert(g627.kind == scientific::F_NONE && r627.shape == [2] && ms_same(r627, [1.0, 1.0]));
    let r628, g628 = scientific::binary_hit_or_miss(ni_nd([2], [1.0, 1.0]), 1);
    assert(g628.kind == scientific::F_NONE && r628.shape == [2] && ms_same(r628, [0.0, 0.0]));
    let r629, g629 = scientific::binary_hit_or_miss_st(ni_nd([2], [1.0, 0.0]), ni_nd([1], [1.0]), ni_nd([1], [1.0]), [0], [0]);
    assert(g629.kind == scientific::F_NONE && r629.shape == [2] && ms_same(r629, [0.0, 0.0]));
}

