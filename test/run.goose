    let cs, fs = scientific::lil_to_csr(d);
    assert(fs.kind == scientific::F_NONE && cs.nnz == 2);
    let mv, fm = scientific::lil_matvec(d, [-2.0, 1.0, 4.0, 0.0, 3.0]);
    assert(fm.kind == scientific::F_NONE && all_near(mv, [-14.0, 0.0, -10.0]));
