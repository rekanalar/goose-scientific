    assert(fg.kind == scientific::F_NONE && all_near(dg, [0.0, 0.0, 0.0]));
    let sd, fk = scientific::dok_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && dok_is(sd, [0.0, 2.0, 2.0, 0.0, 1.0], [3.0, 4.0, 3.0, 4.0, 5.0], [-7.5, 4.5, -7.5, -3.0, -3.0]));
