    let co, fc = scientific::dok_to_coo(d);
    assert(fc.kind == scientific::F_NONE && co.nnz == 3);
    let cs, fs = scientific::dok_to_csr(d);
    assert(fs.kind == scientific::F_NONE && cs.nnz == 3);
    let mv, fm = scientific::dok_matvec(d, [-2.0, 1.0]);
    assert(fm.kind == scientific::F_NONE && all_near(mv, [7.0, 6.0, -3.0]));
    let sm, fz = scientific::dok_sum(d);
    assert(fz.kind == scientific::F_NONE && near(sm, 1.0));
    let dg, fg = scientific::dok_diagonal(d);
    assert(fg.kind == scientific::F_NONE && all_near(dg, [0.0, 0.0]));
    let sd, fk = scientific::dok_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && dok_is(sd, [2.0, 0.0, 1.0], [1.0, 1.0, 0.0], [4.5, -10.5, 4.5]));
