    let qa0, qf0 = scientific::csr_from_dense(ni_nd([5, 5], [2.5164, 0.0, 0.42, 0.0, -1.398, -1.453, 1.2404, 0.0, 0.0, -0.875, 1.149, 1.456, 1.2404, 0.0, 2.344, 0.227, 2.043, 0.0, 1.2404, -2.387, -0.096, 0.0, 0.355, 0.0, -1.2376000000000003]));
