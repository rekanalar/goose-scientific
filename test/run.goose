    assert(fm.kind == scientific::F_NONE && all_near(mv, [2.0, 2.0, -10.0, 13.0, 7.0, 2.0]));
    let sm, fz = scientific::dok_sum(d);
    assert(fz.kind == scientific::F_NONE && near(sm, 25.0));
    let dg, fg = scientific::dok_diagonal(d);
    assert(fg.kind == scientific::F_NONE && all_near(dg, [1.0, 2.0]));
    let sd, fk = scientific::dok_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && dok_is(sd, [3.0, 1.0, 0.0, 4.0, 2.0, 3.0, 5.0, 0.0], [0.0, 1.0, 1.0, 1.0, 0.0, 1.0, 1.0, 0.0], [4.5, -3.0, -6.0, -10.5, -7.5, -10.5, -3.0, -1.5]));
}

