    let v426, c426, w426, g426 = scientific::value_indices(ni_nd([4], [0.0, 2.0, 3.0, -1.0]));
    assert(g426.kind == scientific::F_NONE);
    assert(v426.shape == [4] && ms_same(v426, [-1.0, 0.0, 2.0, 3.0]));
    assert(c426.shape == [4] && ms_same(c426, [1.0, 1.0, 1.0, 1.0]));
