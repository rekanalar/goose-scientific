    assert(r114.shape == [1] && ms_same(r114, [0.0]));
    assert(i114.shape == [1, 1] && ms_same(i114, [0.0]));
    let r115, g115 = scientific::distance_transform_cdt_st(ni_nd([1], [0.0]), ni_nd([3], [1.0, 1.0, 1.0]));
    assert(g115.kind == scientific::F_NONE);
    assert(r115.shape == [1] && ms_same(r115, [0.0]));
