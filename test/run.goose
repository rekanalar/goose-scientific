    assert(w213.shape == [3, 5] && ms_same(w213, [3.706, 0.106, 0.0, 0.0, 0.028, -2.979, -2.998, -3.651, -1.534, 0.548, 0.0, 0.0, 2.338, 0.0, -0.39]));
