// test_sparse_lsmr_hostile checks the faults of lsmr.
fn test_sparse_lsmr_hostile() {
    let a, fa = scientific::csr_from_dense(ni_nd([3, 2], [1.0, 0.0, 0.0, 2.0, 1.0, 1.0]));
    assert(fa.kind == scientific::F_NONE);
    let r1, g1 = scientific::lsmr(a, [1.0, 2.0]);
    assert(g1.kind == scientific::F_SHAPE);
    let r2, g2 = scientific::lsmr(a, [1.0, 2.0, 3.0], -1.0);
    assert(g2.kind == scientific::F_VALUE);
    let r3, g3 = scientific::lsmr(a, [1.0, 2.0, 3.0], 0.0, 0.0 / 0.0);
    assert(g3.kind == scientific::F_VALUE);
    let r4, g4 = scientific::lsmr(a, [1.0, 1.0 / 0.0, 3.0]);
    assert(g4.kind == scientific::F_VALUE);
    let r5, g5 = scientific::lsmr(a, [1.0, 2.0, 3.0], 0.0, 1.0e-6, 1.0e-6, 0.0 / 0.0);
    assert(g5.kind == scientific::F_VALUE);
    // A right side of zeros gives the zero solution and the reason zero.
    let r6, g6 = scientific::lsmr(a, [0.0, 0.0, 0.0]);
    assert(g6.kind == scientific::F_NONE && r6.istop == 0 && r6.itn == 0 && ms_same(r6.x, [0.0, 0.0]));
    // A right side so small that its norm falls to zero is a fault.
    let r7, g7 = scientific::lsmr(a, [1.0e-170, 1.0e-170, 1.0e-170]);
    assert(g7.kind == scientific::F_VALUE);
    // A right side so large that its norm overflows is a fault.
    let r8, g8 = scientific::lsmr(a, [1.0e200, 2.0, 3.0]);
    assert(g8.kind == scientific::F_VALUE);
}


// dia_same compares every place of a matrix of diagonals with the values
// of SciPy.
fn dia_same(s: scientific::Dia&, rows: i64, cols: i64, want: f64[:]) -> bool {
    var i: i64 = 0;
    while i < rows {
        var j: i64 = 0;
        while j < cols {
            let x, f = scientific::dia_get(s, i, j);
            if f.kind != scientific::F_NONE { return false; }
            if x != want[i * cols + j] { return false; }
            j += 1;
        }
        i += 1;
    }
    return true;
}
fn test_sparse_dia_pins0() {
    let qc, qg = scientific::dia_from_dense(ni_nd([3, 3], [1.0, 2.0, 0.0, 0.0, 3.0, 4.0, 5.0, 0.0, 6.0]));
    assert(qg.kind == scientific::F_NONE && qc.nnz == 6);
    assert(qc.ndiag == 3 && scientific::dia_nnz(qc) == 6);
    let qo, qv, qu = scientific::dia_diagonals(qc);
    assert(qu.kind == scientific::F_NONE);
    assert(qo.shape == [3] && ms_same(qo, [-2.0, 0.0, 1.0]));
    assert(qv.shape == [6] && ms_same(qv, [5.0, 1.0, 3.0, 6.0, 2.0, 4.0]));
    let qd, qh = scientific::dia_to_dense(qc);
    assert(qh.kind == scientific::F_NONE && ms_same(qd, [1.0, 2.0, 0.0, 0.0, 3.0, 4.0, 5.0, 0.0, 6.0]));
    assert(dia_same(qc, 3, 3, [1.0, 2.0, 0.0, 0.0, 3.0, 4.0, 5.0, 0.0, 6.0]));
    let qm, qn = scientific::dia_matvec(qc, [1.986, -1.783, 1.851]);
    assert(qn.kind == scientific::F_NONE && ms_same(qm, [-1.5799999999999998, 2.0549999999999997, 21.036]));
    let qt, qtg = scientific::dia_transpose(qc);
    assert(qtg.kind == scientific::F_NONE && qt.nnz == 6);
    let qy, qz = scientific::dia_to_dense(qt);
    assert(qz.kind == scientific::F_NONE && ms_same(qy, [1.0, 0.0, 5.0, 2.0, 3.0, 0.0, 0.0, 4.0, 6.0]));
    let qsc, qsg = scientific::dia_scale(qc, 2.5);
    assert(qsg.kind == scientific::F_NONE && qsc.nnz == 6);
    let qsd, qse = scientific::dia_to_dense(qsc);
    assert(qse.kind == scientific::F_NONE && ms_same(qsd, [2.5, 5.0, 0.0, 0.0, 7.5, 10.0, 12.5, 0.0, 15.0]));
    assert(near(scientific::dia_sum(qc), 21.0));
    let qk, ql = scientific::dia_to_csr(qc);
    assert(ql.kind == scientific::F_NONE && qk.nnz == 6);
    let qj, qi = scientific::dia_to_coo(qc);
    assert(qi.kind == scientific::F_NONE && qj.nnz == 6);
    let qf, qe = scientific::dia_from_csr(qk);
    assert(qe.kind == scientific::F_NONE && qf.nnz == 6);
    let qb, qa = scientific::dia_to_dense(qf);
    assert(qa.kind == scientific::F_NONE && ms_same(qb, [1.0, 2.0, 0.0, 0.0, 3.0, 4.0, 5.0, 0.0, 6.0]));
    let qp, qq = scientific::dia_from_coo(qj);
    assert(qq.kind == scientific::F_NONE && qp.nnz == 6);
    let qr, qo2 = scientific::dia_to_dense(qp);
    assert(qo2.kind == scientific::F_NONE && ms_same(qr, [1.0, 2.0, 0.0, 0.0, 3.0, 4.0, 5.0, 0.0, 6.0]));
    let qu2, qw2 = scientific::dia_from_diagonals(3, 3, [-2.0, 0.0, 1.0], [5.0, 1.0, 3.0, 6.0, 2.0, 4.0]);
    assert(qw2.kind == scientific::F_NONE && qu2.nnz == 6);
    let qx2, qy2 = scientific::dia_to_dense(qu2);
    assert(qy2.kind == scientific::F_NONE && ms_same(qx2, [1.0, 2.0, 0.0, 0.0, 3.0, 4.0, 5.0, 0.0, 6.0]));
}

fn test_sparse_dia_pins1() {
    let qc, qg = scientific::dia_from_dense(ni_nd([3, 2], [1.0, 2.0, 0.0, 3.0, 4.0, 0.0]));
    assert(qg.kind == scientific::F_NONE && qc.nnz == 4);
    assert(qc.ndiag == 3 && scientific::dia_nnz(qc) == 4);
    let qo, qv, qu = scientific::dia_diagonals(qc);
    assert(qu.kind == scientific::F_NONE);
    assert(qo.shape == [3] && ms_same(qo, [-2.0, 0.0, 1.0]));
    assert(qv.shape == [4] && ms_same(qv, [4.0, 1.0, 3.0, 2.0]));
    let qd, qh = scientific::dia_to_dense(qc);
    assert(qh.kind == scientific::F_NONE && ms_same(qd, [1.0, 2.0, 0.0, 3.0, 4.0, 0.0]));
    assert(dia_same(qc, 3, 2, [1.0, 2.0, 0.0, 3.0, 4.0, 0.0]));
    let qm, qn = scientific::dia_matvec(qc, [0.068, -1.561]);
    assert(qn.kind == scientific::F_NONE && ms_same(qm, [-3.054, -4.683, 0.272]));
    let qt, qtg = scientific::dia_transpose(qc);
    assert(qtg.kind == scientific::F_NONE && qt.nnz == 4);
    let qy, qz = scientific::dia_to_dense(qt);
    assert(qz.kind == scientific::F_NONE && ms_same(qy, [1.0, 0.0, 4.0, 2.0, 3.0, 0.0]));
    let qsc, qsg = scientific::dia_scale(qc, 2.5);
    assert(qsg.kind == scientific::F_NONE && qsc.nnz == 4);
    let qsd, qse = scientific::dia_to_dense(qsc);
    assert(qse.kind == scientific::F_NONE && ms_same(qsd, [2.5, 5.0, 0.0, 7.5, 10.0, 0.0]));
    assert(near(scientific::dia_sum(qc), 10.0));
    let qk, ql = scientific::dia_to_csr(qc);
    assert(ql.kind == scientific::F_NONE && qk.nnz == 4);
    let qj, qi = scientific::dia_to_coo(qc);
    assert(qi.kind == scientific::F_NONE && qj.nnz == 4);
    let qf, qe = scientific::dia_from_csr(qk);
    assert(qe.kind == scientific::F_NONE && qf.nnz == 4);
    let qb, qa = scientific::dia_to_dense(qf);
    assert(qa.kind == scientific::F_NONE && ms_same(qb, [1.0, 2.0, 0.0, 3.0, 4.0, 0.0]));
    let qp, qq = scientific::dia_from_coo(qj);
    assert(qq.kind == scientific::F_NONE && qp.nnz == 4);
    let qr, qo2 = scientific::dia_to_dense(qp);
    assert(qo2.kind == scientific::F_NONE && ms_same(qr, [1.0, 2.0, 0.0, 3.0, 4.0, 0.0]));
    let qu2, qw2 = scientific::dia_from_diagonals(3, 2, [-2.0, 0.0, 1.0], [4.0, 1.0, 3.0, 2.0]);
    assert(qw2.kind == scientific::F_NONE && qu2.nnz == 4);
    let qx2, qy2 = scientific::dia_to_dense(qu2);
    assert(qy2.kind == scientific::F_NONE && ms_same(qx2, [1.0, 2.0, 0.0, 3.0, 4.0, 0.0]));
}

fn test_sparse_dia_pins2() {
    let qc, qg = scientific::dia_from_dense(ni_nd([2, 3], [1.0, 0.0, 2.0, 0.0, 3.0, 0.0]));
    assert(qg.kind == scientific::F_NONE && qc.nnz == 3);
    assert(qc.ndiag == 2 && scientific::dia_nnz(qc) == 3);
    let qo, qv, qu = scientific::dia_diagonals(qc);
    assert(qu.kind == scientific::F_NONE);
    assert(qo.shape == [2] && ms_same(qo, [0.0, 2.0]));
    assert(qv.shape == [3] && ms_same(qv, [1.0, 3.0, 2.0]));
    let qd, qh = scientific::dia_to_dense(qc);
    assert(qh.kind == scientific::F_NONE && ms_same(qd, [1.0, 0.0, 2.0, 0.0, 3.0, 0.0]));
    assert(dia_same(qc, 2, 3, [1.0, 0.0, 2.0, 0.0, 3.0, 0.0]));
    let qm, qn = scientific::dia_matvec(qc, [1.201, -0.457, 1.55]);
    assert(qn.kind == scientific::F_NONE && ms_same(qm, [4.301, -1.371]));
    let qt, qtg = scientific::dia_transpose(qc);
    assert(qtg.kind == scientific::F_NONE && qt.nnz == 3);
    let qy, qz = scientific::dia_to_dense(qt);
    assert(qz.kind == scientific::F_NONE && ms_same(qy, [1.0, 0.0, 0.0, 3.0, 2.0, 0.0]));
    let qsc, qsg = scientific::dia_scale(qc, 2.5);
    assert(qsg.kind == scientific::F_NONE && qsc.nnz == 3);
    let qsd, qse = scientific::dia_to_dense(qsc);
    assert(qse.kind == scientific::F_NONE && ms_same(qsd, [2.5, 0.0, 5.0, 0.0, 7.5, 0.0]));
    assert(near(scientific::dia_sum(qc), 6.0));
    let qk, ql = scientific::dia_to_csr(qc);
    assert(ql.kind == scientific::F_NONE && qk.nnz == 3);
    let qj, qi = scientific::dia_to_coo(qc);
    assert(qi.kind == scientific::F_NONE && qj.nnz == 3);
    let qf, qe = scientific::dia_from_csr(qk);
    assert(qe.kind == scientific::F_NONE && qf.nnz == 3);
    let qb, qa = scientific::dia_to_dense(qf);
    assert(qa.kind == scientific::F_NONE && ms_same(qb, [1.0, 0.0, 2.0, 0.0, 3.0, 0.0]));
    let qp, qq = scientific::dia_from_coo(qj);
    assert(qq.kind == scientific::F_NONE && qp.nnz == 3);
    let qr, qo2 = scientific::dia_to_dense(qp);
    assert(qo2.kind == scientific::F_NONE && ms_same(qr, [1.0, 0.0, 2.0, 0.0, 3.0, 0.0]));
    let qu2, qw2 = scientific::dia_from_diagonals(2, 3, [0.0, 2.0], [1.0, 3.0, 2.0]);
    assert(qw2.kind == scientific::F_NONE && qu2.nnz == 3);
    let qx2, qy2 = scientific::dia_to_dense(qu2);
    assert(qy2.kind == scientific::F_NONE && ms_same(qx2, [1.0, 0.0, 2.0, 0.0, 3.0, 0.0]));
}

fn test_sparse_dia_pins3() {
    let qc, qg = scientific::dia_from_dense(ni_nd([2, 2], [0.0, 0.0, 0.0, 0.0]));
    assert(qg.kind == scientific::F_NONE && qc.nnz == 0);
