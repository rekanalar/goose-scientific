    let r369, g369 = scientific::grey_erosion_st(ni_nd([2, 1], [-1.9, 3.3]), ni_nd([2, 3], [1.0, 0.0, 1.0, 1.0, 1.0, 0.0]), ni_nd([2, 3], [2.0, -0.5, 0.2, -0.7, 0.4, 1.7]), "constant", 0.1, [0, 1]);
    assert(g369.kind == scientific::F_NONE && r369.shape == [2, 1] && ms_same(r369, [-1.9, -2.1]));
    let r370, g370 = scientific::grey_dilation(ni_nd([2, 1], [-1.9, 3.3]), [2, 3], "constant", 0.1, [0, 1]);
    assert(g370.kind == scientific::F_NONE && r370.shape == [2, 1] && ms_same(r370, [3.3, 3.3]));
    let r371, g371 = scientific::grey_dilation_st(ni_nd([2, 1], [-1.9, 3.3]), ni_nd([2, 3], [1.0, 0.0, 1.0, 1.0, 1.0, 1.0]), ni_nd([2, 3], [-0.6, 0.1, 1.1, -2.4, 1.3, 0.1]), "constant", 0.1, [0, 1]);
    assert(g371.kind == scientific::F_NONE && r371.shape == [2, 1] && ms_same(r371, [4.4, 3.4]));
    let r372, g372 = scientific::grey_opening(ni_nd([2, 1], [-1.9, 3.3]), [2, 3], "constant", 0.1, [0, 1]);
