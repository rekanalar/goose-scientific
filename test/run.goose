    let u213, v213 = scientific::csc_sub(t13, scientific::csc_from_dense(ni_nd([3, 5], [0.0, -0.106, 0.0, 0.0, 0.0, 2.979, 0.917, 0.0, 1.534, -0.548, 0.0, 0.0, -2.338, 0.0, 0.0])));
    assert(v213.kind == scientific::F_NONE);
    let w213, x213 = scientific::csc_to_dense(u213);
