fn test_transform_pins11() {
    let r330, g330 = scientific::shift(tr_arr(1), [-0.51], 0, "mirror", 0.4);
    assert(g330.kind == scientific::F_NONE && r330.shape == [7] && tr_same(r330, [-0.324, -0.07, 0.026, -0.449, -0.552, 0.354, -0.552]));
    let r331, g331 = scientific::shift(tr_arr(1), [0.57], 1, "mirror", 0.4);
    assert(g331.kind == scientific::F_NONE && r331.shape == [7] && tr_same(r331, [-0.65166, -0.75834, -0.21477999999999997, -0.02871999999999999, -0.17825000000000008, -0.49329, -0.16242000000000031]));
    let r332, g332 = scientific::shift(tr_arr(1), [1.86], 3, "mirror", 0.4);
    assert(g332.kind == scientific::F_NONE && r332.shape == [7] && tr_same(r332, [-0.08386997704615386, -0.44035980806153846, -1.0577053827076928, -0.2367832691076924, -0.04935154086153857, -0.007234239446153815, -0.526878709353846]));
    let r333, g333 = scientific::shift(tr_arr(1), [1.62], 4, "mirror", 0.4);
    assert(g333.kind == scientific::F_NONE && r333.shape == [7] && tr_same(r333, [-0.09131695006366906, -0.6832910640908726, -0.9152577371278686, -0.12898523243154222, -0.02184700746312425, -0.07794758341897508, -0.661503096594244]));
    let r334, g334 = scientific::zoom(tr_arr(1), [0.95], 1, "mirror", 0.4, true, false);
    assert(g334.kind == scientific::F_NONE && r334.shape == [7] && tr_same(r334, [-1.086, -0.324, -0.07, 0.026, -0.449, -0.552, 0.354]));
    let r335, g335 = scientific::zoom(tr_arr(1), [0.95], 1, "mirror", 0.4, true, true);
    assert(g335.kind == scientific::F_NONE && r335.shape == [7] && tr_same(r335, [-1.086, -0.324, -0.07, 0.026, -0.449, -0.552, 0.354]));
    let r336, g336 = scientific::zoom(tr_arr(1), [2.13], 3, "mirror", 0.4, true, false);
    assert(g336.kind == scientific::F_NONE && r336.shape == [15] && tr_same(r336, [-1.0860000000000003, -0.8628565149136579, -0.44297896389324976, -0.17414868804664735, -0.0955263511998206, -0.04887055393586016, 0.024895537115945263, 0.02599999999999993, -0.12418474994393354, -0.36505131195335266, -0.5971471181879345, -0.6740962099125364, -0.42344902444494326, 0.07577546535097533, 0.3539999999999999]));
    let r337, g337 = scientific::zoom(tr_arr(1), [2.13], 3, "mirror", 0.4, true, true);
    assert(g337.kind == scientific::F_NONE && r337.shape == [15] && tr_same(r337, [-0.990482716809117, -1.030158030769231, -0.6299168091168091, -0.24028877037037047, -0.10679335384615388, -0.06097061652421652, 0.019613638746438754, 0.02599999999999993, -0.1433254609686611, -0.41011418347578377, -0.6401010461538464, -0.6306680296296295, -0.20649800569800605, 0.28366843076923065, 0.23401670199430202]));
    let r338, g338 = scientific::zoom(tr_arr(1), [1.06], 5, "mirror", 0.4, true, false);
    assert(g338.kind == scientific::F_NONE && r338.shape == [7] && tr_same(r338, [-1.0859999999999999, -0.3240000000000003, -0.07000000000000006, 0.026000000000000655, -0.4490000000000009, -0.5519999999999995, 0.3540000000000002]));
    let r339, g339 = scientific::zoom(tr_arr(1), [1.06], 5, "mirror", 0.4, true, true);
    assert(g339.kind == scientific::F_NONE && r339.shape == [7] && tr_same(r339, [-1.0859999999999999, -0.3240000000000003, -0.07000000000000006, 0.026000000000000655, -0.4490000000000009, -0.5519999999999995, 0.3540000000000002]));
    let r340, g340 = scientific::affine_transform(tr_arr(1), ni_nd([1], [1.57]), [-1.48], [], 1, "mirror", 0.4);
    assert(g340.kind == scientific::F_NONE && r340.shape == [7] && tr_same(r340, [-0.20208000000000004, -1.01742, -0.15635999999999992, -0.08325000000000021, -0.5314000000000001, 0.018779999999999075, -0.45518000000000003]));
    let r341, g341 = scientific::affine_transform(tr_arr(1), ni_nd([1, 1], [1.01]), [-1.48], [5], 1, "mirror", 0.4);
    assert(g341.kind == scientific::F_NONE && r341.shape == [5] && tr_same(r341, [-0.20208000000000004, -0.7278600000000001, -0.67452, -0.18429999999999996, -0.016239999999999997]));
    let r342, g342 = scientific::affine_transform(tr_arr(1), ni_nd([2, 2], [1.01, -1.48, 0.0, 1.0]), [], [], 1, "mirror", 0.4);
    assert(g342.kind == scientific::F_NONE && r342.shape == [7] && tr_same(r342, [-0.20208000000000004, -0.7278600000000001, -0.67452, -0.18429999999999996, -0.016239999999999997, -0.24474999999999994, -0.50874]));
    let r343, g343 = scientific::affine_transform(tr_arr(1), ni_nd([1], [0.89]), [-1.38], [], 3, "mirror", 0.4);
    assert(g343.kind == scientific::F_NONE && r343.shape == [7] && tr_same(r343, [-0.14594395070769237, -0.8059938470538465, -0.8879940923076922, -0.1726765948384615, -0.042465047199999995, 0.011657338530769158, -0.4257516248615387]));
    let r344, g344 = scientific::affine_transform(tr_arr(1), ni_nd([1, 1], [0.78]), [-1.38], [2], 3, "mirror", 0.4);
    assert(g344.kind == scientific::F_NONE && r344.shape == [2] && tr_same(r344, [-0.14594395070769237, -0.6975511384615387]));
    let r345, g345 = scientific::affine_transform(tr_arr(1), ni_nd([2, 2], [0.78, -1.38, 0.0, 1.0]), [], [], 3, "mirror", 0.4);
    assert(g345.kind == scientific::F_NONE && r345.shape == [7] && tr_same(r345, [-0.14594395070769237, -0.6975511384615387, -1.0402544250461538, -0.35452381144615397, -0.09339803279999999, 0.017644083200000056, -0.06526629999999999]));
    let r346, g346 = scientific::shift(tr_arr(1), [1.46], 0, "reflect", 0.4);
    assert(g346.kind == scientific::F_NONE && r346.shape == [7] && tr_same(r346, [-1.086, -1.086, -0.324, -0.07, 0.026, -0.449, -0.552]));
    let r347, g347 = scientific::shift(tr_arr(1), [-0.31], 1, "reflect", 0.4);
    assert(g347.kind == scientific::F_NONE && r347.shape == [7] && tr_same(r347, [-0.84978, -0.24525999999999998, -0.04024, -0.12125000000000004, -0.48092999999999997, -0.27114000000000044, 0.354]));
