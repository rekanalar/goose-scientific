    assert(scientific::dok_nnz(d) == 3);
    let dn, fd = scientific::dok_to_dense(d);
    assert(fd.kind == scientific::F_NONE && all_near(dn, [0.0, 0.0, 0.0, 0.0, 7.0, 5.0, 0.0, 0.0, 0.0, 8.0, 0.0, 0.0]));
    let t, ft = scientific::dok_transpose(d);
