    assert(g351.kind == scientific::F_NONE && r351.shape == [2, 3, 5] && ms_same(r351, [0.0, 0.0, 0.0, 0.19999999999999996, 0.7, 0.0, 4.3999999999999995, 1.7000000000000002, 0.0, 0.0, 3.3, 2.5999999999999996, 5.2, 3.8, -0.5, 3.4, 0.0, 0.0, 0.0, 4.0, -4.1000000000000005, 6.2, 9.2, 0.0, 0.9, 3.8, -0.19999999999999973, 0.40000000000000036, 2.7, 2.1]));
    let r352, g352 = scientific::grey_erosion(ni_nd([2], [-1.6, 0.0]), [3], "wrap", 0.6, [-1]);
