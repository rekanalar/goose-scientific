    let r365, g365 = scientific::white_tophat_st(ni_nd([2], [-1.6, 0.0]), scientific::empty_arr(), ni_nd([3], [0.4, -0.7, 0.4]), "wrap", 0.6, [-1]);
    assert(g365.kind == scientific::F_NONE && r365.shape == [2] && ms_same(r365, [0.0, 0.5000000000000001]));
    let r366, g366 = scientific::black_tophat(ni_nd([2], [-1.6, 0.0]), [3], "wrap", 0.6, [-1]);
