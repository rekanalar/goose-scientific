    let qx0bicg, qc0bicg, qg0bicg = scientific::bicg(qa0, [-0.04, -1.33, 1.538, 1.09, 1.152], 1e-12);
    assert(qg0bicg.kind == scientific::F_NONE && qc0bicg == 0 && all_near(qx0bicg, [-0.5360018523578103, -1.6282536944202755, 3.4552167659319513, 3.854665589254586, 0.10185692447655473]));
