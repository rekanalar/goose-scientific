fn dok_pin_r42() {
    var d, f0 = scientific::dok_new(5, 6);
    assert(f0.kind == scientific::F_NONE);
    assert(scientific::dok_resize(d, 5, 3).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 4.0, 2.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 2.0, 2.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::dok_setdiag(d, -3, [0.0, 4.0, 4.0]).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 1.0, 0.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 3.0, 1.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 1.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 4.0, 1.0, 0.0).kind == scientific::F_NONE);
    let p10, g10 = scientific::dok_pop(d, 1.0, 2.0);
    assert(g10.kind == scientific::F_NONE && p10 == 0.0);
    assert(scientific::dok_set(d, 4.0, 1.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 3.0, 2.0, 0.0).kind == scientific::F_NONE);
    let p14, g14 = scientific::dok_pop(d, 2.0, 0.0);
    assert(g14.kind == scientific::F_NONE && p14 == 0.0);
    assert(scientific::dok_setdiag(d, -1, [1.0, 1.0, 1.0]).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 3.0, 1.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 1.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 1.0, 2.0, 2.0).kind == scientific::F_NONE);
    let p20, g20 = scientific::dok_pop(d, 3.0, 2.0);
    assert(g20.kind == scientific::F_NONE && p20 == 1.0);
    assert(scientific::dok_set(d, 3.0, 1.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 3.0, 0.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 4.0, 1.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 3.0, 2.0, 1.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 2.0, 0.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::dok_resize(d, 6, 4).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 2.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 3.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::dok_setdiag(d, 0, [0.0, 2.0, 1.0, 2.0, 0.0]).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 2.0, 3.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 1.0, 1.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::dok_resize(d, 1, 1).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 0.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 0.0, 5.0).kind == scientific::F_NONE);
    assert(scientific::dok_setdiag(d, 0, [1.0, 1.0]).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 0.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 0.0, 7.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 0.0, -3.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 0.0, 7.0).kind == scientific::F_NONE);
    let p41, g41 = scientific::dok_pop(d, 0.0, 0.0);
    assert(g41.kind == scientific::F_NONE && p41 == 7.0);
    let p43, g43 = scientific::dok_pop(d, 0.0, 0.0);
    assert(g43.kind == scientific::F_NONE && p43 == 0.0);
    assert(dok_is(d, [], [], []));
    assert(scientific::dok_nnz(d) == 0);
    let dn, fd = scientific::dok_to_dense(d);
    assert(fd.kind == scientific::F_NONE && all_near(dn, [0.0]));
    let t, ft = scientific::dok_transpose(d);
    assert(ft.kind == scientific::F_NONE && dok_is(t, [], [], []));
    let co, fc = scientific::dok_to_coo(d);
    assert(fc.kind == scientific::F_NONE && co.nnz == 0);
    let cs, fs = scientific::dok_to_csr(d);
    assert(fs.kind == scientific::F_NONE && cs.nnz == 0);
    let mv, fm = scientific::dok_matvec(d, [-2.0]);
    assert(fm.kind == scientific::F_NONE && all_near(mv, [0.0]));
    let sm, fz = scientific::dok_sum(d);
    assert(fz.kind == scientific::F_NONE && near(sm, 0.0));
    let dg, fg = scientific::dok_diagonal(d);
    assert(fg.kind == scientific::F_NONE && all_near(dg, [0.0]));
    let sd, fk = scientific::dok_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && dok_is(sd, [], [], []));
}

