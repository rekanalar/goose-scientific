fn test_ndimage_pins7() {
    let r245, g245 = scientific::convolve1d(ni_arr(3), [-0.322, 1.481], -1, "wrap", 1.5, -1);
    assert(g245.kind == scientific::F_NONE && nd_same(r245, [-2.243838, -0.322553, 0.539594, -0.130176, 1.899675, -0.7874580000000001, 0.5196310000000001, 0.5194190000000001, -1.138285, -0.6895469999999999, -0.16053000000000003, 0.738399, -3.0397890000000003, 0.676309, -2.405333, 2.0315630000000002, -3.105636, 1.3466620000000002, 0.51441, 0.10311300000000007, -1.240071, 0.4297630000000002, 1.469576, 0.9906710000000001, -0.135126, -0.54334, 2.5459870000000002, -0.973704, 0.9985170000000001, 2.162325, -1.3404930000000002, 0.21627900000000003, -1.3139670000000003, -2.6454400000000002, 2.0725390000000004, 0.43245700000000004, 0.05411899999999997, -1.004243, -0.194213, 0.21466900000000005, 1.796999, -0.735628, -1.885629, 2.211678, -1.3584450000000001, 0.015073999999999997, -0.663226, 2.5977490000000003, -2.468751, -0.38834300000000005, 0.6400790000000001, 1.214874, 0.12301899999999999, -1.349421, 1.058953, -1.241037, 0.5217900000000001, 1.790278, -2.65817, 1.341431]));
    let r246, g246 = scientific::correlate1d(ni_arr(1), [-0.322, 1.481], -1, "wrap", 1.5, 0);
    assert(g246.kind == scientific::F_NONE && nd_same(r246, [-0.496596, -1.302173, 0.22747099999999998, -0.020603000000000003, -0.104506, -1.03, -1.229521, -0.8335670000000002, 0.59971]));
