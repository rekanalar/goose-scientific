    assert(g31.kind == scientific::F_NONE && r31.shape == [4, 5, 1] && ms_same(r31, [1.3, -3.8, 5.0, 2.6999999999999997, 0.5999999999999996, 1.6999999999999997, 0.49999999999999967, 2.4999999999999996, -0.10000000000000009, 0.0, 3.8999999999999995, 6.0, 3.3, 1.0999999999999996, 0.19999999999999962, 0.5, 7.199999999999999, -2.3, 3.3999999999999995, 0.6999999999999996]));
