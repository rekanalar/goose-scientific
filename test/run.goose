fn test_ndimage_pins14() {
    let r490, g490 = scientific::correlate_nd(ni_arr(2), ni_nd([2, 2], [1.691, 0.104, -0.54, 1.069]), "constant", 2.0, [0, 0]);
    assert(g490.kind == scientific::F_NONE && nd_same(r490, [2.19999, 2.9908170000000007, 3.0706130000000003, 4.817038, 3.295261, 4.273136, 2.554056, -2.570814, -0.252722, -0.935575, 1.333624, 0.47539899999999996, 2.279213, -0.7593299999999998, -4.474431000000001, 2.085151, 1.410672, 0.435094, 2.585742, 0.022157999999999956, -1.2789760000000001, -1.7138050000000002, -0.3085309999999998, 2.457497, 1.392567, 1.22927, 0.449048, 3.289663, 2.098667, -3.034167]));
    let r491, g491 = scientific::convolve_nd(ni_arr(2), ni_nd([2, 2], [1.691, 0.104, -0.54, 1.069]), "constant", 2.0, [0, 0]);
    assert(g491.kind == scientific::F_NONE && nd_same(r491, [-2.849878, -0.34158599999999983, -0.5552849999999998, 1.299452, 0.4280729999999999, 3.07438, -0.44147400000000014, -5.276605, 1.0118850000000001, 2.088192, 0.8766259999999999, 2.76526, 1.061074, 1.2276, 0.5053330000000003, -0.8307650000000002, 1.240115, 2.7398480000000003, 0.44021, -0.07737600000000001, 2.804061, 2.779789, -3.547657, 2.423819, 2.518567, 3.877252, 2.593071, 5.373645, 4.621459, 0.8722920000000003]));
    let r492, g492 = scientific::correlate_nd(ni_arr(2), ni_nd([2, 2], [1.691, 0.104, -0.54, 1.069]), "constant", 2.0, [0, 0]);
    assert(g492.kind == scientific::F_NONE && nd_same(r492, [2.19999, 2.9908170000000007, 3.0706130000000003, 4.817038, 3.295261, 4.273136, 2.554056, -2.570814, -0.252722, -0.935575, 1.333624, 0.47539899999999996, 2.279213, -0.7593299999999998, -4.474431000000001, 2.085151, 1.410672, 0.435094, 2.585742, 0.022157999999999956, -1.2789760000000001, -1.7138050000000002, -0.3085309999999998, 2.457497, 1.392567, 1.22927, 0.449048, 3.289663, 2.098667, -3.034167]));
