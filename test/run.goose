    let r479, g479 = scientific::median_labels(ni_nd([3, 2, 4], [-0.573, 1.98, -0.091, 0.161, -0.224, -1.036, 1.074, -0.279, 0.179, -0.096, -1.995, 1.027, -0.403, 0.292, 0.739, -0.296, 0.074, 0.264, 1.452, 0.466, -0.038, 0.083, 0.957, 0.607]), scientific::empty_arr());
