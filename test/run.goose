vchk(ri2, fqi2, [8.2613558209291522, 9.5020722629002012, 12.225596159909813, 0.0, -1.9262976692668021, 0.08747254964093909, 0.0, 0.0, -1.8780700433843915]);
// The insertion of rows into the full form.
let u3, fu3 = scientific::from_rows(1, 4, [1.0, -2.0, 0.5, 3.0]);
let qi3, ri3, fqi3 = scientific::qr_insert(qb, rb, u3, 2, "row");
vchk(qi3, fqi3, [-0.094491118252306786, -0.26173470707954055, -0.45999659543577476, -0.73021118689169229, -0.42161727479686817, -0.47245559126153408, -0.15909364547972049, -0.048916711124389577, -0.31620639366864034, 0.80566469342371771, -0.094491118252306813, 0.88784518283843983, -0.44025040011950745, -0.067237836890924982, 0.06679085541336513, -0.85042006427076133, -0.056452583879900695, -0.043531385129044031, 0.36980810290008514, -0.36734970477350865, -0.18898223650461365, 0.33871550327940464, 0.76830650866931327, -0.47489596698747394, -0.18367485238675485]);
vchk(ri3, fqi3, [-10.583005244258361, -11.527916426781431, -13.842948823962949, -15.685525629882932, 0.0, -3.479531988233886, -2.1323680547362542, -0.051320530799912299, 0.0, 0.0, -2.4649085857863349, -3.3496727691049992, 0.0, 0.0, 0.0, -1.3196000368750358, 0.0, 0.0, 0.0, 0.0]);
