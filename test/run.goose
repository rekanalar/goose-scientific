    assert(g474.kind == scientific::F_NONE && r474.shape == [5] && ms_same(r474, [2.0, 8.0, 10.0, 4.0, 0.0]));
    let r475, g475 = scientific::histogram_labels(ni_nd([3, 2, 4], [-0.573, 1.98, -0.091, 0.161, -0.224, -1.036, 1.074, -0.279, 0.179, -0.096, -1.995, 1.027, -0.403, 0.292, 0.739, -0.296, 0.074, 0.264, 1.452, 0.466, -0.038, 0.083, 0.957, 0.607]), 0.5, 0.5, 3, ni_nd([3, 2, 4], [3.0, 0.0, 3.0, 3.0, -1.0, -1.0, 4.0, 1.0, 0.0, 3.0, 2.0, 4.0, -1.0, 1.0, 4.0, -1.0, 4.0, 1.0, 4.0, 3.0, 3.0, -1.0, 1.0, 4.0]), [1]);
    assert(g475.kind == scientific::F_NONE && r475.shape == [1, 3] && ms_same(r475, [0.0, 0.0, 0.0]));
    let r476, g476 = scientific::sum_labels(ni_nd([3, 2, 4], [-0.573, 1.98, -0.091, 0.161, -0.224, -1.036, 1.074, -0.279, 0.179, -0.096, -1.995, 1.027, -0.403, 0.292, 0.739, -0.296, 0.074, 0.264, 1.452, 0.466, -0.038, 0.083, 0.957, 0.607]), scientific::empty_arr());
    assert(g476.kind == scientific::F_NONE && r476.shape == [1] && ms_same(r476, [4.324]));
    let r477, g477 = scientific::mean_labels(ni_nd([3, 2, 4], [-0.573, 1.98, -0.091, 0.161, -0.224, -1.036, 1.074, -0.279, 0.179, -0.096, -1.995, 1.027, -0.403, 0.292, 0.739, -0.296, 0.074, 0.264, 1.452, 0.466, -0.038, 0.083, 0.957, 0.607]), scientific::empty_arr());
    assert(g477.kind == scientific::F_NONE && r477.shape == [1] && ms_same(r477, [0.18016666666666667]));
    let r478, g478 = scientific::variance_labels(ni_nd([3, 2, 4], [-0.573, 1.98, -0.091, 0.161, -0.224, -1.036, 1.074, -0.279, 0.179, -0.096, -1.995, 1.027, -0.403, 0.292, 0.739, -0.296, 0.074, 0.264, 1.452, 0.466, -0.038, 0.083, 0.957, 0.607]), scientific::empty_arr());
