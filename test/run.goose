fn test_measure_pins11() {
    let r330, g330 = scientific::minimum_labels(ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), ni_nd([3, 2, 4], [3.0, 0.0, 3.0, 3.0, -1.0, -1.0, 4.0, 1.0, 0.0, 3.0, 2.0, 4.0, -1.0, 1.0, 4.0, -1.0, 4.0, 1.0, 4.0, 3.0, 3.0, -1.0, 1.0, 4.0]), []);
    assert(g330.kind == scientific::F_NONE && r330.shape == [1] && ms_same(r330, [-6.0]));
    let r331, g331 = scientific::maximum_labels(ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), ni_nd([3, 2, 4], [3.0, 0.0, 3.0, 3.0, -1.0, -1.0, 4.0, 1.0, 0.0, 3.0, 2.0, 4.0, -1.0, 1.0, 4.0, -1.0, 4.0, 1.0, 4.0, 3.0, 3.0, -1.0, 1.0, 4.0]), []);
    assert(g331.kind == scientific::F_NONE && r331.shape == [1] && ms_same(r331, [7.0]));
    let r332, g332 = scientific::median_labels(ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), ni_nd([3, 2, 4], [3.0, 0.0, 3.0, 3.0, -1.0, -1.0, 4.0, 1.0, 0.0, 3.0, 2.0, 4.0, -1.0, 1.0, 4.0, -1.0, 4.0, 1.0, 4.0, 3.0, 3.0, -1.0, 1.0, 4.0]), []);
    assert(g332.kind == scientific::F_NONE && r332.shape == [1] && ms_same(r332, [0.0]));
    let r333, g333 = scientific::minimum_position(ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), ni_nd([3, 2, 4], [3.0, 0.0, 3.0, 3.0, -1.0, -1.0, 4.0, 1.0, 0.0, 3.0, 2.0, 4.0, -1.0, 1.0, 4.0, -1.0, 4.0, 1.0, 4.0, 3.0, 3.0, -1.0, 1.0, 4.0]), []);
    assert(g333.kind == scientific::F_NONE && r333.shape == [1, 3] && ms_same(r333, [1.0, 1.0, 1.0]));
    let r334, g334 = scientific::maximum_position(ni_nd([3, 2, 4], [0.0, 3.0, -1.0, -1.0, -2.0, -3.0, 0.0, 1.0, -2.0, 2.0, -2.0, 3.0, -4.0, -6.0, -2.0, 4.0, 1.0, 5.0, -1.0, -1.0, -1.0, 2.0, 3.0, 7.0]), ni_nd([3, 2, 4], [3.0, 0.0, 3.0, 3.0, -1.0, -1.0, 4.0, 1.0, 0.0, 3.0, 2.0, 4.0, -1.0, 1.0, 4.0, -1.0, 4.0, 1.0, 4.0, 3.0, 3.0, -1.0, 1.0, 4.0]), []);
    assert(g334.kind == scientific::F_NONE && r334.shape == [1, 3] && ms_same(r334, [2.0, 1.0, 3.0]));
