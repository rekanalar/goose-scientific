    assert(fd.kind == scientific::F_NONE && all_near(dn, [0.0, 0.0]));
    let t, ft = scientific::lil_transpose(d);
    assert(ft.kind == scientific::F_NONE && lil_is(t, [], [], []));
    let co, fc = scientific::lil_to_coo(d);
