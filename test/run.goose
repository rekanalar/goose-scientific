    let qe12 = ni_nd([5], [qr12.normr, qr12.normar, qr12.norma, qr12.conda, qr12.normx]);
    assert(all_near(qe12, [0.00000000000000007319551552264255, 0.0000000000000000595079541199084, 0.813, 1.2300123001230012, 0.6592865928659286]));
    let qa13, qf13 = scientific::csr_from_dense(ni_nd([2, 6], [0.0, 1.421, 0.862, 2.606, 0.614, -2.433, -1.397, 0.0, 1.703, 1.431, -0.185, 0.0]));
    assert(qf13.kind == scientific::F_NONE);
    let qr13, qg13 = scientific::lsmr(qa13, [0.288, 0.435], 0.0, 1.0e-6, 1.0e-6, 1.0e8, 0);
    assert(qg13.kind == scientific::F_NONE && qr13.istop == 1 && qr13.itn == 2);
