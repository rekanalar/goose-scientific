    let dg, fg = scientific::lil_diagonal(d);
    assert(fg.kind == scientific::F_NONE && all_near(dg, [7.0, 0.0, 0.0]));
    let sd, fk = scientific::lil_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && lil_is(sd, [0.0, 2.0], [0.0, 0.0], [-10.5, -7.5]));
}

