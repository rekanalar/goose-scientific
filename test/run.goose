    assert(g26.kind == scientific::F_NONE && r26.shape == [2] && ms_same(r26, [1.5, 0.0]));
    let r27, g27 = scientific::minimum_position(ni_nd([9], [5.0, -3.0, 3.0, 0.0, 2.0, -4.0, -3.0, 0.0, 3.0]), ni_nd([9], [1.0, -1.0, 4.0, 3.0, 0.0, 1.0, 2.0, 1.0, 3.0]), [3, 1]);
    assert(g27.kind == scientific::F_NONE && r27.shape == [2, 1] && ms_same(r27, [3.0, 5.0]));
    let r28, g28 = scientific::maximum_position(ni_nd([9], [5.0, -3.0, 3.0, 0.0, 2.0, -4.0, -3.0, 0.0, 3.0]), ni_nd([9], [1.0, -1.0, 4.0, 3.0, 0.0, 1.0, 2.0, 1.0, 3.0]), [3, 1]);
    assert(g28.kind == scientific::F_NONE && r28.shape == [2, 1] && ms_same(r28, [8.0, 0.0]));
    let r29, g29 = scientific::center_of_mass(ni_nd([9], [5.0, -3.0, 3.0, 0.0, 2.0, -4.0, -3.0, 0.0, 3.0]), ni_nd([9], [1.0, -1.0, 4.0, 3.0, 0.0, 1.0, 2.0, 1.0, 3.0]), [3, 1]);
    assert(g29.kind == scientific::F_NONE && r29.shape == [2, 1] && ms_same(r29, [8.0, -20.0]));
}

fn test_measure_pins1() {
    let r30, g30 = scientific::sum_labels(ni_nd([9], [5.0, -3.0, 3.0, 0.0, 2.0, -4.0, -3.0, 0.0, 3.0]), ni_nd([9], [1.0, -1.0, 4.0, 3.0, 0.0, 1.0, 2.0, 1.0, 3.0]), [2, 2, 4]);
