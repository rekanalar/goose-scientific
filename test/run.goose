// The removal of rows from the full form.
let qd3, rd3, fqd3 = scientific::qr_delete(qb, rb, 2, 1, "row");
vchk(qd3, fqd3, [-0.18257418583505511, -0.55181926797141234, -0.81373347120673445, -0.91287092917527701, -0.21223817998900404, 0.34874291623145781, -0.36514837167011044, 0.80650508395821641, -0.46499055497527797]);
vchk(rd3, fqd3, [-5.4772255750516594, -6.2075223183918826, -6.9378190617321041, -8.3984125484125478, 0.0, -1.5705625319186338, -3.1411250638372672, -3.0986774278394682, 0.0, 0.0, 1.8873791418627709e-15, -0.92998110995055339]);
let qd4, rd4, fqd4 = scientific::qr_delete(qb, rb, 1, 2, "row");
