    assert(fm.kind == scientific::F_NONE && all_near(mv, [-8.0, -9.0, 7.0, 0.0, -3.0]));
    let sm, fz = scientific::lil_sum(d);
    assert(fz.kind == scientific::F_NONE && near(sm, 20.0));
    let dg, fg = scientific::lil_diagonal(d);
    assert(fg.kind == scientific::F_NONE && all_near(dg, [4.0, 5.0, 0.0]));
    let sd, fk = scientific::lil_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && lil_is(sd, [0.0, 1.0, 1.0, 2.0, 4.0], [0.0, 0.0, 1.0, 1.0, 1.0], [-6.0, -10.5, -7.5, -10.5, 4.5]));
