    assert(scientific::dok_resize(d, 4, 6).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 4.0, 0.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 2.0, 2.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 1.0, 2.0, 5.0).kind == scientific::F_NONE);
