    assert(scientific::dok_nnz(d) == 2);
    let dn, fd = scientific::dok_to_dense(d);
    assert(fd.kind == scientific::F_NONE && all_near(dn, [0.0, 7.0, -3.0, 0.0]));
    let t, ft = scientific::dok_transpose(d);
    assert(ft.kind == scientific::F_NONE && dok_is(t, [1.0, 0.0], [0.0, 1.0], [7.0, -3.0]));
    let co, fc = scientific::dok_to_coo(d);
    assert(fc.kind == scientific::F_NONE && co.nnz == 2);
    let cs, fs = scientific::dok_to_csr(d);
    assert(fs.kind == scientific::F_NONE && cs.nnz == 2);
    let mv, fm = scientific::dok_matvec(d, [-2.0, 1.0]);
    assert(fm.kind == scientific::F_NONE && all_near(mv, [7.0, 6.0]));
    let sm, fz = scientific::dok_sum(d);
    assert(fz.kind == scientific::F_NONE && near(sm, 4.0));
    let dg, fg = scientific::dok_diagonal(d);
    assert(fg.kind == scientific::F_NONE && all_near(dg, [0.0, 0.0]));
    let sd, fk = scientific::dok_scale(d, -1.5);
    assert(fk.kind == scientific::F_NONE && dok_is(sd, [0.0, 1.0], [1.0, 0.0], [-10.5, 4.5]));
}

