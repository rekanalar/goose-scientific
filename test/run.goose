    assert(scientific::dok_set(d, 3.0, 5.0, 2.0).kind == scientific::F_NONE);
    assert(scientific::dok_setdiag(d, -3, [4.0]).kind == scientific::F_NONE);
    assert(scientific::dok_set(d, 0.0, 5.0, 2.0).kind == scientific::F_NONE);
