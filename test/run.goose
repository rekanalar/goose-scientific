    assert(scientific::dok_setdiag(d, -4, [4.0]).kind == scientific::F_NONE);
    let p19, g19 = scientific::dok_pop(d, 2.0, 0.0);
    assert(g19.kind == scientific::F_NONE && p19 == 7.0);
    let p21, g21 = scientific::dok_pop(d, 5.0, 0.0);
    assert(g21.kind == scientific::F_NONE && p21 == 0.0);
    let p23, g23 = scientific::dok_pop(d, 5.0, 0.0);
    assert(g23.kind == scientific::F_NONE && p23 == 0.0);
    let p25, g25 = scientific::dok_pop(d, 3.0, 0.0);
